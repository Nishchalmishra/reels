{
  "name": "arivihan-reels",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "verify:browser": "node scripts/browser-check.mjs",
    "demo": "node scripts/run-mode.mjs local dev",
    "live": "node scripts/run-mode.mjs supabase dev",
    "build:live": "node scripts/run-mode.mjs supabase build --outDir dist-live",
    "build:demo": "node scripts/run-mode.mjs local build",
    "db:inspect": "node scripts/migrate-supabase.mjs --inspect-only",
    "db:migrate": "node scripts/migrate-supabase.mjs",
    "supabase:inspect": "node scripts/inspect-supabase.mjs",
    "test:live": "node scripts/verify-supabase.mjs --mcp",
    "mcp:verify": "node scripts/supabase-mcp.mjs",
    "mcp:inspect": "node scripts/supabase-mcp.mjs --inspect --inventory",
    "db:migrate:mcp": "node scripts/supabase-mcp.mjs --apply-migrations",
    "test:live:browser": "node scripts/browser-live-journey.mjs",
    "test:live:onboarding": "node scripts/browser-live-onboarding.mjs",
    "test:live:restore": "node scripts/verify-live-restoration.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.468.0",
