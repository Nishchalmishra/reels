<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <application android:label="Arivihan Reels Demo" android:allowBackup="false" android:networkSecurityConfig="@xml/demo_network_security" tools:replace="android:label,android:allowBackup,android:networkSecurityConfig">
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" tools:replace="android:value" />
        <meta-data android:name="firebase_crashlytics_collection_enabled" android:value="false" tools:replace="android:value" />
        <meta-data android:name="firebase_performance_collection_enabled" android:value="false" tools:replace="android:value" />
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" tools:replace="android:value" />
        <meta-data android:name="com.facebook.sdk.AutoInitEnabled" android:value="false" tools:replace="android:value" />
        <meta-data android:name="com.facebook.sdk.AutoLogAppEventsEnabled" android:value="false" tools:replace="android:value" />
        <provider android:name="com.google.firebase.provider.FirebaseInitProvider" tools:node="remove" />
        <provider android:name="com.facebook.internal.FacebookInitProvider" tools:node="remove" />
        <!-- Collection=false does not prevent eager Crashlytics construction. The
             isolated build has no Crashlytics plugin/backend; remove its registrar. -->
        <service android:name="com.google.firebase.components.ComponentDiscoveryService" tools:node="merge">
            <meta-data android:name="com.google.firebase.components:com.google.firebase.crashlytics.CrashlyticsRegistrar" tools:node="remove" />
        </service>
        <activity android:name=".reelsdemo.NativeReelsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".reelsdemo.DemoPresenterActivity" android:exported="true" android:screenOrientation="portrait" />
        <provider android:name=".reelsdemo.DemoNoteProvider" android:authorities="${applicationId}.demofiles" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/demo_note_paths" />
        </provider>
    </application>
</manifest>
