<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:context=".activity.DoubtChatScreen">

            <!--        <ImageView-->
            <!--            android:layout_width="match_parent"-->
            <!--            android:layout_height="match_parent"-->
            <!--            android:scaleType="fitXY"-->
            <!--            android:src="@drawable/choose_subject_background" />-->

            <!--    HEADER-->
            <RelativeLayout
                android:id="@+id/screen_header"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:id="@+id/hamburg_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/icon_menu_home" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="12dp"
                    android:layout_toRightOf="@id/hamburg_icon"
                    android:fontFamily="@font/urbanist_semi_bold"
                    android:text="@string/instant_guru"
                    android:textColor="@color/black"
                    android:textSize="18dp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="12dp"
                    android:layout_toStartOf="@id/new_chat_btn"
                    android:src="@drawable/icon_share"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/new_chat_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/finish_button_border"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/urbanist_semi_bold"
                        android:text="@string/new_chat"
                        android:textColor="@color/black"
                        android:textSize="14dp" />
                </LinearLayout>

            </RelativeLayout>
            <!--    END HEADER -->

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/chat_load_shimmer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/screen_header"
                android:layout_above="@id/chat_input_container">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <include layout="@layout/chat_support_receive_msg_bubble"/>
                    <include layout="@layout/doubt_chat_send_bubble"/>
                    <include layout="@layout/chat_support_receive_msg_bubble"/>
                    <include layout="@layout/chat_support_receive_msg_bubble"/>
                    <include layout="@layout/doubt_chat_send_bubble"/>
                    <include layout="@layout/chat_support_receive_msg_bubble"/>
                    <include layout="@layout/doubt_chat_send_bubble"/>
                    <include layout="@layout/chat_support_receive_msg_bubble"/>
                    <include layout="@layout/doubt_chat_send_bubble"/>
                    <include layout="@layout/chat_support_receive_msg_bubble"/>
                    <include layout="@layout/doubt_chat_send_bubble"/>
                    <include layout="@layout/chat_support_receive_msg_bubble"/>
                </LinearLayout>


            </com.facebook.shimmer.ShimmerFrameLayout>

            <ScrollView
                android:id="@+id/chat_scollview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@id/chat_input_container"
                android:layout_below="@id/screen_header">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/chat_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="12dp">


                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/bot_chat_loader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="12dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="6dp"
                            android:orientation="horizontal">


                            <ImageView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_gravity="bottom"
                                android:src="@drawable/icon_chat_avatar" />

                            <com.github.ybq.android.spinkit.SpinKitView
                                style="@style/SpinKitView.ThreeBounce"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginLeft="12dp"
                                app:SpinKit_Color="@color/arivihan_secondary_color" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

            <!--    CHAT INPUT CONTAINER-->
            <RelativeLayout
                android:id="@+id/chat_input_container"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_alignParentBottom="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="18dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/doubt_chat_input_border"
                    android:gravity="center"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="10dp">

                    <EditText
                        android:id="@+id/prompt_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/urbanist_regular"
                        android:hint="@string/ask_anything"
                        android:inputType="text|textNoSuggestions"
                        android:paddingVertical="4dp"
                        android:textSize="14dp" />

                    <ImageView
                        android:id="@+id/open_mic_btn"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginRight="12dp"
                        android:src="@drawable/icon_mic_black" />

                    <ImageView
                        android:id="@+id/take_photo_btn"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/icon_camera_black" />

                    <ImageView
                        android:layout_marginLeft="12dp"
                        android:id="@+id/send_prompt_btn"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/icon_send_msg_teal" />
                </LinearLayout>

            </RelativeLayout>
            <!--    END CHAT INPUT CONTAINER-->

            <androidx.cardview.widget.CardView
                android:id="@+id/chat_scroll_down_btn"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentRight="true"
                android:layout_marginRight="18dp"
                android:layout_marginBottom="84dp"
                app:cardBackgroundColor="@color/arivihan_secondary_color"
                app:cardElevation="0dp"
                app:cardCornerRadius="60dp"
                >
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/todolist_spinner_arrow_down"/>

            </androidx.cardview.widget.CardView>

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="start">

            <include layout="@layout/layout_doubt_chat_drawer" />
        </LinearLayout>

    </androidx.drawerlayout.widget.DrawerLayout>

</RelativeLayout>
