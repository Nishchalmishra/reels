<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp"
        android:layout_margin="32dp"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Close button -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="0dp">

                <ImageView
                    android:id="@+id/iv_popup_close"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="end"
                    android:layout_margin="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/close"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/search_close_btn" />

            </FrameLayout>

            <!-- Title (above image as per FRD) -->
            <TextView
                android:id="@+id/tv_popup_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="28dp"
                android:layout_marginTop="-16dp"
                android:fontFamily="@font/urbanist_bold"
                android:gravity="center"
                android:text=""
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:elevation="1dp"
                android:visibility="gone" />

            <!-- Image (below title) -->
            <ImageView
                android:id="@+id/iv_popup_image"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <!-- Subtitle / Message (single text) -->
            <TextView
                android:id="@+id/tv_popup_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="32dp"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/urbanist_semi_bold"
                android:gravity="center"
                android:textColor="#121212"
                android:textSize="14sp"
                android:visibility="visible" />

            <!-- Subtitle Items (bullet points container) -->
            <LinearLayout
                android:id="@+id/ll_popup_subtitle_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="42dp"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:gravity="start"
                android:visibility="gone" />

            <!-- Buttons row -->
            <LinearLayout
                android:id="@+id/ll_popup_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <!-- Secondary button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_popup_secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:visibility="gone"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/arivihan_secondary_color"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/tv_popup_secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/urbanist_semi_bold"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="12dp"
                        android:textColor="@color/arivihan_secondary_color"
                        android:textSize="14sp" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Primary button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_popup_primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/arivihan_secondary_color"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <TextView
                        android:id="@+id/tv_popup_primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/urbanist_semi_bold"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="12dp"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
