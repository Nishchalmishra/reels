<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ParentRelativeLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".MCQAndSubjectiveQuestionFragment"
    android:theme="@style/Theme.MaterialComponents.DayNight.DarkActionBar">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/question_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:scrollbars="none"
        tools:ignore="UselessParent"
        android:layout_above="@id/bottom_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="100dp">


            <!--                android:layout_marginLeft="10dp"-->
            <!--                android:layout_marginTop="10dp"-->
            <!--                android:layout_marginRight="10dp"-->
            <!--                android:layout_marginBottom="20dp"-->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:foregroundGravity="center_horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="15dp"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">
                    <!--                    android:theme="@style/Theme.MaterialComponents.DayNight.DarkActionBar"-->


                    <RelativeLayout
                        android:id="@+id/relative_layout_ques"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="20dp">

                        <LinearLayout
                            android:id="@+id/markLinearLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:weightSum="1"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/mark"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="start"
                                android:layout_marginEnd="2dp"
                                android:layout_weight="0.5"
                                android:orientation="horizontal">

                                <ToggleButton
                                    android:id="@+id/mark_button2"
                                    android:layout_width="20dp"
                                    android:layout_height="22dp"
                                    android:layout_marginTop="0dp"
                                    android:background="@drawable/bookmark_toggle_gray"
                                    android:clickable="false"
                                    android:focusable="false"
                                    android:focusableInTouchMode="false"
                                    android:textOff=""
                                    android:textOn="" />

                                <TextView
                                    android:id="@+id/markText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:layout_marginTop="0dp"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/urbanist_regular"
                                    android:maxLines="1"
                                    android:text="@string/unmarked"
                                    android:textColor="#696969"
                                    android:textSize="14sp" />

                            </LinearLayout>
                            <HorizontalScrollView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:scrollbars="none">
                                <LinearLayout
                                    android:orientation="horizontal"
                                    android:gravity="end"
                                    android:layout_marginStart="2dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="end">

                                    <androidx.cardview.widget.CardView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        app:cardBackgroundColor="#D3F8FA"
                                        app:cardCornerRadius="4dp"
                                        app:cardElevation="0dp"
                                        android:layout_marginEnd="10dp">

                                        <TextView
                                            android:id="@+id/questionType"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="@font/urbanist_semi_bold"
                                            android:paddingHorizontal="9dp"
                                            android:paddingVertical="3dp"
                                            android:text="Medium"
                                            android:textColor="#02858D"
                                            android:textSize="13sp" />
                                    </androidx.cardview.widget.CardView>

                                    <!-- CardView for Green Marks -->
                                    <androidx.cardview.widget.CardView
                                        android:id="@+id/green_marks"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        app:cardBackgroundColor="#D3F8FA"
                                        app:cardCornerRadius="4dp"
                                        app:cardElevation="0dp">

                                        <TextView
                                            android:id="@+id/green_marks_text"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="@font/urbanist_semi_bold"
                                            android:paddingHorizontal="12dp"
                                            android:text="+1"
                                            android:textColor="@color/arivihan_primary_color"
                                            android:textSize="12sp"
                                            android:layout_gravity="center_vertical"/>
                                    </androidx.cardview.widget.CardView>

                                    <!-- CardView for Red Marks -->
                                    <androidx.cardview.widget.CardView
                                        android:id="@+id/red_marks"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:layout_marginLeft="12dp"
                                        app:cardBackgroundColor="#FADFE6"
                                        app:cardCornerRadius="4dp"
                                        app:cardElevation="0dp">

                                        <TextView
                                            android:id="@+id/red_marks_text"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="@font/urbanist_semi_bold"
                                            android:paddingHorizontal="12dp"
                                            android:text="-1"
                                            android:textColor="#A90202"
                                            android:textSize="12sp"
                                            android:layout_gravity="center_vertical"/>
                                    </androidx.cardview.widget.CardView>

                                </LinearLayout>
                            </HorizontalScrollView>
                        </LinearLayout>

<!--                        <androidx.cardview.widget.CardView-->
<!--                            android:id="@+id/case_study_num"-->
<!--                            android:layout_width="wrap_content"-->
<!--                            android:layout_height="wrap_content"-->
<!--                            android:layout_below="@+id/markLinearLayout"-->
<!--                            app:cardBackgroundColor="#D3F8FA"-->
<!--                            android:layout_marginTop="15dp"-->
<!--                            app:cardCornerRadius="12dp"-->
<!--                            app:cardElevation="0dp"-->
<!--                            android:visibility="gone">-->
<!--                            <TextView-->
<!--                                android:id="@+id/case_study_num_text"-->
<!--                                android:layout_width="wrap_content"-->
<!--                                android:layout_height="wrap_content"-->
<!--                                android:text="Case-study 1"-->
<!--                                android:fontFamily="@font/urbanist_bold"-->
<!--                                android:textSize="12sp"-->
<!--                                android:textColor="#02858D"-->
<!--                                android:layout_marginHorizontal="15dp"-->
<!--                                android:layout_marginVertical="5dp"/>-->
<!--                        </androidx.cardview.widget.CardView>-->

                        <TextView
                            android:id="@+id/question"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/markLinearLayout"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="10dp"
                            android:fontFamily="@font/urbanist_medium"
                            android:text=""
                            android:textColor="@color/black"
                            android:textSize="16sp" />

                        <ImageView
                            android:id="@+id/question_image"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/question"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginStart="5dp"
                            android:layout_marginEnd="8dp"
                            android:adjustViewBounds="true"
                            android:src="@drawable/free_sample_by_wix"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/ll_tag_card"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="4dp"
                            android:layout_below="@+id/question_image"
                            >
                            <androidx.cardview.widget.CardView
                                android:id="@+id/tag_card"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="1dp"
                                android:layout_marginEnd="2dp"
                                android:visibility="gone"
                                app:cardBackgroundColor="#333995E3"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                android:layout_gravity="center_vertical">

                                <TextView
                                    android:id="@+id/tag_text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/urbanist_semi_bold"
                                    android:paddingHorizontal="12dp"
                                    android:paddingVertical="5dp"
                                    android:text="JEE 21-2022"
                                    android:textColor="#3995E3"
                                    android:textSize="12sp" />
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView
                                android:id="@+id/case_study_num"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:visibility="gone"
                                android:layout_gravity="center_vertical"
                                android:layout_marginStart="12dp"
                                android:layout_marginEnd="12dp"
                                app:cardBackgroundColor="#D3F8FA"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp">

                                <TextView
                                    android:id="@+id/case_study_num_text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="15dp"
                                    android:layout_marginVertical="5dp"
                                    android:fontFamily="@font/urbanist_bold"
                                    android:text="Case-study 1"
                                    android:textColor="#02858D"
                                    android:textSize="12sp" />
                            </androidx.cardview.widget.CardView>

                        </LinearLayout>


                    </RelativeLayout>


                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/subText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="20dp"
                            android:layout_marginTop="15dp"
                            android:layout_marginRight="20dp"
                            android:fontFamily="@font/nunito_regular"
                            android:paddingTop="2dp"
                            android:paddingRight="10dp"
                            android:paddingBottom="2dp"
                            android:text="You can Maximum Attempt 5 Question"
                            android:textColor="@color/grey_500"
                            android:textSize="@dimen/tertiary_text_size" />

                    </RelativeLayout>

                    <TextView
                        android:id="@+id/response_your_submission"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="@font/urbanist_medium"
                        android:text="@string/your_submitted_answer"
                        android:textColor="#696969"
                        android:textSize="12sp"
                        android:visibility="visible" />


                    <EditText
                        android:inputType="text"
                        android:imeOptions="actionDone"
                        android:id="@+id/integerAnswer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/question_option_border"
                        android:fontFamily="@font/nunito_regular"
                        android:hint="@string/please_enter_your_answer"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="14dp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/mock_grey"
                        android:textSize="@dimen/primary_text_size"
                        android:visibility="gone" />

                    <EditText
                        android:imeOptions="actionDone"
                        android:id="@+id/NumericalAnswer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/question_option_border"
                        android:fontFamily="@font/urbanist_medium"
                        android:hint="@string/enter_the_numerical_value"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="14dp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/mock_grey"
                        android:textSize="@dimen/primary_text_size"
                        android:visibility="gone" />

                    <!--                <com.google.android.material.textfield.TextInputEditText-->
                    <!--                    android:id="@+id/NumericalAnswerrr"-->
                    <!--                    android:layout_width="match_parent"-->
                    <!--                    android:layout_height="match_parent"-->
                    <!--                    android:drawablePadding="6dp"-->
                    <!--                    android:fontFamily="@font/poppins_light"-->
                    <!--                    android:inputType="numberDecimal"-->
                    <!--                    android:maxLength="10"-->
                    <!--                    android:textColor="@color/black" />-->
                    <!--            </com.google.android.material.textfield.TextInputLayout>-->

                    <ImageView
                        android:id="@+id/subjective_answer_image"
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:layout_marginTop="20dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/YourResponse"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="30dp"
                        android:layout_marginTop="22dp"
                        android:layout_marginRight="20dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/nunito_semibold"
                        android:text="@string/your_response"
                        android:textSize="16sp"
                        android:textStyle="italic"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/correct_answer_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="22dp"
                        android:layout_marginVertical="15dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/CorrectAnswerLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/urbanist_medium"
                            android:textColor="#696969"
                            android:textSize="12sp"
                            android:text="@string/correct_answer_1"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/CorrectAnswer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:text="@string/correct_answer_1"
                            android:textColor="#189C4D"
                            android:textSize="16sp"
                            android:visibility="gone"
                            android:paddingVertical="10dp"
                            android:layout_marginStart="10dp"/>

                    </LinearLayout>


                    <include
                        android:id="@+id/match_these"
                        layout="@layout/match_these_layout"
                        android:visibility="gone" />


                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="15dp"
                        tools:itemCount="5"
                        tools:listitem="@layout/recycler_view_option_item" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">


                        <TextView
                            android:id="@+id/Correctionpercentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="6dp"
                            android:drawablePadding="5dp"
                            android:text="27 % of students have given correct answer"
                            android:textColor="@color/green"
                            android:textSize="@dimen/secondary_text_size"
                            android:textStyle="bold"
                            android:visibility="gone" />


                        <!--                        <TextView-->
                        <!--                            android:id="@+id/marks_obtained"-->
                        <!--                            android:layout_width="wrap_content"-->
                        <!--                            android:layout_height="wrap_content"-->
                        <!--                            android:layout_below="@id/explanation"-->
                        <!--                            android:layout_marginVertical="6dp"-->
                        <!--                            android:layout_marginLeft="30dp"-->
                        <!--                            android:drawablePadding="5dp"-->
                        <!--                            android:text="Your Marks: 30/40"-->
                        <!--                            android:textColor="@color/arivihan_primary_color"-->
                        <!--                            android:textSize="@dimen/secondary_text_size"-->
                        <!--                            android:textStyle="bold"-->
                        <!--                            android:visibility="visible" />-->


                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/solution_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:visibility="gone"
                        android:paddingBottom="90dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:text="@string/Solution"
                            android:textColor="@color/black"
                            android:textSize="18sp" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/difficulty_card"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#D3F8FA"
                            android:layout_marginBottom="14dp"
                            android:visibility="gone">
                            <TextView
                                android:id="@+id/difficulty_type"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Medium"
                                android:textColor="#02858D"
                                android:textSize="10sp"
                                android:fontFamily="@font/urbanist_semi_bold"
                                android:paddingHorizontal="9dp"
                                android:paddingVertical="5dp"/>
                        </androidx.cardview.widget.CardView>


                        <androidx.cardview.widget.CardView
                            android:id="@+id/solution_image_card"
                            android:layout_width="match_parent"
                            android:layout_height="230dp"
                            android:layout_marginBottom="16dp"
                            android:visibility="gone"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitCenter"
                                android:src="@drawable/mock_test_video_player_image"

                                />

                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:id="@+id/solution_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:fontFamily="@font/nunito_regular"
                            android:textColor="@color/black"
                            android:textSize="16dp" />


                            <arivihan.technologies.doubtbuzzter2.helper.ImageLoaderUtil
                            android:id="@+id/solution_image"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </LinearLayout>

            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:backgroundTint="@color/white"
        android:paddingVertical="20dp"
        android:paddingHorizontal="20dp"
        android:weightSum="2">

        <!-- First LinearLayout containing Clear Answer button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_marginEnd="5dp"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:id="@+id/button_clear_answer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#E9FBFC"
                app:cardCornerRadius="7dp"
                app:cardElevation="0dp"
                android:visibility="invisible"
                android:layout_gravity="start">

                <TextView
                    android:id="@+id/btn_text_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="12dp"
                    android:textAlignment="center"
                    android:paddingHorizontal="12dp"
                    android:fontFamily="@font/urbanist_semi_bold"
                    android:text="@string/clear"
                    android:textColor="@color/arivihan_secondary_color"
                    android:textSize="14sp"
                    android:ellipsize="end"
                    android:maxLines="1"/>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:id="@+id/button_answer_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/subscription_blue"
                app:cardCornerRadius="7dp"
                android:layout_gravity="end"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/btn_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="12dp"
                    android:fontFamily="@font/urbanist_semi_bold"
                    android:text="@string/save_and_continue"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/white"
                    android:textAlignment="center"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="14sp"/>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/view_solution_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:visibility="gone"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        android:layout_above="@id/bottom_layout"
        android:layout_centerHorizontal="true"
        app:cardBackgroundColor="#CC000000"
        android:alpha="0.8">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:paddingVertical="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_semibold"
                android:text="@string/view_solution"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_gravity="center"
                android:layout_marginStart="5dp"
                android:src="@drawable/arrow_down_white" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>



    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/celebration"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:layout_centerInParent="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/correct_answer"
        app:lottie_repeatCount="0" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="86dp">

        <RelativeLayout
            android:id="@+id/case_study_fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:visibility="gone">

            <com.airbnb.lottie.LottieAnimationView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_centerInParent="true"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/ring_waves" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/case_study_fab_card"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_centerInParent="true"
                app:cardBackgroundColor="@color/subscription_blue"
                app:cardCornerRadius="60dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/case_study_fab_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Case_Study"
                    android:layout_gravity="center"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/rubik_semi_bold"
                    android:gravity="center"/>
            </com.google.android.material.card.MaterialCardView>
        </RelativeLayout>

    <RelativeLayout
        android:id="@+id/ask_doubt_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:visibility="invisible">

        <com.airbnb.lottie.LottieAnimationView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_centerInParent="true"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/ring_waves" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_centerInParent="true"
            android:backgroundTint="#26C6DA"
            app:cardCornerRadius="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ask_more"
                android:layout_gravity="center"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:fontFamily="@font/rubik_semi_bold"
                android:gravity="center"/>
        </com.google.android.material.card.MaterialCardView>
    </RelativeLayout>
    </LinearLayout>

</RelativeLayout>