<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:theme="@style/Theme.MaterialComponents.DayNight.DarkActionBar"
    tools:context=".activity.SubscriptionActivityNew">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:layout_marginVertical="10dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/back_button_layout"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="17dp">

            <ImageView
                android:id="@+id/back_button"
                android:layout_width="13dp"
                android:layout_height="15dp"
                android:layout_marginTop="1dp"
                android:src="@drawable/arrow_icon" />
        </LinearLayout>

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/urbanist_semi_bold"
            android:text="@string/SubscriptionPlan"
            android:textColor="@color/black"
            android:textSize="@dimen/toolbar_title_size" />

        <androidx.cardview.widget.CardView
            android:id="@+id/how_to_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="5dp"
            android:layout_marginEnd="1dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginHorizontal="8dp"
                android:layout_marginVertical="5dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/How_to_Join"
                    android:fontFamily="@font/urbanist_medium"
                    android:textSize="16dp"
                    android:textColor="#99000000"/>

                <ImageView
                    android:id="@+id/how_to_video_icon"
                    android:layout_width="18dp"
                    android:layout_height="20dp"
                    android:src="@drawable/how_to_question_mark" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintVertical_weight="1"
        app:layout_constraintTop_toBottomOf="@id/toolbar">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="160dp">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/plan_type_rv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="35dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/toolbar"
                tools:listitem="@layout/subscription_type_item"
              />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmer_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:layout_constraintTop_toBottomOf="@id/toolbar">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <include layout="@layout/subscription_shimmer_layout" />
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <ScrollView
                android:id="@+id/scroll_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/plan_type_rv">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:id="@+id/cv_subscription_options"
                        android:layout_height="wrap_content"
                        android:layout_margin="20dp"
                        android:layout_marginTop="15dp"
                        android:backgroundTint="@color/mock_light_blue"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="4dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/plan_type_rv">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="0dp">

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/plan_options_rv"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="10dp"
                                    tools:itemCount="2"
                                    tools:listitem="@layout/subscription_option_item" />
                            </com.google.android.material.card.MaterialCardView>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="20dp"
                                android:paddingVertical="8dp">

                                <TextView
                                    android:id="@+id/selected_months"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/urbanist_medium"
                                    android:text="12 Months"
                                    android:textColor="#919191"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/overview_cost_price"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="10dp"
                                    android:fontFamily="@font/urbanist_medium"
                                    android:text="3999"
                                    android:textColor="@color/mock_darker_grey"
                                    android:textSize="10dp" />

                                <TextView
                                    android:id="@+id/overview_final_price"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/urbanist_semi_bold"
                                    android:text="2499"
                                    android:textColor="@color/black"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginTop="10dp"
                        app:cardCornerRadius="15dp"
                        app:cardElevation="4dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingStart="15dp"
                            android:paddingTop="15dp">

                            <TextView
                                android:id="@+id/feature_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/urbanist_semi_bold"
                                android:text="@string/feature"
                                android:textColor="@color/black"
                                android:textSize="13sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <ImageView
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:layout_marginEnd="10dp"
                                android:src="@drawable/sparkles"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/feature_rv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:layout_marginBottom="10dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/feature_title"
                                tools:itemCount="5"
                                tools:listitem="@layout/subscription_feature_layout"/>

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/feature_animation"
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:scaleType="fitXY"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:lottie_autoPlay="true"
                                app:lottie_loop="true"
                                app:lottie_rawRes="@raw/course" />

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginTop="25dp">

                        <!-- Coupon Code Section -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/discount_icon" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:fontFamily="@font/urbanist_medium"
                                android:text="@string/coupon_Code"
                                android:textColor="@color/black"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Coupon Input + Apply + Remove -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/lighter_grey"
                            app:cardCornerRadius="20dp"
                            android:layout_marginBottom="10dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <EditText
                                    android:id="@+id/coupon_code"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:layout_marginHorizontal="15dp"
                                    android:layout_marginVertical="12dp"
                                    android:maxLines="1"
                                    android:inputType="textNoSuggestions"
                                    android:background="@null"
                                    android:fontFamily="@font/urbanist_regular"
                                    android:hint="@string/enter_coupon_code"
                                    android:textSize="12sp"
                                    android:textColor="@color/subscription_blue" />

                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/apply_card"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:backgroundTint="@color/subscription_blue"
                                    app:cardCornerRadius="20dp"
                                    app:cardElevation="0dp">

                                    <TextView
                                        android:id="@+id/apply_code_text"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:fontFamily="@font/urbanist_medium"
                                        android:gravity="center"
                                        android:paddingHorizontal="17dp"
                                        android:text="@string/apply_code"
                                        android:textColor="@color/white"
                                        android:textSize="12sp" />
                                </com.google.android.material.card.MaterialCardView>

                                <ImageView
                                    android:id="@+id/remove_coupon"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:src="@drawable/search_close_btn"
                                    android:layout_margin="10dp"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Applied Coupon Message -->
                        <TextView
                            android:id="@+id/applied_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/coupon_applied"
                            android:textSize="14sp"
                            android:visibility="gone"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:layout_marginHorizontal="10dp"
                            android:layout_marginBottom="10dp"
                            android:textColor="@color/subscription_green" />

                        <!-- Pricing & Discount Section -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/cv_coupon_price_breakdown"
                            android:layout_marginBottom="10dp"
                            android:backgroundTint="#66F5F5FA"
                            app:cardCornerRadius="10dp"
                            android:visibility="gone"
                            app:cardElevation="0dp"
                            app:strokeColor="#33000000"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="15dp">

                                <!-- Subscription Price -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/urbanist_medium"
                                        android:text="@string/subscription_price"
                                        android:textColor="@color/subscription_price_grey"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/subscription_price"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/urbanist_medium"
                                        android:text="₹1999"
                                        android:textColor="@color/black"
                                        android:textSize="11sp" />
                                </LinearLayout>

                                <!-- Discount -->
                                <LinearLayout
                                    android:id="@+id/coupon_discount_layout"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:visibility="gone">

                                    <TextView
                                        android:id="@+id/discount_percent"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/urbanist_medium"
                                        android:text="@string/coupon_code_text"
                                        android:textColor="@color/subscription_price_grey"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/discount_price"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/urbanist_medium"
                                        android:text="- ₹160"
                                        android:textColor="#E50000"
                                        android:textSize="11sp" />
                                </LinearLayout>

                                <!-- Total -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/urbanist_semi_bold"
                                        android:text="@string/total"
                                        android:textColor="@color/subscription_blue"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/total_price"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/urbanist_semi_bold"
                                        android:text="₹1839"
                                        android:textColor="@color/subscription_blue"
                                        android:textSize="11sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Terms & Conditions -->
                        <LinearLayout
                            android:id="@+id/tnc_checkbox_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="20dp">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/tnc_checkbox"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                app:cardElevation="0dp"
                                app:strokeColor="@color/black"
                                app:strokeWidth="1dp"
                                android:layout_marginTop="2dp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginStart="10dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/urbanist_medium"
                                        android:text="@string/agree_to_the"
                                        android:textColor="@color/black"
                                        android:textSize="12sp" />

                                    <TextView
                                        android:id="@+id/tnc"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/urbanist_medium"
                                        android:text="@string/terms_and_conditions"
                                        android:ellipsize="end"
                                        android:maxLines="1"
                                        android:textColor="@color/subscription_blue"
                                        android:textSize="12sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/urbanist_medium"
                                        android:text="@string/and"
                                        android:textColor="@color/black"
                                        android:textSize="12sp" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/privacy_policy"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:fontFamily="@font/urbanist_medium"
                                    android:text="@string/privacy_policy"
                                    android:textColor="@color/subscription_blue"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>



                    <LinearLayout
                        android:id="@+id/offer_timer_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/limited_offer_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:text="Limited Offer Valid Till 18 April"
                            android:textColor="@color/black"
                            android:textSize="11sp" />

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:layout_marginHorizontal="8dp"
                            android:src="@drawable/time_outline" />

                        <TextView
                            android:id="@+id/countdown_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:text="72:30:26"
                            android:textColor="@color/subscription_blue"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/plans_rv"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        tools:itemCount="1"
                        tools:listitem="@layout/subscription_plans_layout" />

                    <LinearLayout
                        android:id="@+id/talk_to_us_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="15dp"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:text="@string/talk_to_our_experts"
                            android:textColor="@color/black"
                            android:textSize="15sp" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="20dp"
                            android:layout_marginTop="15dp"
                            android:layout_marginBottom="10dp"
                            android:theme="@style/Theme.MaterialComponents.Light"
                            app:cardBackgroundColor="@color/white"
                            app:cardCornerRadius="15dp"
                            app:cardElevation="2dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:layout_margin="10dp"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/iv_talk_to_us"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="0.4"
                                    android:adjustViewBounds="true"
                                    android:src="@drawable/talk_to_us_image"
                                    android:scaleType="fitXY" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.6"
                                    android:gravity="center_vertical"
                                    android:orientation="vertical"
                                    android:paddingHorizontal="15dp"
                                    android:paddingVertical="15dp">

                                    <TextView
                                        android:id="@+id/tv_talk_to_us_title"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/urbanist_semi_bold"
                                        android:text="Unnati 2.0 se judna chahte hain, par kaise?"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/tertiary_text_size" />

                                    <TextView
                                        android:id="@+id/tv_talk_to_us_sub_title"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:fontFamily="@font/urbanist_medium"
                                        android:text="Humare experts se baat karein aur Unnati Batch 2.0 join karein."
                                        android:textColor="@color/subscription_questions"
                                        android:textSize="11sp" />


                                    <com.google.android.material.card.MaterialCardView
                                        android:id="@+id/cv_call_back"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:theme="@style/Theme.MaterialComponents.Light"
                                        app:cardCornerRadius="8dp"
                                        app:cardElevation="0dp">

                                        <LinearLayout
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:orientation="horizontal"
                                            android:gravity="center_vertical"
                                            android:background="@color/mock_primary_color"
                                            android:paddingHorizontal="16dp"
                                            android:paddingVertical="8dp">

                                            <TextView
                                                android:id="@+id/talk_to_us"
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:ellipsize="end"
                                                android:singleLine="true"
                                                android:fontFamily="@font/urbanist_semi_bold"
                                                android:text="Request a Call Back"
                                                android:textColor="@color/white"
                                                android:textSize="12sp"
                                                android:layout_marginEnd="8dp" />

                                            <ImageView
                                                android:layout_width="16dp"
                                                android:layout_height="16dp"
                                                android:src="@drawable/ic_whats_app_call_back"
                                                android:contentDescription="@string/talk_to_us" />

                                        </LinearLayout>
                                    </com.google.android.material.card.MaterialCardView>

                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/discount_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/yellow_gradient_4"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottom_layout">

        <TextView
            android:id="@+id/discount_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/urbanist_medium"
            android:singleLine="true"
            android:text="@string/Discount_ARIVIHAN_Coupon_code_applied"
            android:textColor="@color/black"
            android:textSize="11sp" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp"
        android:elevation="5dp"
        android:outlineSpotShadowColor="@color/black"
        android:outlineAmbientShadowColor="@color/black"
        app:contentPaddingBottom="10dp"
        app:contentPaddingLeft="20dp"
        app:contentPaddingRight="20dp"
        app:contentPaddingTop="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:orientation="vertical"
                android:padding="5dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="start">

                    <TextView
                        android:id="@+id/overall_cost_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/urbanist_medium"
                        android:text="3999"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/overall_final_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/urbanist_semi_bold"
                        android:text="1999"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/black"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/selected_plan_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/urbanist_medium"
                    android:text="JEE Mains - 12 months"
                    android:textSize="11sp"
                    android:ellipsize="end"
                    android:maxLines="2"/>
            </LinearLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/join_campaign_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/join_now_gradient_forward"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:id="@+id/join_content_layout"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginVertical="10dp"
                    android:gravity="center"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/join_icon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/join_now_icon_2"
                        android:contentDescription="@string/Join_Now" />

                    <TextView
                        android:id="@+id/join_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/urbanist_semi_bold"
                        android:text="@string/join_now_text_1"
                        android:textColor="@color/black"
                        android:textSize="14dp"
                        android:layout_marginStart="6dp" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <include
        android:id="@+id/how_to_video_view"
        layout="@layout/activity_mock_demo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>