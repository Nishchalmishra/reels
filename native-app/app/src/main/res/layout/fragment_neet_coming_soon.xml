<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- ═══ Background layer (independent, decorative) ═══ -->

    <View
        android:id="@+id/bg_gradient"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="@drawable/gradient_navy_blue" />

    <ImageView
        android:id="@+id/bg_cloud"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="top"
        android:scaleType="fitXY"
        android:src="@drawable/medium_screen_image_3" />

    <ImageView
        android:id="@+id/bg_bird"
        android:layout_width="90dp"
        android:layout_height="50dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/medium_screen_image_2" />

    <!-- ═══ Content layer — NOT scrollable, top gravity ═══ -->

    <LinearLayout
        android:id="@+id/ll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- Portrait image — flexible height, shrinks to give card room -->
        <FrameLayout
            android:id="@+id/fl_illustration_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="90dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/iv_illustration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginHorizontal="92dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/img_ritesh_sir_portrait" />

        </FrameLayout>

        <!-- White card with dotted teal border — always fully visible -->
        <LinearLayout
            android:id="@+id/cv_content_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="-12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/border_dashed_teal"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <!-- Circular card with rocket icon -->
            <androidx.cardview.widget.CardView
                android:layout_width="116dp"
                android:layout_height="116dp"
                app:cardBackgroundColor="#DEF6F9"
                app:cardCornerRadius="58dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/iv_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginVertical="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_rocket_teal" />

            </androidx.cardview.widget.CardView>

            <!-- Heading -->
            <TextView
                android:id="@+id/tv_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/urbanist_bold"
                android:gravity="center"
                android:textColor="#191919"
                android:textSize="22sp" />

            <!-- Inner card with teal tint background for subtext -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#1A26C6DA"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/tv_subtext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/urbanist_medium"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="24dp"
                    android:textColor="#5A5A5A"
                    android:textSize="15sp" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
