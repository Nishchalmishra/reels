<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragments.todo.create_todo.congratulation_screen.ToDoFiveLeftFragment"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/animation"
            android:layout_width="270dp"
            android:layout_height="270dp"
            app:lottie_rawRes="@raw/creating_routine"
            android:layout_marginTop="120dp"/>

        <TextView
            android:id="@+id/name_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/urbanist_bold"
            android:gravity="center"
            android:text="@string/creating_routine"
            android:textColor="@color/subscription_blue"
            android:textSize="25sp" />

        <TextView
            android:id="@+id/subject_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/urbanist_semi_bold"
            android:text="@string/wait_karein"
            android:textColor="#696969"
            android:textSize="18sp"
            android:layout_marginTop="25dp"
            android:gravity="center"/>

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/go_to_home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="50dp"
        app:cardBackgroundColor="@color/mock_primary_color"
        android:layout_marginHorizontal="90dp"
        app:cardCornerRadius="10dp">

        <TextView
            android:id="@+id/number_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Home_Screen"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:fontFamily="@font/urbanist_semi_bold"
            android:layout_gravity="center"
            android:layout_marginVertical="12dp"/>

    </androidx.cardview.widget.CardView>



</androidx.constraintlayout.widget.ConstraintLayout>