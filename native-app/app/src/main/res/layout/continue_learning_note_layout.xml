<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="0dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/main_card"
        android:layout_width="182dp"
        android:layout_height="113dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="10dp"
        android:outlineSpotShadowColor="@color/grey_500"
        app:cardBackgroundColor="@color/grey_300"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:outlineAmbientShadowColor="@color/grey_500">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white">

            <ImageView
                android:id="@+id/iv_completed_status"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentEnd="true"
                android:layout_margin="4dp"
                android:visibility="gone"
                android:src="@drawable/today_class_complete_icon" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_above="@id/rl_bottom"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        >
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:layout_marginTop="8dp"
                            >
                            <ImageView
                                android:id="@+id/iv_subject_icon"
                                android:layout_width="19dp"
                                android:layout_height="19dp"
                                android:src="@drawable/deafault_subject_teal"
                                android:scaleType="centerCrop"
                                android:layout_gravity="center_vertical"
                                />

                            <TextView
                                android:id="@+id/tv_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Physics"
                                android:textColor="@color/arivihan_secondary_color"
                                android:textSize="15sp"
                                android:fontFamily="@font/urbanist_semi_bold"
                                android:layout_marginStart="12dp"
                                android:layout_marginEnd="2dp"
                                android:layout_gravity="center_vertical"
                                android:maxLines="1"
                                android:ellipsize="end"
                                />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Physics"
                            android:textColor="@color/black"
                            android:textSize="11sp"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="2dp"
                            android:layout_gravity="center_vertical"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="2dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="8dp"
                            />
                    </LinearLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_progress"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:visibility="visible"
                        android:layout_gravity="center"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginTop="4dp"
                        >

                        <ProgressBar
                            android:id="@+id/pb_progress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/circle_shape_video_download"
                            android:indeterminate="false"
                            android:progress="52"
                            android:progressDrawable="@drawable/circle_progress_video_download"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <TextView
                            android:id="@+id/tv_progress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:text="52%"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:textColor="@color/arivihan_secondary_color"
                            android:textSize="11sp"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Physics"
                    android:textColor="#8A8A8A"
                    android:textSize="11sp"
                    android:fontFamily="@font/urbanist_medium"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="2dp"
                    android:layout_gravity="center_vertical"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="1dp"
                    android:layout_marginBottom="2dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="8dp"
                    />

            </LinearLayout>

            <RelativeLayout
                android:id="@+id/rl_bottom"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:layout_alignParentBottom="true"
                android:background="#E9FBFC">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginTop="-2dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_bottom_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:ellipsize="end"
                            android:fontFamily="@font/urbanist_bold"
                            android:maxWidth="90dp"
                            android:maxLines="1"
                            android:text="Know more"
                            android:textColor="#26C6DA"
                            android:textSize="11dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/arivihan_secondary_color" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iv_bottom"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="-8dp"
                        android:padding="4dp"
                        android:src="@drawable/arrow_forward_white_24"
                        android:visibility="visible"
                        app:tint="#26C6DA" />


                </LinearLayout>

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rl_position"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_margin="3dp"
                android:background="@drawable/today_task_current_item_badge"
                android:paddingHorizontal="6dp"
                android:visibility="gone"
                >

                <TextView
                    android:id="@+id/tv_task_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/urbanist_semi_bold"
                    android:text="2/6"
                    android:textColor="@color/arivihan_secondary_color"
                    android:textSize="12sp" />
            </RelativeLayout>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/new_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardBackgroundColor="@color/streak_yellow"
        app:cardCornerRadius="2dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/urbanist_semi_bold"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp"
            android:text="@string/New"
            android:textColor="@color/black"
            android:textSize="10sp" />
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>