<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginVertical="10dp"
    android:background="@color/white"
    android:theme="@style/Theme.MaterialComponents.DayNight.DarkActionBar"
    android:orientation="horizontal">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/mock_lightest_grey">

            <LinearLayout
                android:id="@+id/color_tag"
                android:layout_width="5dp"
                android:layout_height="match_parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:orientation="horizontal"
                android:background="@color/mock_blue"/>

            <TextView
                android:id="@+id/card_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintLeft_toRightOf="@id/color_tag"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintRight_toLeftOf="@id/score_detail"
                android:text="Physics"
                android:textSize="@dimen/tertiary_text_size"
                android:fontFamily="@font/nunito_bold"
                android:textColor="@color/black"
                android:layout_marginVertical="10dp"
                android:layout_marginHorizontal="12dp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/score_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                android:text="76/120"
                android:textSize="@dimen/tertiary_text_size"
                android:textColor="@color/mock_dark_grey"
                android:layout_marginVertical="10dp"
                android:layout_marginEnd="20dp"/>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/attempt_progress"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                app:layout_constraintTop_toBottomOf="@id/card_title"
                app:layout_constraintLeft_toRightOf="@+id/color_tag"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="10dp"
                android:layout_marginTop="10dp"
                app:trackThickness="4dp"
                app:trackCornerRadius="20dp"
                android:indeterminate="false"
                app:indicatorColor="@color/mock_blue"
                app:trackColor="@color/white"
                android:progress="70"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>