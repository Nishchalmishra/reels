<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".activity.CurrentDoubtActivity">


    <RelativeLayout
        android:id="@+id/ParentRelativeLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include android:id="@+id/toolbar"
        layout="@layout/activity_custom_toolbar_layout"/>

    <com.github.ybq.android.spinkit.SpinKitView
        android:id="@+id/progress_dataLoading"
        android:layout_width="match_parent"
        android:visibility="visible"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        style="@style/SpinKitView.FadingCircle"
        app:SpinKit_Color="#19B0C1"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/RecyclerViewCurrentDoubt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:layout_marginTop="8dp"/>

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieNoData"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_centerInParent="true"
        android:visibility="gone"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/nodoubt"/>

</RelativeLayout>