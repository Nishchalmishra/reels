<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/video_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="30dp"
            android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/top_dash"
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:background="@drawable/verticle_dotted_line"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/number_card"/>

            <LinearLayout
                android:id="@+id/bottom_dash"
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:background="@drawable/verticle_dotted_line"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/number_card"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginTop="-10dp"/>

            <ProgressBar
                android:id="@+id/lecture_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/circle_shape_coloured"
                android:indeterminate="false"
                android:progress="20"
                android:progressDrawable="@drawable/circle_progress_chapter"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.cardview.widget.CardView
                android:id="@+id/number_card"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:backgroundTint="#F2F2F3"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="@id/lecture_progress"
                app:layout_constraintLeft_toLeftOf="@id/lecture_progress"
                app:layout_constraintRight_toRightOf="@id/lecture_progress"
                app:layout_constraintTop_toTopOf="@id/lecture_progress">

                <TextView
                    android:id="@+id/lecture_number"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/nunito_extra_bold"
                    android:gravity="center"
                    android:text="01"
                    android:textColor="#7B7B81"
                    android:textSize="10sp" />
            </androidx.cardview.widget.CardView>

            <ImageView
                android:id="@+id/check_img"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/check"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/lecture_progress"
                app:layout_constraintLeft_toLeftOf="@id/lecture_progress"
                app:layout_constraintRight_toRightOf="@id/lecture_progress"
                app:layout_constraintTop_toTopOf="@id/lecture_progress" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/video_detail_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginVertical="15dp">

            <TextView
                android:id="@+id/lecture_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/urbanist_bold"
                android:text="Kinematics terminology"
                android:textColor="@color/title_color"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/play_img"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/play_lecture_light" />

            <ImageView
                android:id="@+id/locked"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginHorizontal="10dp"
                android:src="@drawable/lock_light"
                android:visibility="gone"/>

            <ImageView
                android:id="@+id/download"
                android:layout_width="45dp"
                android:layout_height="30dp"
                android:paddingHorizontal="10dp"
                android:src="@drawable/download_light"
                android:visibility="visible"/>

            <ImageView
                android:id="@+id/download_video_complete"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="10dp"
                android:visibility="gone"
                android:src="@drawable/download_complete"
                android:layout_gravity="center_vertical" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/download_progress_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginStart="15dp">

                <ProgressBar
                    android:id="@+id/download_progress_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:background="@drawable/circle_shape_video_download"
                    android:indeterminate="false"
                    android:progressDrawable="@drawable/circle_progress_video_download"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/download_progress_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:text="0%"
                    android:fontFamily="@font/urbanist_semi_bold"
                    android:textColor="#3F3F3F"
                    android:textSize="9sp"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>


    </LinearLayout>

    <include
        android:visibility="gone"
        android:id="@+id/notes_layout"
        layout="@layout/notes_download_item"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/practice_rv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:itemCount="2"
        tools:listitem="@layout/practice_question_item"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/connecting_dot"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:background="@color/subscription_blue"
            android:orientation="horizontal"
            android:layout_marginHorizontal="14.5dp"
            android:visibility="invisible"/>

        <LinearLayout
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="30dp"
            android:layout_weight="1"
            android:background="#80000000"
            android:orientation="horizontal" />
    </LinearLayout>

</LinearLayout>