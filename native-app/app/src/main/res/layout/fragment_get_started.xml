<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:id="@+id/frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.GetStartedFragment">

   <androidx.constraintlayout.widget.ConstraintLayout
       android:layout_width="match_parent"
       android:layout_height="match_parent">

      <RelativeLayout
          android:id="@+id/relativeLayout"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:paddingTop="15dp">

         <ImageView
             android:layout_width="25dp"
             android:layout_height="25dp"
             android:layout_marginLeft="15dp"
             android:scaleType="fitXY"
             android:src="@drawable/sign_in_gradient_logo" />

         <TextView
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_alignParentRight="true"
             android:layout_marginRight="15dp"
             android:drawableLeft="@drawable/ic_help"
             android:drawablePadding="3dp"
             android:text="Help"
             android:textColor="#00838F"
             android:textSize="@dimen/secondary_text_size" />


      </RelativeLayout>

      <androidx.viewpager.widget.ViewPager
          android:id="@+id/view_pager"
          android:overScrollMode="never"
          android:clipToPadding="false"
          android:layout_marginBottom="80dp"
          android:layout_width="match_parent"
          android:layout_height="400dp"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintTop_toTopOf="parent" />

      <com.rd.PageIndicatorView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:piv_selectedColor="#19B0C1"
          app:piv_dynamicCount="true"
          app:piv_interactiveAnimation="true"
          app:piv_animationType="thinWorm"
          app:piv_viewPager="@id/view_pager"
          app:piv_unselectedColor="#C4C4C4"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@id/view_pager" />


      <androidx.cardview.widget.CardView
          android:id="@+id/start_card"
          android:layout_width="match_parent"
          android:layout_height="50dp"
          style="@style/StartActivityButton"
          app:layout_constraintBottom_toBottomOf="parent"
          android:layout_marginRight="15dp"
          android:layout_marginLeft="15dp"
          android:layout_marginBottom="50dp"
          app:cardElevation="0dp"
          >

         <RelativeLayout
             android:layout_width="match_parent"
             android:layout_height="match_parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Get Started"
                android:textColor="@color/white"
                android:textSize="@dimen/LargeTitleSize" />

         </RelativeLayout>

      </androidx.cardview.widget.CardView>


   </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>