<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.ImageCropperActivity"
    android:theme="@style/Theme.MaterialComponents.DayNight.DarkActionBar">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/image_crop_btn"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:orientation="horizontal"
        android:layout_alignParentEnd="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:strokeWidth="1dp"
        app:strokeColor="@color/white"
        app:cardBackgroundColor="@color/black"
        app:cardCornerRadius="20dp">

        <TextView
            android:layout_gravity="center_vertical"
            android:textAlignment="center"
            android:gravity="center"
            android:fontFamily="@font/urbanist_bold"
            android:text="Crop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="8dp"
            android:textSize="14sp"/>
    </com.google.android.material.card.MaterialCardView>



    <androidx.viewpager.widget.ViewPager
        android:layout_marginVertical="50dp"
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.recyclerview.widget.RecyclerView
        tools:listitem="@layout/peek_recycler_view_item"
        tools:itemCount="3"
        android:id="@+id/peek_recycler_view"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/crop_done"
        app:backgroundTint="@color/arivihan_secondary_color"
        app:tint="@color/white"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="20dp"
        app:srcCompat="@drawable/baseline_arrow_forward_24"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_width="54dp"
        android:layout_height="54dp"/>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#CC000000"
        app:cardCornerRadius="30dp"
        android:id="@+id/question_view"
        android:layout_marginBottom="10dp"
        android:layout_above="@id/crop_done"
        android:layout_marginHorizontal="10dp"
        app:cardElevation="0dp"
        android:elevation="0dp"
        android:visibility="visible"
        app:strokeColor="@color/white"
        app:strokeWidth="1dp">

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/Question_describe_karein"
            android:textColorHint="@color/white"
            android:layout_margin="15dp"
            android:textColor="@color/white"
            android:background="@null"
            android:id="@+id/question"
            android:textSize="14sp"
            android:fontFamily="@font/urbanist_regular"/>
    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>
