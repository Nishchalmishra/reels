<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardCornerRadius="20dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="#191919"
    android:layout_marginHorizontal="42dp"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Title -->
            <TextView
                android:id="@+id/dialog_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/urbanist_bold"
                android:gravity="center"
                android:text="@string/locked"
                android:textSize="20sp"
                android:textColor="#AFFFFFFF"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp"
                android:lineSpacingExtra="4dp"/>

            <!-- Animation -->
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/dialog_animation"
                android:layout_width="160dp"
                android:layout_height="160dp"
                app:lottie_rawRes="@raw/anim_premium_lock"
                app:lottie_loop="true"
                android:visibility="visible"
                app:lottie_autoPlay="true"
                android:scaleX="1.2"
                android:scaleY="1.2"
                android:layout_marginTop="2dp"/>

            <ImageView
                android:id="@+id/iv_lock"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:src="@drawable/img_premium_lock"
                android:layout_marginTop="2dp"
                android:padding="24dp"
                android:visibility="gone"
                android:layout_marginVertical="16dp"/>
            <!-- Description -->
            <TextView
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="20dp"
                android:fontFamily="@font/urbanist_medium"
                android:gravity="center"
                android:layout_marginTop="-12dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/OOpsThisMicroIsLocked"
                android:textColor="#9CFFFFFF"
                android:textSize="16sp" />

            <!-- CTA Button Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/subscriptionLayout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                app:cardBackgroundColor="@color/mock_primary_color"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/join_now_pro_plus_gradient"
                    >
                    <TextView
                        android:id="@+id/subs"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:fontFamily="@font/urbanist_semi_bold"
                        android:text="@string/join_pro_plan"
                        android:textColor="#191919"
                        android:layout_centerInParent="true"
                        android:textSize="18sp"/>
                </RelativeLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginHorizontal="12dp"
            android:layout_marginVertical="12dp"
            android:padding="1dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_close_black"
            app:tint="#B1FFFFFF" />
    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>
