<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/fui_transparent"
    android:layout_marginLeft="30dp"
    android:layout_marginRight="30dp"
    android:layout_marginBottom="5dp"
    android:layout_marginTop="5dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_margin="7dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_game_cross" />

    </androidx.cardview.widget.CardView>


    <RelativeLayout
        android:id="@+id/relativeLayoutGame"
        android:layout_width="match_parent"
        android:background="@drawable/ic_game_dialogue_background"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_marginLeft="35dp"
            android:layout_marginTop="40dp"
            android:layout_marginRight="35dp"
            android:layout_marginBottom="40dp"
            android:orientation="vertical"
            android:layout_height="wrap_content">


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/LargeTitleSize"
                android:textColor="#8AFCFD"
                android:shadowDx="0.0"
                android:padding="5dp"
                android:shadowDy="0.0"
                android:shadowRadius="8"
                android:shadowColor="@color/navy_blue"
                android:fontFamily="@font/comfortaa"
                android:text="@string/HowToPlay"
                android:textAlignment="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:textColor="@color/white"
                android:textSize="@dimen/secondary_text_size"
                android:text="@string/only_verified_and_registered"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:textColor="@color/white"
                android:textSize="@dimen/secondary_text_size"
                android:text="@string/one_student_can_get_the_reward_only_once"/>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:textColor="@color/white"
                android:textSize="@dimen/secondary_text_size"
                android:text="@string/student_must_have_an_upi_id_for_payment"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:textColor="@color/white"
                android:textSize="@dimen/secondary_text_size"
                android:text="@string/student_who_uploaded_their"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:textColor="@color/white"
                android:textSize="@dimen/secondary_text_size"
                android:text="@string/students_must_have_the"/>

        </LinearLayout>


    </RelativeLayout>



</RelativeLayout>