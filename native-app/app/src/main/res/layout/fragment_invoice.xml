<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_height="match_parent"
    android:background="@color/grey_300"
    tools:context=".fragments.InvoiceFragment">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="?android:actionBarSize"
        app:cardBackgroundColor="@color/chapter_header"
        app:cardElevation="0dp"
        android:theme="@style/AppTheme.Toolbar"
        tools:ignore="MissingConstraints">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_alignParentBottom="true"
            android:layout_width="match_parent"
            app:titleTextColor="@color/navy_blue"
            app:title="."
            android:layout_marginLeft="-20dp"
            android:background="@drawable/theme_gradient_color"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent">


                <ImageView
                    android:id="@+id/back_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:visibility="gone"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="8dp"
                    android:src="@drawable/ic_baseline_arrow_back_ios_24" />

                <TextView
                    android:id="@+id/subject_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginTop="8dp"
                    android:layout_marginLeft="20dp"
                    android:drawableRight="@drawable/ic_mock_test"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/comfortaa"
                    android:text="@string/invoices"
                    android:textColor="@color/white"
                    android:textSize="@dimen/primary_text_size"
                    android:textStyle="bold" />


            </RelativeLayout>

        </androidx.appcompat.widget.Toolbar>

    </androidx.cardview.widget.CardView>


    <LinearLayout
        android:layout_margin="5dp"
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="wrap_content">

        <com.github.ybq.android.spinkit.SpinKitView
            android:id="@+id/progress_dataLoading"
            style="@style/SpinKitView.FadingCircle"
            android:layout_width="match_parent"
            android:layout_height="25dp"
            android:layout_marginTop="80dp"
            android:layout_centerInParent="true"
            app:SpinKit_Color="#19B0C1" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/invoice_list"
        android:visibility="gone"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    </LinearLayout>



</LinearLayout>