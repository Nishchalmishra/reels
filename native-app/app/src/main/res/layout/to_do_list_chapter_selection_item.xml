<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_parent_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:theme="@style/Theme.MaterialComponents.DayNight.DarkActionBar">

    <LinearLayout
        android:id="@+id/dash_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/top_dash"
            android:layout_width="3dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/verticle_dashed_line"
            android:orientation="horizontal" />

        <androidx.cardview.widget.CardView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="20dp"
            app:cardBackgroundColor="@color/subscription_blue"
            app:cardCornerRadius="12.5dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/subscription_blue"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/chapter_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/correct"
                android:text="01"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:id="@+id/bottom_dash"
            android:layout_width="3dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/verticle_dashed_line"
            android:orientation="horizontal" />

    </LinearLayout>


    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.flexbox.FlexboxLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginVertical="15dp"
                android:layout_weight="1"
                android:paddingEnd="8dp"
                app:alignItems="flex_start"
                app:flexWrap="wrap"
                app:justifyContent="flex_start">

                <TextView
                    android:id="@+id/tv_chapter_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:fontFamily="@font/urbanist_regular"
                    android:maxLines="2"
                    android:text="Chapter"
                    android:textColor="#05040E"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_chapter_marker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/urbanist_regular"
                    android:text=""
                    android:textColor="#999999"
                    android:textSize="13sp" />
            </com.google.android.flexbox.FlexboxLayout>

            <LinearLayout
                android:id="@+id/selection_card_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginVertical="10dp"
                android:layout_marginEnd="5dp"
                android:paddingHorizontal="10dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_selection"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginVertical="2dp"
                    app:cardBackgroundColor="@color/subscription_blue"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/subscription_blue"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:id="@+id/iv_selection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_margin="6dp"
                        android:src="@drawable/correct" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginEnd="18dp"
            android:background="#2E000000"
            android:gravity="center_horizontal"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
