<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/ParentLayout"
    android:theme="@style/Theme.MaterialComponents.DayNight.DarkActionBar"
    tools:context=".activity.MockTestLeaderBoard">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <androidx.cardview.widget.CardView
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        app:cardElevation="10dp"
        android:layout_marginTop="-30dp"
        app:cardCornerRadius="35dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:background="@drawable/main_dashboar_background_graidient"
            android:layout_height="match_parent">




            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="110dp"
                android:layout_marginLeft="100dp"
                android:alpha="0.2"
                android:rotationY="25"
                android:src="@drawable/ic_award_svgrepo_com"/>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="310dp"
                android:layout_marginLeft="128dp"
                android:alpha="0.2"
                android:src="@drawable/ic_award_svgrepo_com"/>





            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="50dp"
                android:layout_marginRight="124dp"
                android:layout_alignParentRight="true"
                android:alpha="0.2"
                android:rotationY="5"
                android:rotationX="-20"
                android:src="@drawable/ic_award_svgrepo_com"/>


            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="90dp"
                android:layout_marginLeft="280dp"
                android:alpha="0.2"
                android:rotationY="25"
                android:src="@drawable/ic_sport_winner_svgrepo_com"/>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="50dp"
                android:layout_marginLeft="180dp"
                android:alpha="0.2"
                android:rotationY="-25"
                android:src="@drawable/ic_sport_winner_svgrepo_com"/>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_margin="30dp"
                android:alpha="0.2"
                android:layout_alignParentBottom="true"
                android:layout_alignParentRight="true"
                android:rotationY="25"
                android:src="@drawable/ic_sport_winner_svgrepo_com"/>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginRight="100dp"
                android:layout_marginBottom="38dp"
                android:alpha="0.2"
                android:layout_alignParentBottom="true"
                android:layout_alignParentRight="true"
                android:rotationY="25"
                android:src="@drawable/ic_award_svgrepo_com"/>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="290dp"
                android:layout_marginLeft="80dp"
                android:alpha="0.2"
                android:rotationY="25"
                android:src="@drawable/ic_sport_winner_svgrepo_com"/>

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="150dp"
                android:layout_marginLeft="250dp"
                android:alpha="0.2"
                android:rotationX="20"
                android:rotationY="25"
                android:src="@drawable/ic_trophy_svgrepo_com"/>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="178dp"
                android:layout_marginLeft="100dp"
                android:alpha="0.2"
                android:rotationX="25"
                android:rotationY="20"
                android:src="@drawable/ic_trophy_svgrepo_com"/>

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="50dp"
                android:layout_marginLeft="40dp"
                android:alpha="0.2"
                android:rotationX="15"
                android:rotationY="25"
                android:src="@drawable/ic_trophy_svgrepo_com"/>

            <ImageView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="85dp"
                android:src="@drawable/ic_first_com" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/firstImageBack"
                android:layout_width="105dp"
                android:layout_height="105dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="130dp"
                android:src="@color/black" />


            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/firstImage"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="130dp"
                android:src="@drawable/avatar" />

            <TextView
                android:id="@+id/firstName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:text="----"
                android:layout_marginTop="8dp"
                android:textColor="@color/black"
                android:textSize="@dimen/primary_text_size"
                android:fontFamily="@font/comfortaa"
                android:layout_below="@id/firstImage"/>

            <TextView
                android:id="@+id/firstPoint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:textStyle="bold"
                android:text=""
                android:layout_marginTop="5dp"
                android:textColor="@color/black"
                android:textSize="@dimen/LargeTitleSize"
                android:fontFamily="@font/comfortaa"
                android:layout_below="@id/firstName"/>

            <TextView
                android:id="@+id/firstTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:textStyle="bold"
                android:text=""
                android:layout_marginTop="5dp"
                android:textColor="@color/black"
                android:textSize="@dimen/tertiary_text_size"
                android:fontFamily="@font/comfortaa"
                android:layout_below="@id/firstPoint"/>

            <LinearLayout
                android:id="@+id/second"
                android:layout_width="110dp"
                android:orientation="vertical"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="110dp"
                    android:textAlignment="center"
                    android:textSize="@dimen/LargeTitleSize"
                    android:fontFamily="@font/poppins_light"
                    android:textColor="@color/white"
                    android:text="2nd"/>

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/secondImage"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:layout_marginLeft="15dp"
                    android:layout_centerVertical="true"
                    android:layout_marginTop="5dp"
                    android:src="@drawable/avatar"/>

                <TextView
                    android:id="@+id/secondName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="---- "
                    android:textAlignment="center"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/black"
                    android:layout_marginLeft="5dp"
                    android:textSize="@dimen/tertiary_text_size"
                    android:fontFamily="@font/comfortaa"
                    android:layout_below="@id/secondImage"/>

                <TextView
                    android:id="@+id/secondPoint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:textStyle="bold"
                    android:text=""
                    android:textAlignment="center"
                    android:layout_marginTop="5dp"
                    android:textColor="@color/black"
                    android:textSize="@dimen/LargeTitleSize"
                    android:fontFamily="@font/comfortaa"
                    android:layout_below="@id/secondName"/>
                <TextView
                    android:id="@+id/secondTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:textStyle="bold"
                    android:text=""
                    android:textAlignment="center"
                    android:layout_marginTop="5dp"
                    android:textColor="@color/black"
                    android:textSize="@dimen/tertiary_text_size"
                    android:fontFamily="@font/comfortaa"
                    android:layout_below="@id/secondPoint"/>

            </LinearLayout>


            <LinearLayout
                android:id="@+id/third"
                android:layout_width="110dp"
                android:orientation="vertical"
                android:layout_alignParentRight="true"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3rd"
                    android:textColor="@color/white"
                    android:textAlignment="center"
                    android:fontFamily="@font/poppins_light"
                    android:layout_marginTop="110dp"
                    android:textSize="@dimen/LargeTitleSize"/>

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/thirdImage"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:layout_marginLeft="15dp"
                    android:layout_centerVertical="true"
                    android:layout_marginTop="5dp"
                    android:src="@drawable/avatar"/>

                <TextView
                    android:id="@+id/thirdName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="----"
                    android:textAlignment="center"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/black"
                    android:layout_marginLeft="5dp"
                    android:textSize="@dimen/tertiary_text_size"
                    android:fontFamily="@font/comfortaa"
                    android:layout_below="@id/thirdImage"/>

                <TextView
                    android:id="@+id/thirdPoint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:textStyle="bold"
                    android:text=""
                    android:textAlignment="center"
                    android:layout_marginTop="5dp"
                    android:textColor="@color/black"
                    android:textSize="@dimen/LargeTitleSize"
                    android:fontFamily="@font/comfortaa"
                    android:layout_below="@id/thirdName"/>

                <TextView
                    android:id="@+id/thirdTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:textStyle="bold"
                    android:text=""
                    android:textAlignment="center"
                    android:layout_marginTop="5dp"
                    android:textColor="@color/black"
                    android:textSize="@dimen/tertiary_text_size"
                    android:fontFamily="@font/comfortaa"
                    android:layout_below="@id/thirdPoint"/>

            </LinearLayout>

            <TextView
                android:id="@+id/name"
                android:layout_marginStart="15dp"
                android:textColor="@color/white"
                android:text="@string/leaderboard"
                android:layout_marginTop="35dp"
                android:textSize="@dimen/LargeTitleSize"
                android:fontFamily="@font/comfortaa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <ImageView

                android:layout_marginTop="43dp"
                android:layout_toRightOf="@id/name"
                android:visibility="visible"
                android:id="@+id/intro_info"
                android:layout_marginStart="15dp"
                android:src="@drawable/ic_baseline_info_24"
                android:layout_width="20dp"
                android:layout_height="20dp"/>


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/weeklyCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp"
                android:layout_marginRight="5dp"
                app:strokeWidth="1dp"
                android:visibility="gone"
                app:strokeColor="@color/navy_blue"
                android:layout_alignParentRight="true"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="@color/fui_transparent"
                app:cardElevation="0dp"
                >

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingLeft="8dp"
                    android:layout_marginRight="8dp">

                    <TextView
                        android:id="@+id/shownData"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/primary_text_size"
                        android:textColor="@color/white"
                        android:fontFamily="@font/poppins_light"
                        android:layout_margin="8dp"
                        android:text="@string/weekly"/>

                    <TextView
                        android:id="@+id/hideData"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@id/shownData"
                        android:textColor="@color/grey_300"
                        android:fontFamily="@font/poppins_light"
                        android:text="@string/daily"
                        android:layout_marginTop="16dp"
                        android:textSize="@dimen/smallest"/>

                </RelativeLayout>


            </com.google.android.material.card.MaterialCardView>


        </RelativeLayout>



    </androidx.cardview.widget.CardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/userPerformaceRecyclerview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:visibility="gone"
        android:layout_below="@+id/card"/>

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_rank"
            android:layout_width="match_parent"
            android:layout_below="@id/card"
            android:layout_marginTop="10dp"
            android:visibility="visible"
            android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                layout="@layout/shimmer_leaderboard_layout"/>
            <include
                layout="@layout/shimmer_leaderboard_layout"/>
            <include
                layout="@layout/shimmer_leaderboard_layout"/>
            <include
                layout="@layout/shimmer_leaderboard_layout"/>


        </LinearLayout>

        </com.facebook.shimmer.ShimmerFrameLayout>


    </RelativeLayout>

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/celebration"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:lottie_rawRes="@raw/celebrationtest1"
        app:lottie_loop="true"
        app:lottie_repeatCount="0"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"/>


    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/celebration2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:lottie_rawRes="@raw/congratulationwritten"
        app:lottie_loop="true"
        app:lottie_repeatCount="0"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"/>



</RelativeLayout>