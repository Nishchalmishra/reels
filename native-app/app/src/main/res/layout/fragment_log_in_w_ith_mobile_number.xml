<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3FFFF"
    tools:context=".fragments.authentication.LogInWIthMobileNumberFragment">

    <!-- Snackbar anchor -->
    <RelativeLayout
        android:id="@+id/ParentRelativeLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <!-- ── Form content ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Phone icon -->
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="18dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                android:src="@drawable/img_phone_number" />

            <!-- Title -->
            <TextView
                android:id="@+id/tv_enter_your_phone_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginBottom="18dp"
                android:fontFamily="@font/urbanist_bold"
                android:text="Please enter your mobile number"
                android:textColor="#121212"
                android:textSize="20sp" />

            <!-- Phone number input -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/number_card"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="18dp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="#FFFFFF"
                android:theme="@style/Theme.MaterialComponents.Light"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#f0f0f0"
                app:strokeWidth="2dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="8dp">

                    <TextView
                        android:id="@+id/texttt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="8dp"
                        android:fontFamily="@font/urbanist_medium"
                        android:text="+91 "
                        android:textColor="#121212"
                        android:textSize="18dp" />

                    <EditText
                        android:id="@+id/number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="12dp"
                        android:layout_toRightOf="@+id/texttt"
                        android:background="@color/white"
                        android:backgroundTint="@color/white"
                        android:digits="0123456789"
                        android:fontFamily="@font/urbanist_medium"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="phone"
                        android:maxLength="10"
                        android:textColor="@color/black"
                        android:textSize="18dp" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Terms & Conditions -->
            <TextView
                android:id="@+id/terms_condition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/urbanist_medium"
                android:paddingHorizontal="20dp"
                android:text="By continuing, I agree to Arivihan's Terms  Condition and Privacy Policies."
                android:textSize="14sp" />

        </LinearLayout>

        <!-- ── Bottom nav: Back + Forward ── -->
        <LinearLayout
            android:id="@+id/ll_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Back → Goal Selection -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btn_back"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_margin="6dp"
                app:cardBackgroundColor="@color/subscription_blue"
                app:cardCornerRadius="25dp"
                app:cardElevation="3dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/previous" />
            </androidx.cardview.widget.CardView>

            <!-- Spacer with loader between buttons -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_gravity="center_vertical">

                <com.github.ybq.android.spinkit.SpinKitView
                    android:id="@+id/progress"
                    style="@style/SpinKitView.FadingCircle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    app:SpinKit_Color="#19B0C1" />
            </FrameLayout>

            <!-- Forward → trigger OTP (disabled until 10 digits) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btn_forward"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_margin="6dp"
                app:cardBackgroundColor="@color/disabled_next_color"
                app:cardCornerRadius="25dp"
                app:cardElevation="3dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/next" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>


</FrameLayout>
