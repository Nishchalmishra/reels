<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="0dp">

    <arivihan.technologies.doubtbuzzter2.customView.gradient.AnimatedBorderView
        android:id="@+id/border_animation"
        android:layout_width="188dp"
        android:layout_height="119dp"
        android:layout_marginHorizontal="7dp"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="7dp"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/main_card"
        android:layout_width="182dp"
        android:layout_height="113dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="10dp"
        android:outlineSpotShadowColor="@color/grey_300"
        app:cardBackgroundColor="@color/color_transparent"
        app:cardCornerRadius="8dp"
        app:cardElevation="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/micro_lecture_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/ai_tutor_resized2" />

            <View
                android:id="@+id/rescheduled_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#66000000"
                android:visibility="gone" />

            <!-- rescheduled badge + date/time pill, stacked & centered -->
            <LinearLayout
                android:id="@+id/rescheduled_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_centerInParent="true">

                <!-- Rescheduled badge -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_rescheduled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="6dp"
                    app:strokeColor="#ffffff"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/medium_text_color"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/urbanist_semi_bold"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="3dp"
                        android:text="@string/rescheduled"
                        android:textColor="@color/btn_enabled_text"
                        android:textSize="11sp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- date & time pill -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_rescheduled_date_and_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:id="@+id/rescheduled_date_and_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp">

                        <TextView
                            android:id="@+id/tv_rescheduled_date_and_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:gravity="center"
                            android:paddingVertical="2dp"
                            android:text="30 Apr"
                            android:textColor="#000000"
                            android:textSize="10sp"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="4dp" />

                        <View
                            android:id="@+id/view_rescheduled_divider"
                            android:layout_width="1dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center_vertical"
                            android:background="#B06836" />

                        <ImageView
                            android:id="@+id/iv_rescheduled_play"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/img_play_blue"
                            android:scaleType="centerCrop"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="0dp" />

                        <TextView
                            android:id="@+id/tv_rescheduled_video_duration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="At 03:00 am"
                            android:textStyle="normal"
                            android:textSize="11sp"
                            android:textColor="#000000"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="2dp"
                            android:layout_gravity="center_vertical" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_margin="3dp"
                android:background="@drawable/today_task_current_item_badge"
                android:paddingHorizontal="6dp">

                <TextView
                    android:id="@+id/task_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/urbanist_semi_bold"
                    android:text="2/6"
                    android:textColor="@color/arivihan_secondary_color"
                    android:textSize="12sp" />
            </RelativeLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/micro_lecture_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:progress="35"
                app:indicatorColor="@color/arivihan_secondary_color"
                app:trackColor="#D9D9D9" />

            <ImageView
                android:id="@+id/completed_status"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentRight="true"
                android:layout_margin="4dp"
                android:visibility="gone"
                android:src="@drawable/today_class_complete_icon" />

            <RelativeLayout
                android:id="@+id/linearlayout"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_alignParentBottom="true"
                android:background="@color/white">

                <androidx.cardview.widget.CardView
                    android:id="@+id/img_live"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginTop="4dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="3dp"
                    app:cardBackgroundColor="#E20000"
                    app:cardCornerRadius="9dp"
                    app:cardElevation="0dp"
                    tools:ignore="RelativeOverlap">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/urbanist_semi_bold"
                        android:gravity="center"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="@string/live"
                        android:textColor="#ffffff"
                        android:textSize="10sp" />
                </androidx.cardview.widget.CardView>


     <!--       date/time pill, stacked & centeredfor today's class-->

                <LinearLayout
                    android:id="@+id/live_date_and_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="11dp"
                    android:layout_marginEnd="2dp">

                    <TextView
                        android:id="@+id/tv_live_date_and_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/urbanist_semi_bold"
                        android:gravity="center"
                        android:paddingVertical="2dp"
                        android:text="Today"
                        android:textColor="#000000"
                        android:textSize="10sp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="4dp"
                        />

                    <View
                        android:id="@+id/view_divider"
                        android:layout_width="1dp"
                        android:layout_height="16dp"
                        android:background="#B3B3B3" />

                    <ImageView
                        android:id="@+id/iv_play"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/img_play_blue"
                        android:scaleType="centerCrop"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="0dp"
                        />

                    <TextView
                        android:id="@+id/tv_video_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1h 32m"
                        android:textStyle="normal"
                        android:textSize="11sp"
                        android:textColor="#000000"
                        android:fontFamily="@font/urbanist_semi_bold"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="2dp"
                        android:layout_gravity="center_vertical"
                        />

                </LinearLayout>

            </RelativeLayout>

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/live_animation"
                android:layout_width="32dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:visibility="gone"
                android:scaleX="1.2"
                android:scaleY="1.2"
                app:lottie_rawRes="@raw/lecture_live_animation"
                app:lottie_loop="true"
                app:lottie_autoPlay="true"
                android:layout_alignParentBottom="true"
                android:layout_alignParentStart="true"
                android:layout_marginHorizontal="4dp" />

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/new_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardBackgroundColor="@color/streak_yellow"
        app:cardCornerRadius="2dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/urbanist_semi_bold"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp"
            android:text="@string/New"
            android:textColor="@color/black"
            android:textSize="10sp" />
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>