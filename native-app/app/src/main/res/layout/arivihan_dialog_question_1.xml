<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    app:cardCornerRadius="15dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:layout_margin="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
<RelativeLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/round">


    <Button
        android:id="@+id/skip"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center_vertical"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/infobutton"
        android:fontFamily="baskerville"
        android:gravity="center"
        android:paddingBottom="4dp"
        android:text="&#10006;"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textColor="#fff"
        android:textSize="14dp" />


    <RelativeLayout
        android:id="@+id/rv"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="@color/streak_yellow"
        android:paddingStart="15dp"
        android:paddingTop="5dp"
        android:paddingEnd="5dp">


        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie"
            android:layout_height="160dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="50dp"
            android:layout_alignParentTop="true"
            android:layout_centerInParent="true"
            android:layout_width="wrap_content"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />

        <ScrollView
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="20dp"
            android:layout_marginTop="10dp"
            android:layout_width="wrap_content"
            android:layout_height="120dp">


        <TextView
            android:layout_gravity="center"
            android:textAlignment="center"
            android:textSize="16sp"
            android:id="@+id/text_dialog"
            android:textColor="@color/black"
            style="@style/whiteBolText"
            android:fontFamily="@font/opensans_bold"
            android:text="@string/dummy_lecture_description"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        </ScrollView>


    </RelativeLayout>


    <LinearLayout
        android:layout_marginTop="20dp"
        android:layout_below="@+id/rv"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:layout_centerHorizontal="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btn_dialog_no"
            android:layout_marginEnd="15dp"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:background="@drawable/sign_in_button"
            android:padding="10dp"
            android:text="@string/yes"
            android:textColor="#ffffffff" />

        <Button
            android:id="@+id/btn_dialog_yes"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:background="@drawable/sign_in_button"
            android:padding="10dp"
            android:text="@string/no"
            android:textColor="#ffffffff" />

    </LinearLayout>



</RelativeLayout>
</androidx.cardview.widget.CardView>