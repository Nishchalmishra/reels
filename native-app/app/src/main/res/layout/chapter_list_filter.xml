<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">


    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:layout_marginVertical="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/back_arrow"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="23dp"
            android:paddingEnd="17dp">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="15dp"
                android:src="@drawable/arrow_icon"
                android:layout_marginTop="1dp"/>
        </LinearLayout>


        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="@font/urbanist_semi_bold"
            android:text="@string/Filter"
            android:textColor="@color/black"
            android:textSize="22sp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintVertical_weight="1"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        android:layout_marginVertical="20dp"
        app:layout_constraintBottom_toTopOf="@id/Apply_Filter_Card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
    <TextView
        android:id="@+id/category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/category"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:fontFamily="@font/urbanist_bold"
        android:layout_marginStart="30dp"/>

            <CheckBox
                android:id="@+id/filter_ALL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/urbanist_medium"
                android:scaleX="0.95"
                android:scaleY="0.95"
                android:text="@string/all"
                android:textSize="16sp"
                android:layout_marginStart="23dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="5dp"
                android:background="@color/mock_light_grey" />

            <CheckBox
                android:id="@+id/filter_syllabus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/urbanist_medium"
                android:scaleX="0.95"
                android:scaleY="0.95"
                android:text="@string/syllabus"
                android:textSize="16sp"
                android:layout_marginStart="23dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="5dp"
                android:background="@color/mock_light_grey" />

            <CheckBox
                android:id="@+id/filter_solved_papers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/urbanist_medium"
                android:scaleX="0.95"
                android:scaleY="0.95"
                android:text="@string/solved_papers"
                android:textSize="16sp"
                android:layout_marginHorizontal="23dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="5dp"
                android:background="@color/mock_light_grey" />


    <TextView
        android:id="@+id/other"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/other"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:fontFamily="@font/urbanist_bold"
        android:layout_marginStart="30dp" />

    <CheckBox
        android:id="@+id/clear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/other"
        android:layout_marginEnd="20dp"
        android:fontFamily="@font/urbanist_medium"
        android:text="@string/ClearFilter"
        android:textSize="16sp"
        android:scaleX="0.95"
        android:scaleY="0.95"
        android:layout_marginStart="23dp"
        android:layout_marginTop="10dp"/>

        </LinearLayout>


    </ScrollView>

    <androidx.cardview.widget.CardView
        android:id="@+id/Apply_Filter_Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="0dp"
        app:cardCornerRadius="8dp"
        android:layout_marginBottom="30dp"
        android:layout_marginHorizontal="30dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:backgroundTint="@color/mock_primary_color">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:background="@color/mock_primary_color"
            android:fontFamily="@font/nunito_semibold"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:text="@string/apply"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:gravity="center"/>

    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>