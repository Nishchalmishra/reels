<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#F3F6F8">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp">

        <ImageView
            android:id="@+id/close_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:src="@drawable/search_close_btn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/close_btn">


            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/animation"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:visibility="visible"
                app:lottie_rawRes="@raw/info_animation"/>

            <ImageView
                android:id="@+id/selection_image"
                android:layout_width="150dp"
                android:layout_height="160dp"
                android:src="@drawable/selection_image"
                android:visibility="gone" />

            <TextView
                android:id="@+id/info_dialog_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="5dp"
                android:fontFamily="@font/urbanist_regular"
                android:gravity="start"
                android:text="@string/dialog_info_text"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:layout_marginTop="-10dp"/>

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/urbanist_bold"
                android:text="@string/info_dialog_subtitle"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:gravity="start"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="30dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_No"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="#D3F8FA"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="15dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/urbanist_semi_bold"
                        android:gravity="center"
                        android:paddingVertical="6dp"
                        android:text="@string/No"
                        android:textColor="#26C6DA"
                        android:textSize="13sp" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_Yes"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="#26C6DA"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="15dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/urbanist_semi_bold"
                        android:gravity="center"
                        android:paddingVertical="6dp"
                        android:text="@string/Yes"
                        android:textColor="@color/white"
                        android:textSize="13sp" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>