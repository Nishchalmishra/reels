<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="7dp"
    app:cardCornerRadius="8dp"
    android:id="@+id/cv_parent"
    android:theme="@style/Theme.MaterialComponents.DayNight.DarkActionBar">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/subject_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/magnetism"
            android:layout_marginVertical="18dp"
            android:layout_marginStart="15dp"/>

        <TextView
            android:id="@+id/subject_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_weight="1"
            android:fontFamily="@font/urbanist_medium"
            android:text="Physics"
            android:textColor="#191919"
            android:textSize="19sp" />

        <LinearLayout
            android:id="@+id/selection_card_layout"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingHorizontal="10dp"
            android:layout_marginVertical="10dp"
            android:layout_marginEnd="5dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/selection_card"
                android:layout_width="20dp"
                android:layout_height="20dp"
                app:cardBackgroundColor="@color/subscription_blue"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                android:layout_gravity="center_vertical"
                app:strokeColor="@color/subscription_blue"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="4dp"
                    android:src="@drawable/correct" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>