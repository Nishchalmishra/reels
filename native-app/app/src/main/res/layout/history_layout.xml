<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Theme.MaterialComponents.Light"
    android:layout_margin="10dp"
    android:background="@color/white"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        app:cardBackgroundColor="@color/white"
        android:background="@color/white"
        app:strokeWidth="1dp"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <com.google.android.material.card.MaterialCardView
                android:layout_marginTop="20dp"
                app:cardCornerRadius="5dp"
                android:id="@+id/pos"
                app:cardBackgroundColor="@color/navy_blue"
                android:layout_width="38dp"
                android:layout_height="38dp">

                <TextView
                    android:id="@+id/position"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:textSize="@dimen/secondary_text_size"
                    android:layout_gravity="center"
                    android:text="1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_marginBottom="5dp"
                android:paddingEnd="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:id="@+id/syllabus"
                android:textColor="@color/navy_blue"
                android:textStyle="bold"
                style="@style/tertiaryText"
                android:text="@string/syllabus"
                />


            <LinearLayout
                android:layout_below="@id/syllabus"
                android:layout_margin="5dp"
                android:id="@+id/l1"
                android:layout_marginStart="20dp"
                android:layout_toEndOf="@id/pos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:gravity="center"
                    android:id="@+id/score"
                    android:textStyle="bold"
                    style="@style/primaryText"
                    android:text="300"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>


                <TextView
                    android:gravity="center"
                    android:id="@+id/timeTaken"
                    style="@style/secondaryText"
                    android:text="300"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:gravity="center"
                    android:id="@+id/date"
                    style="@style/secondaryText"
                    android:text="300"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>


            </LinearLayout>

            <LinearLayout
                android:id="@+id/l2"
                android:layout_margin="5dp"
                android:layout_below="@+id/l1"
                android:layout_marginStart="20dp"
                android:layout_toEndOf="@id/pos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:gravity="center"
                    android:layout_margin="5dp"
                    android:id="@+id/instruction"
                    android:textColor="@color/purple_card"
                    android:textStyle="bold"
                    style="@style/tertiaryText"
                    android:text="@string/instructions"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>


                <TextView
                    android:gravity="center"
                    android:layout_margin="5dp"
                    android:id="@+id/leaderboard"
                    android:textStyle="bold"
                    android:textColor="@color/purple_card"
                    style="@style/tertiaryText"
                    android:text="@string/leaderboard"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:gravity="center"
                    android:layout_margin="5dp"
                    android:id="@+id/review"
                    android:textStyle="bold"
                    android:textColor="@color/purple_card"
                    style="@style/tertiaryText"
                    android:text="@string/review"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>


            </LinearLayout>

            <View
                android:layout_marginTop="10dp"
                android:background="@color/grey_300"
                android:layout_below="@id/l2"
                android:layout_width="match_parent"
                android:layout_height="2dp"/>

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>


</LinearLayout>