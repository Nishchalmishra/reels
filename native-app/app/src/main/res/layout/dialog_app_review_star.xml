<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="5dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="24dp">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/urbanist_bold"
                    android:gravity="center"
                    android:text="@string/apna_feedback_dein"
                    android:textColor="@color/black"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tv_sub_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="8dp"
                    android:fontFamily="@font/urbanist_medium"
                    android:text="@string/aapko_lecture_kesa_laga"
                    android:textAlignment="center"
                    android:textColor="#696969"
                    android:textIsSelectable="true"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_star1"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_teal_star_outline"
                        app:tint="@color/arivihan_secondary_color" />

                    <ImageView
                        android:id="@+id/iv_star2"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_teal_star_outline"
                        app:tint="@color/arivihan_secondary_color" />

                    <ImageView
                        android:id="@+id/iv_star3"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_teal_star_outline"
                        app:tint="@color/arivihan_secondary_color" />

                    <ImageView
                        android:id="@+id/iv_star4"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_teal_star_outline"
                        app:tint="@color/arivihan_secondary_color" />

                    <ImageView
                        android:id="@+id/iv_star5"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_teal_star_outline"
                        app:tint="@color/arivihan_secondary_color" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_primary_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="8dp"
                    android:fontFamily="@font/urbanist_semi_bold"
                    android:text="@string/lecture_me_kya_pasand_aaya"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_feedback_options"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="14dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    android:visibility="visible"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager" />


                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#EEEEEE"
                    app:strokeWidth="2dp">

                    <EditText
                        android:id="@+id/et_feedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:fontFamily="@font/urbanist_medium"
                        android:gravity="top"
                        android:hint="@string/type_karein"
                        android:minLines="7"
                        android:maxHeight="200dp"
                        android:scrollbars="vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="12dp"
                        android:text=""
                        android:textColor="@color/black"
                        android:textColorHint="@color/mock_grey"
                        android:textSize="@dimen/primary_text_size" />

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cv_secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginHorizontal="12dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#E9FBFC"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:contentPaddingBottom="10dp"
                        app:contentPaddingLeft="16dp"
                        app:contentPaddingRight="16dp"
                        app:contentPaddingTop="10dp">

                        <TextView
                            android:id="@+id/tv_secondary_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginLeft="8dp"
                            android:layout_marginRight="8dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:maxLines="1"
                            android:text="@string/skip"
                            android:textAlignment="center"
                            android:textColor="@color/arivihan_secondary_color"
                            android:textSize="17sp" />

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cv_primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginHorizontal="12dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/arivihan_secondary_color"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:contentPaddingBottom="10dp"
                        app:contentPaddingLeft="16dp"
                        app:contentPaddingRight="16dp"
                        app:contentPaddingTop="10dp">

                        <TextView
                            android:id="@+id/tv_primary_btn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginLeft="8dp"
                            android:layout_marginRight="8dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:maxLines="1"
                            android:text="@string/Submit"
                            android:textAlignment="center"
                            android:textColor="@color/white"
                            android:textSize="17sp" />

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginHorizontal="8dp"
            android:layout_marginVertical="8dp"
            android:padding="4dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_close_black"
            app:tint="@color/black" />
    </RelativeLayout>


</androidx.cardview.widget.CardView>