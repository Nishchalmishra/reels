<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dual_radial_blur"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:layout_above="@id/ll_bottom"
        android:layout_alignParentTop="true"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/topRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:layout_marginTop="56dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/topLeftImage"
                    android:layout_width="113dp"
                    android:layout_height="120dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/well_done_image" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/bubbleTail"
                        android:layout_width="12dp"
                        android:layout_height="21dp"
                        android:elevation="2dp"
                        android:layout_marginTop="14dp"
                        android:src="@drawable/bubble_tail" />

                    <TextView
                        android:id="@+id/topText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-1.75dp"
                        android:padding="12dp"
                        android:elevation="1dp"
                        android:fontFamily="@font/urbanist_medium"
                        android:text="Aapne 1 free chapter unlock kar liya hain, ab iske sath aur bhi chapters ko strong banaiye."
                        android:textSize="16sp"
                        android:textColor="#000000"
                        android:background="@drawable/bubble_speech" />

                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/dropperLineText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/urbanist_bold"
                android:text="Dropper se doctor banne ka sapna poora karein Dr’s Batch ke saath!"
                android:textSize="20sp"
                android:textColor="@android:color/black"
                app:layout_constraintTop_toBottomOf="@id/topRow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/dropperLineText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:maxHeight="100dp"
                >
                <ImageView
                    android:id="@+id/middleImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:src="@drawable/benefits"
                    android:layout_marginHorizontal="8dp"
                    />

            </RelativeLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/ll_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:layout_alignParentBottom="true">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/unlockCard"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:cardElevation="0dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#26C6DA">

            <TextView
                android:id="@+id/unlock_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/urbanist_extra_bold"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="JOIN Dr’s BATCH"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="normal" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/skipCard"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/color_transparent">

            <TextView
                android:id="@+id/skipText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/urbanist_semi_bold"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="Skip for now"
                android:textColor="@color/arivihan_secondary_color"
                android:textSize="16sp"
                android:textStyle="normal" />
        </com.google.android.material.card.MaterialCardView>


    </LinearLayout>

</RelativeLayout>
