<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardUseCompatPadding="true"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="5dp"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="5dp"
    android:layout_marginStart="5dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="0dp">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imageview"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:contentDescription="@string/dummy_description"
                android:scaleType="fitXY"
                android:src="@drawable/loading_pseudolive" />
        </RelativeLayout>



        <LinearLayout
            android:gravity="left|center_vertical"
            android:id="@+id/linearlayoutlike"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            tools:ignore="RtlHardcoded,UseCompoundDrawables">
            <LinearLayout
                android:id="@+id/like_linear_layout"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingLeft="8dp"

                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="45dp">

                <ToggleButton
                    android:id="@+id/like_button"
                    android:layout_marginEnd="5dp"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:textOn=""
                    android:textOff=""
                    android:clickable="false"
                    android:background="@drawable/like_toggle_button"
                    android:layout_gravity="center"
                    android:layout_width="35dp"
                    android:layout_height="30dp"
                    />

                <TextView
                    android:layout_marginEnd="5dp"
                    android:layout_gravity="center"
                    android:fontFamily="@font/opensans_regular"
                    android:id="@+id/textviewlikes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/greyBoldText"
                    android:textAlignment="center"
                    android:text="@string/_16_likes"
                    android:textSize="14sp"
                    />
            </LinearLayout>


            <ImageView
                android:layout_marginStart="0dp"
                android:id="@+id/view"
                android:layout_width="35dp"
                android:layout_height="30dp"
                android:layout_marginEnd="5dp"
                android:src="@drawable/ic_baseline_view_24"
                android:contentDescription="@string/dummy_description" />


            <TextView
                android:id="@+id/views"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/opensans_regular"
                style="@style/greyBoldText"
                android:textAlignment="center"
                android:text="@string/_16_views"
                android:textSize="14sp"
                />
        </LinearLayout>

        <View
            android:layout_marginBottom="2dp"
            android:layout_width="match_parent"
            android:layout_height="1.5dp"/>

        <TextView
            android:layout_marginEnd="10dp"
            android:layout_marginStart="10dp"
            android:id="@+id/textview1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/arivihan_primary_color"
            android:text="@string/moment_of_inertia_for_complex_objects"
            android:textSize="16sp"
            android:textStyle="bold">

        </TextView>

        <TextView
            android:layout_marginEnd="10dp"
            android:textColor="@color/black"
            android:layout_marginStart="10dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="10dp"
            style="@style/primaryText"
            android:textSize="16sp"
            android:id="@+id/textview2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dummy_lecture_description"
            >

        </TextView>

    </LinearLayout>


</androidx.cardview.widget.CardView>