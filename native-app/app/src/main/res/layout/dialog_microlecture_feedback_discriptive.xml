<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_dialog_parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="60dp"
        android:layout_gravity="center"
        android:orientation="vertical"
        app:cardCornerRadius="15dp"
        app:cardElevation="2dp"
        android:layout_centerInParent="true"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:scrollbars="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="18dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RelativeLayout
                            android:id="@+id/rl_like_background"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:layout_gravity="center">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_like_background"
                                android:layout_width="70dp"
                                android:layout_height="70dp"
                                android:layout_centerInParent="true"
                                app:cardBackgroundColor="#E9FBFC"
                                app:cardCornerRadius="80dp"
                                app:cardElevation="0dp"/>

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/lottie_feedback_like"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:layout_centerInParent="true"
                                android:layout_gravity="center"
                                android:scaleX="1.3"
                                android:scaleY="1.3"
                                app:lottie_autoPlay="true"
                                app:lottie_loop="true"
                                app:lottie_rawRes="@raw/feedback_like" />

                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/rl_dislike_background"
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:layout_gravity="center">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_dislike_background"
                                android:layout_width="70dp"
                                android:layout_height="70dp"
                                android:layout_centerInParent="true"
                                app:cardBackgroundColor="#FFE1E5"
                                app:cardCornerRadius="80dp"
                                app:cardElevation="0dp"/>

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/lottie_feedback_dislike"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:layout_centerHorizontal="true"
                                android:layout_gravity="center"
                                android:layout_marginTop="12dp"
                                android:scaleX="1.3"
                                android:scaleY="1.3"
                                app:lottie_autoPlay="true"
                                app:lottie_loop="true"
                                app:lottie_rawRes="@raw/feedback_dislike" />

                        </RelativeLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/urbanist_bold"
                        android:gravity="center"
                        android:text="@string/well_done"
                        android:textColor="@color/black"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/tv_sub_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginLeft="8dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginRight="8dp"
                        android:fontFamily="@font/urbanist_medium"
                        android:text="@string/aapko_lecture_kesa_laga"
                        android:textAlignment="center"
                        android:textIsSelectable="true"
                        android:textSize="14sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_feedback_options"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:layout_marginTop="14dp"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:scrollbars="none"
                        android:visibility="visible"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#EEEEEE"
                        app:strokeWidth="2dp">

                        <EditText
                            android:id="@+id/et_feedback"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/white"
                            android:fontFamily="@font/urbanist_medium"
                            android:hint="@string/apna_feedback_likhein"
                            android:paddingHorizontal="20dp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/mock_grey"
                            android:textSize="@dimen/primary_text_size" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginHorizontal="32dp"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:orientation="vertical">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_secondary"
                                android:layout_width="200dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                app:cardBackgroundColor="#E9FBFC"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="0dp"
                                app:contentPaddingBottom="10dp"
                                app:contentPaddingLeft="16dp"
                                app:contentPaddingRight="16dp"
                                app:contentPaddingTop="10dp">

                                <TextView
                                    android:id="@+id/tv_secondary_btn"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_marginLeft="8dp"
                                    android:layout_marginRight="8dp"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/urbanist_semi_bold"
                                    android:maxLines="1"
                                    android:text="@string/resume_lecture"
                                    android:textAlignment="center"
                                    android:textColor="@color/arivihan_secondary_color"
                                    android:textSize="17sp" />

                            </androidx.cardview.widget.CardView>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:orientation="vertical">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_primary"
                                android:layout_width="200dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                app:cardBackgroundColor="@color/arivihan_secondary_color"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="0dp"
                                app:contentPaddingBottom="10dp"
                                app:contentPaddingLeft="16dp"
                                app:contentPaddingRight="16dp"
                                app:contentPaddingTop="10dp">

                                <TextView
                                    android:id="@+id/tv_primary_btn"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_marginLeft="8dp"
                                    android:layout_marginRight="8dp"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/urbanist_semi_bold"
                                    android:maxLines="1"
                                    android:text="@string/Submit"
                                    android:textAlignment="center"
                                    android:textColor="@color/white"
                                    android:textSize="17sp" />

                            </androidx.cardview.widget.CardView>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <ImageView
                android:id="@+id/iv_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_margin="12dp"
                android:padding="6dp"
                android:src="@drawable/close"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#191919" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</RelativeLayout>