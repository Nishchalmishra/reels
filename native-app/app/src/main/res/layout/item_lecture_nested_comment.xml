<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/rl_parent"
    android:background="@color/white"
    android:orientation="vertical"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="15dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/color_transparent"
        android:layout_margin="4dp"
        >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="8dp"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_profile"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    app:cardBackgroundColor="@color/color_transparent"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="21dp"
                    app:strokeColor="@color/gray_e6"
                    app:strokeWidth="0.8dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginEnd="12dp"
                    >

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        >

                        <ImageView
                            android:id="@+id/iv_profile_img"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:scaleType="fitCenter"
                            android:padding="4dp"
                            android:src="@drawable/magiclogo_min"
                            />

                    </RelativeLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1E25C6DA"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#C2EFF5"
                    android:layout_gravity="center_vertical"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginEnd="2dp"
                        android:layout_marginBottom="6dp"
                        >

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardElevation="0dp"
                            app:cardCornerRadius="8dp"
                            app:cardBackgroundColor="@color/white"
                            android:layout_marginHorizontal="12dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="4dp"
                            >
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="36dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                >
                                <View
                                    android:layout_width="5dp"
                                    android:layout_height="wrap_content"
                                    android:background="@color/arivihan_secondary_color"
                                    />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:layout_gravity="center_vertical"
                                    android:paddingHorizontal="6dp"
                                    android:layout_marginBottom="0dp"
                                    android:layout_marginTop="0dp"
                                    >
                                    <TextView
                                        android:id="@+id/tv_user_name"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/urbanist_bold"
                                        android:text="User"
                                        android:textAllCaps="false"
                                        android:textColor="#70747E"
                                        android:textSize="11sp"
                                        android:textStyle="normal"
                                        android:maxLines="1"
                                        android:ellipsize="end"
                                        android:layout_gravity="center_vertical"
                                        />
                                    <TextView
                                        android:id="@+id/tv_user_comment"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/urbanist_medium"
                                        android:text="comment"
                                        android:textAllCaps="false"
                                        android:textColor="@color/black"
                                        android:textSize="12sp"
                                        android:textStyle="normal"
                                        android:maxLines="1"
                                        android:ellipsize="end"
                                        android:layout_gravity="center_vertical"
                                        />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                        <TextView
                            android:id="@+id/tv_comment_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:text="text here..."
                            android:textAllCaps="false"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            android:textStyle="normal"
                            android:layout_gravity="center_vertical"
                            android:layout_marginHorizontal="14dp"
                            />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>