<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Theme.MaterialComponents.DayNight.DarkActionBar"
    android:layout_marginTop="2dp">

    <LinearLayout
        android:id="@+id/dash_view"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

    <LinearLayout
        android:id="@+id/top_dash"
        android:layout_width="3dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/verticle_dashed_line"
        android:orientation="horizontal"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/dot_view"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:backgroundTint="@color/subscription_blue"
        app:cardCornerRadius="4dp"
        app:cardElevation="0dp"
        android:visibility="visible"
        android:layout_marginHorizontal="3dp"/>

        <ImageView
            android:id="@+id/trophy_icon"
            android:layout_width="12.5dp"
            android:layout_height="18dp"
            android:src="@drawable/trophy_icon"
            android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/bottom_dash"
        android:layout_width="3dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/verticle_dashed_line"
        android:orientation="horizontal"/>

    </LinearLayout>

    <TextView
        android:id="@+id/feature_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/dash_view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:text="Live doubt solving"
        android:textSize="12sp"
        android:fontFamily="@font/urbanist_medium"
        android:textColor="@color/black"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="4dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>