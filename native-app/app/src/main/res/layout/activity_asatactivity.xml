<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rl_main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/to_do_step_abstract_background"
    tools:context=".activity.ToDoListSteps">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <include layout="@layout/shimmer_asat_screen" />

    </com.facebook.shimmer.ShimmerFrameLayout>

    <RelativeLayout
        android:id="@+id/rl_parent_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/ll_bottom_layout"
            android:layout_alignParentTop="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/to_do_step_abstract_background"
                android:orientation="vertical">

                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/fragment_container_view_video"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout="@layout/fragment_a_s_a_t_video"
                    android:visibility="visible" />

                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/fragment_container_view_top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout="@layout/fragment_a_s_a_t_top"
                    android:visibility="visible" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:background="@color/white" />

                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/fragment_container_view_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout="@layout/fragment_a_s_a_t_bottom"
                    android:visibility="visible" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/ll_bottom_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="end"
            android:elevation="10dp"
            android:background="@drawable/card_shadow_upward"
            android:orientation="vertical"
            android:visibility="visible">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_main_screen_bottom_control"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:id="@+id/ll_main_screen_bottom_control"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="horizontal"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="20dp"
                    android:weightSum="2">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cv_take_test"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_gravity="start"
                        android:layout_marginEnd="16dp"
                        android:layout_weight="1"
                        android:visibility="visible"
                        app:cardBackgroundColor="#D3F8FA"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/tv_take_test"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:text="@string/Take_Test"
                            android:textColor="@color/subscription_blue"
                            android:textSize="16sp"
                            android:textStyle="normal" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cv_upload_result"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:visibility="visible"
                        app:cardBackgroundColor="@color/subscription_blue"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/tv_upload_result"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:text="@string/Upload_Result"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="normal" />
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_result_screen_bottom_control"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:id="@+id/ll_result_screen_bottom_control"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/ll_expiry_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:ellipsize="end"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:singleLine="true"
                            android:text="@string/Offer_Expires_in"
                            android:textColor="@color/black"
                            android:textSize="11sp" />

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="1dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_clock_timeout_expiry_blue" />

                        <TextView
                            android:id="@+id/tv_expiry_timer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/urbanist_medium"
                            android:singleLine="true"
                            android:text="00:00:00"
                            android:textColor="#26C6DA"
                            android:textSize="11sp" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="11dp"
                            android:layout_gravity="center_vertical"
                            android:background="@color/black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="0dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:singleLine="true"
                            android:text="@string/Join_Now"
                            android:textColor="#26C6DA"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:ellipsize="end"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:singleLine="true"
                            android:text="!"
                            android:textColor="#26C6DA"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_discount_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/yellow_gradient_5"
                        android:gravity="center"
                        android:visibility="visible">

                        <TextView
                            android:id="@+id/tv_discount_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/urbanist_medium"
                            android:singleLine="true"
                            android:text="@string/Discount_ARIVIHAN_Coupon_code_applied"
                            android:textColor="@color/black"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:weightSum="10">

                        <LinearLayout
                            android:id="@+id/final_price_layout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="6"
                            android:ellipsize="end"
                            android:orientation="vertical"
                            android:paddingStart="0dp"
                            android:paddingEnd="12dp"
                            android:visibility="visible">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tv_cost_price"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="10dp"
                                    android:fontFamily="@font/urbanist_medium"
                                    android:text="3999"
                                    android:textColor="@color/black"
                                    android:textSize="10sp"
                                    android:visibility="visible" />

                                <TextView
                                    android:id="@+id/tv_discount_price"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/urbanist_semi_bold"
                                    android:text="2999"
                                    android:textColor="@color/subscription_blue"
                                    android:textSize="16sp" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/tv_subscription_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:ellipsize="end"
                                android:fontFamily="@font/urbanist_medium"
                                android:maxLines="2"
                                android:text="Unnati Batch for Boards (6 Months)"
                                android:textColor="#757575"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cv_join_now"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="4"
                            app:cardBackgroundColor="#26C6DA"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:ellipsize="end"
                                android:fontFamily="@font/urbanist_semi_bold"
                                android:singleLine="true"
                                android:text="@string/Join_Now"
                                android:textColor="@color/white"
                                android:textSize="16sp" />

                        </androidx.cardview.widget.CardView>


                    </LinearLayout>
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/confetti1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitXY"
                app:lottie_rawRes="@raw/confetti" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/confetti2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitXY"
                app:lottie_rawRes="@raw/confetti" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/confetti3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitXY"
                app:lottie_rawRes="@raw/confetti" />

        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>
