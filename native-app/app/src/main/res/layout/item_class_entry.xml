<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutClassEntry"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#ffffff"
    android:paddingVertical="10dp"
    android:gravity="center_vertical">

    <!-- Class info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginHorizontal="10dp"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvClassName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:fontFamily="@font/urbanist_semi_bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <View
                android:id="@+id/dotStatus"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/circle_dot"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvTimeSlot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#B2000000"
                android:fontFamily="@font/urbanist_regular"/>
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/cvSubject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/tvSubject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp"
                android:textSize="11sp"
                android:textColor="@color/black"
                android:fontFamily="@font/urbanist_medium" />

        </androidx.cardview.widget.CardView>

        <!-- ─── RESCHEDULED ROW ──────────────────────────────────────────
             Shown only when session.isRescheduled() == true.
             Contains: orange "Rescheduled" chip  +  gray date/time pill.
             Hidden by default; toggled in TimeTableAdapter.bindSession().
        ─────────────────────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/layoutRescheduled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- "⇄ Rescheduled" chip -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:strokeColor="#d6b49b"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <ImageView
                        android:id="@+id/ivRescheduledIcon"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="5dp"
                        android:src="@drawable/resceduled_class_icon" />

                    <TextView
                        android:id="@+id/tvRescheduledTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rescheduled"
                        android:textColor="#B06836"
                        android:textSize="11sp"
                        android:fontFamily="@font/urbanist_bold" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- "30 Apr | 03:00 AM" pill -->
            <!-- "30 Apr | 03:00 AM" pill — white bg, gray stroke, split text colors -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#DADADA"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <!-- "30 Apr" — bold black -->
                    <TextView
                        android:id="@+id/tvRescheduledDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#1A1A1A"
                        android:textSize="11sp"
                        android:fontFamily="@font/urbanist_bold" />

                    <!-- "|" — orange separator -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:text="|"
                        android:textColor="#BF6020"
                        android:textSize="11sp"
                        android:fontFamily="@font/urbanist_bold" />

                    <!-- "03:00 AM" — gray -->
                    <TextView
                        android:id="@+id/tvRescheduledTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#919191"
                        android:textSize="11sp"
                        android:fontFamily="@font/urbanist_medium" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
        <!-- ─── END RESCHEDULED ROW ──────────────────────────────────── -->

    </LinearLayout>

    <!-- Teacher card + status overlays -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:id="@+id/layoutTeacherSection"
        android:clipChildren="false"
        android:clipToPadding="false">

        <androidx.cardview.widget.CardView
            android:layout_width="70dp"
            android:layout_height="80dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            android:layout_margin="4dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <View
                    android:id="@+id/viewTeacherBg"
                    android:layout_width="match_parent"
                    android:background="#E6F1ED"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/ivTeacher"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:padding="0dp"
                    android:src="@drawable/teacher_icon" />

            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- RECORDED: play button -->
        <ImageView
            android:id="@+id/ivPlay"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom|start"
            android:translationX="-4dp"
            android:translationY="4dp"
            android:src="@drawable/play_icon"
            android:padding="6dp"
            android:elevation="8dp" />

        <!-- LIVE: lottie animation -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/dialog_animation"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|start"
            android:translationX="-6dp"
            android:translationY="6dp"
            android:elevation="8dp"
            android:visibility="gone"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/lecture_live_animation" />

        <!-- LOCKED: lock icon -->
        <ImageView
            android:id="@+id/ivLock"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="bottom|start"
            android:translationX="-6dp"
            android:translationY="6dp"
            android:visibility="gone"
            android:src="@drawable/ic_lock"
            android:padding="6dp"
            android:elevation="8dp" />

        <!-- UPCOMING: badge -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_upcoming"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:strokeWidth="2dp"
            android:visibility="gone"
            android:layout_gravity="bottom|center_horizontal"
            app:strokeColor="#ffffff"
            android:textSize="13sp"
            android:translationX="-14dp"
            android:layout_marginBottom="3dp"
            app:cardBackgroundColor="@color/streak_yellow"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/urbanist_bold"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/black"
                android:text="@string/upcoming"
                android:textSize="11sp" />

        </com.google.android.material.card.MaterialCardView>


        <!-- PENDING: badge -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_missed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:strokeWidth="2dp"
            android:layout_gravity="bottom|center_horizontal"
            app:strokeColor="#ffffff"
            android:translationX="-14dp"
            android:visibility="gone"
            android:layout_marginBottom="3dp"
            app:cardBackgroundColor="#696866"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/urbanist_bold"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:text="@string/pending"
                    android:textSize="11sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</LinearLayout>