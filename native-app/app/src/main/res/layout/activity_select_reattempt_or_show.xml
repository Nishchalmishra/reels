<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/navy_blue"
                android:paddingStart="30dp"
                android:paddingVertical="5dp">
                <TextView
                    android:id="@+id/select_photo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:text="@string/choose_action"
                    android:fontFamily="@font/nunito_regular"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="5dp"/>

                <ImageView
                    android:id="@+id/cross"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    android:src="@drawable/__icon__close_"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="3dp"
                    android:background="@color/navy_blue"
                    android:scaleType="fitXY"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/attempt"
                android:paddingEnd="20dp"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:src="@drawable/__icon__gallery_"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">


                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/writing"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/attempt"
                    app:layout_constraintLeft_toRightOf="@id/camera_Image"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginStart="13dp"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:fontFamily="@font/nunito_regular" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/grey_400"
                android:layout_marginHorizontal="10dp"/>

            <LinearLayout
                android:paddingEnd="20dp"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:id="@+id/see_solution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="10dp">


                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/camera_Image"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/clipboard"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/see_solution"
                    app:layout_constraintLeft_toRightOf="@id/camera_Image"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginStart="13dp"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:fontFamily="@font/nunito_regular" />

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>


</LinearLayout>