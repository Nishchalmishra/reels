<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:id="@+id/parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:id="@+id/back_button_layout"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:id="@+id/iv_back"
                    android:layout_width="13dp"
                    android:layout_height="15dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/arrow_icon" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginHorizontal="4dp">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/urbanist_semi_bold"
                    android:text="@string/settings"
                    android:textColor="@color/black"
                    android:textSize="@dimen/toolbar_title_size" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_my_download"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_marginVertical="6dp"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@drawable/border_shadow"
            android:visibility="visible"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="8dp"
            >
            <androidx.cardview.widget.CardView
                android:id="@+id/card_clear_cache"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:id="@+id/iv_clear_cache_icon"
                        android:layout_width="20dp"
                        android:layout_marginTop="3dp"
                        android:layout_height="21dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/delete" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_clear_cache_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Clear App Cache"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:textColor="#1D1D1D"
                            android:textSize="18sp"
                            android:textStyle="normal" />

                        <TextView
                            android:id="@+id/tv_clear_cache_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/urbanist_medium"
                            android:text="Purana temporary data hatao aur space free karo."
                            android:textColor="#7A7A7A"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/btn_clear_cache"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        android:backgroundTint="@color/arivihan_secondary_color"
                        android:paddingLeft="18dp"
                        android:paddingRight="18dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true">

                        <TextView
                            android:id="@+id/tv_clear_cache_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingVertical="6dp"
                            android:paddingHorizontal="12dp"
                            android:text="Clear Cache"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_app_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@color/gray_e5"
                    android:layout_marginVertical="6dp" />

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:layout_marginVertical="5dp"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="21dp"
                        android:layout_marginTop="3dp"
                        android:layout_marginRight="12dp"
                        android:src="@drawable/mobile" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_app_update_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Update App"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:textColor="#1D1D1D"
                            android:textSize="18sp"
                            android:textStyle="normal" />

                        <TextView
                            android:id="@+id/tv_app_update_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/urbanist_medium"
                            android:text="Play Store se latest version install karein."
                            android:textColor="#7A7A7A"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_app_update"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:strokeColor="@color/arivihan_secondary_color"
                        app:strokeWidth="1dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        android:backgroundTint="#FFFFFF"
                        android:paddingLeft="18dp"
                        android:paddingRight="18dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true">

                        <TextView
                            android:id="@+id/tv_app_update_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingVertical="6dp"
                            android:textColor="#26C6DA"
                            android:paddingHorizontal="12dp"
                            android:text="Update now"
                            android:textSize="14sp" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_phone_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@color/gray_e5"
                    android:layout_marginVertical="6dp" />

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="5dp"
                    android:padding="20dp"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:id="@+id/iv_phone_info_icon"
                        android:layout_width="20dp"
                        android:layout_height="21dp"
                        android:layout_marginTop="3dp"
                        android:layout_marginRight="12dp"
                        android:src="@drawable/phone_info" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_phone_info_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Phone info"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:textColor="#1D1D1D"
                            android:textSize="18sp"
                            android:textStyle="normal" />

                        <TextView
                            android:id="@+id/tv_phone_info_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/urbanist_medium"
                            android:text="Play Store se latest version install karein."
                            android:textColor="#7A7A7A"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_phone_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:strokeColor="@color/arivihan_secondary_color"
                        app:strokeWidth="1dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        android:backgroundTint="#FFFFFF"
                        android:paddingLeft="18dp"
                        android:paddingRight="18dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true">

                        <TextView
                            android:id="@+id/tv_phone_info_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingVertical="6dp"
                            android:textColor="#26C6DA"
                            android:paddingHorizontal="12dp"
                            android:text="@string/view_details"
                            android:textSize="14sp" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_additional_setting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@color/gray_e5"
                    android:layout_marginVertical="6dp" />

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:layout_marginVertical="5dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="21dp"
                        android:layout_marginTop="3dp"
                        android:layout_marginRight="12dp"
                        android:layout_gravity="top"
                        android:src="@drawable/mobile" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_additional_settings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Additional Settings"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:textColor="#1D1D1D"
                            android:textSize="18sp"
                            android:textStyle="normal" />

                        <TextView
                            android:id="@+id/tv_additional_settings_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/urbanist_medium"
                            android:text="Aur settings dekhne ke liye yahan click karein."
                            android:textColor="#7A7A7A"
                            android:textSize="14sp" />
                    </LinearLayout>


                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/arrow_back_ios"
                        android:rotation="180"
                        android:contentDescription="todo"
                        app:tint="#999999" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_environment_picker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                android:visibility="gone"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@color/gray_e5"
                    android:layout_marginVertical="6dp" />

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="5dp"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/iv_environment_icon"
                        android:layout_width="20dp"
                        android:layout_height="21dp"
                        android:layout_marginTop="3dp"
                        android:layout_marginRight="12dp"
                        android:src="@drawable/phone_info" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_environment_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Environment Mode"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:textColor="#1D1D1D"
                            android:textSize="18sp"
                            android:textStyle="normal" />

                        <TextView
                            android:id="@+id/tv_environment_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/urbanist_medium"
                            android:text="Switch between Different Env"
                            android:textColor="#7A7A7A"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_current_environment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:text="Current: Production"
                            android:textColor="@color/arivihan_secondary_color"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_outline_keyboard_arrow_down_24_analytics" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_debug_referrer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="16dp"
            android:textColor="#999999"
            android:textSize="12sp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>