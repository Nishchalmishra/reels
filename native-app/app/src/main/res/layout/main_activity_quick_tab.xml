<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardUseCompatPadding="true"
    android:clickable="false"
    android:elevation="@dimen/card_elevation"
    android:layout_height="wrap_content"
    android:focusable="true">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false">

        <androidx.cardview.widget.CardView
            app:cardCornerRadius="5dp"
            android:theme="@style/Theme.MaterialComponents.DayNight"
            android:layout_gravity="center"
            android:elevation="16dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="1dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:layout_width="0dp"
            app:cardUseCompatPadding="true"
            android:layout_weight="1"
            android:layout_height="match_parent"
            >
            <LinearLayout
                android:background="@color/off_white_background"
                android:layout_width="match_parent"
                android:id="@+id/ll_mock_test"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:paddingTop="15dp"
                android:orientation="vertical"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:layout_margin="2dp"
                    android:adjustViewBounds="true"
                    android:outlineAmbientShadowColor="@color/grey_500"
                    android:outlineSpotShadowColor="@color/grey_500"
                    android:shadowColor="@android:color/darker_gray"
                    android:shadowDx="3"
                    android:shadowDy="3"
                    android:shadowRadius="3" />

                <TextView
                    android:background="@color/off_white_background"
                    android:textAlignment="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/opensans_bold"
                    android:text="@string/mock_tests"
                    android:textColor="#515151"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>


        </androidx.cardview.widget.CardView>

        <com.google.android.material.card.MaterialCardView
            android:backgroundTint="@color/off_white_background"
            android:background="@color/off_white_background"
            android:theme="@style/Theme.MaterialComponents.DayNight"
            app:cardCornerRadius="5dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_gravity="center"
            android:elevation="16dp"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            app:cardUseCompatPadding="true"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_horizontal"
                android:paddingTop="15dp"
                android:background="@color/off_white_background"
                android:layout_width="match_parent"
                android:id="@+id/ll_pseudo_live"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:shadowColor="@android:color/darker_gray"
                    android:shadowDx="3"
                    android:shadowDy="3"
                    android:shadowRadius="3" />

                <TextView
                    android:background="@color/off_white_background"
                    android:textAlignment="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:fontFamily="@font/opensans_bold"
                    android:gravity="center"
                    android:text="@string/solved_doubts"
                    android:textColor="#515151"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            app:cardCornerRadius="5dp"
            android:focusable="true"
            android:clickable="true"
            android:theme="@style/Theme.MaterialComponents.DayNight"
            android:layout_gravity="center"
            android:elevation="16dp"
            android:layout_width="0dp"
            android:gravity="center"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:layout_weight="1"
            app:cardUseCompatPadding="true"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_horizontal"
                android:paddingTop="15dp"
                android:background="@color/off_white_background"
                android:layout_width="match_parent"
                android:id="@+id/ll_refer_and_earn"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:shadowColor="@android:color/darker_gray"
                    android:shadowDx="3"
                    android:shadowDy="3"
                    android:shadowRadius="3"/>

                <TextView
                    android:background="@color/off_white_background"
                    android:textAlignment="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:fontFamily="@font/opensans_bold"
                    android:text="@string/refer_earn"
                    android:textColor="#515151"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>


</androidx.cardview.widget.CardView>