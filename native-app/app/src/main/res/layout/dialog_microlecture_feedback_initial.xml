<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_dialog_parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="95dp"
        android:id="@+id/cv_dialog_parent"
        android:orientation="vertical"
        app:cardCornerRadius="15dp"
        app:cardElevation="2dp"
        android:layout_centerInParent="true"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_gravity="center"
            >

            <ScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:scrollbars="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginVertical="24dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/urbanist_bold"
                        android:gravity="center"
                        android:text="@string/well_done"
                        android:textColor="@color/black"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tv_sub_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginLeft="8dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginRight="8dp"
                        android:fontFamily="@font/urbanist_medium"
                        android:text="@string/aapko_lecture_kesa_laga"
                        android:textAlignment="center"
                        android:textIsSelectable="true"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:orientation="vertical">

                            <!--                        <ImageView-->
                            <!--                            android:id="@+id/iv_like"-->
                            <!--                            android:layout_width="100dp"-->
                            <!--                            android:layout_height="100dp"-->
                            <!--                            android:src="@drawable/img_thumbs_up"-->
                            <!--                            android:padding="12dp"-->
                            <!--                            android:layout_gravity="center_horizontal"-->
                            <!--                            />-->

                            <RelativeLayout
                                android:id="@+id/rl_like_background"
                                android:layout_width="110dp"
                                android:layout_height="110dp"
                                android:layout_gravity="center">

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/cv_like_background"
                                    android:layout_width="90dp"
                                    android:layout_height="90dp"
                                    android:layout_centerInParent="true"
                                    app:cardBackgroundColor="#E9FBFC"
                                    app:cardCornerRadius="80dp"
                                    app:cardElevation="0dp">

                                </androidx.cardview.widget.CardView>

                                <com.airbnb.lottie.LottieAnimationView
                                    android:id="@+id/lottie_feedback_like"
                                    android:layout_width="70dp"
                                    android:layout_height="70dp"
                                    android:layout_centerInParent="true"
                                    android:layout_gravity="center"
                                    android:scaleX="1.5"
                                    android:scaleY="1.5"
                                    app:lottie_autoPlay="true"
                                    app:lottie_loop="true"
                                    app:lottie_rawRes="@raw/feedback_like" />

                            </RelativeLayout>


                            <!--                        <androidx.cardview.widget.CardView-->
                            <!--                            android:id="@+id/cv_like_background"-->
                            <!--                            android:layout_width="100dp"-->
                            <!--                            android:layout_height="100dp"-->
                            <!--                            app:cardCornerRadius="80dp"-->
                            <!--                            app:cardElevation="0dp"-->
                            <!--                            app:cardBackgroundColor="#E9FBFC"-->
                            <!--                            -->
                            <!--                            >-->

                            <!--                            <com.airbnb.lottie.LottieAnimationView-->
                            <!--                                android:id="@+id/lottie_feedback_like"-->
                            <!--                                android:layout_width="80dp"-->
                            <!--                                android:layout_height="80dp"-->
                            <!--                                app:lottie_autoPlay="true"-->
                            <!--                                app:lottie_loop="true"-->
                            <!--                                android:scaleX="1.5"-->
                            <!--                                android:scaleY="1.5"-->
                            <!--                                app:lottie_rawRes="@raw/feedback_like"-->
                            <!--                                android:layout_gravity="center"-->
                            <!--                                />-->

                            <!--                        </androidx.cardview.widget.CardView>-->

                            <TextView
                                android:id="@+id/tv_like_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginLeft="8dp"
                                android:layout_marginTop="8dp"
                                android:layout_marginRight="8dp"
                                android:fontFamily="@font/urbanist_medium"
                                android:text="@string/like"
                                android:textAlignment="center"
                                android:textSize="14sp" />

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_secondary"
                                android:layout_width="200dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="16dp"
                                app:cardBackgroundColor="#E9FBFC"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="0dp"
                                app:contentPaddingBottom="10dp"
                                app:contentPaddingLeft="16dp"
                                app:contentPaddingRight="16dp"
                                app:contentPaddingTop="10dp">

                                <TextView
                                    android:id="@+id/tv_secondary_btn"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginLeft="8dp"
                                    android:layout_marginRight="8dp"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/urbanist_semi_bold"
                                    android:maxLines="1"
                                    android:text="@string/resume_lecture"
                                    android:textAlignment="center"
                                    android:textColor="@color/arivihan_secondary_color"
                                    android:textSize="17sp" />

                            </androidx.cardview.widget.CardView>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:orientation="vertical">

                            <!--                        <ImageView-->
                            <!--                            android:id="@+id/iv_dislike"-->
                            <!--                            android:layout_width="100dp"-->
                            <!--                            android:layout_height="100dp"-->
                            <!--                            android:src="@drawable/img_thumbs_down"-->
                            <!--                            android:padding="12dp"-->
                            <!--                            android:layout_gravity="center_horizontal"-->
                            <!--                            />-->

                            <RelativeLayout
                                android:id="@+id/rl_dislike_background"
                                android:layout_width="110dp"
                                android:layout_height="110dp"
                                android:layout_gravity="center">

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/cv_dislike_background"
                                    android:layout_width="90dp"
                                    android:layout_height="90dp"
                                    android:layout_centerInParent="true"
                                    app:cardBackgroundColor="#FFE1E5"
                                    app:cardCornerRadius="80dp"
                                    app:cardElevation="0dp"></androidx.cardview.widget.CardView>

                                <com.airbnb.lottie.LottieAnimationView
                                    android:id="@+id/lottie_feedback_dislike"
                                    android:layout_width="70dp"
                                    android:layout_height="70dp"
                                    android:layout_centerHorizontal="true"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="27dp"
                                    android:scaleX="1.5"
                                    android:scaleY="1.5"
                                    app:lottie_autoPlay="true"
                                    app:lottie_loop="true"
                                    app:lottie_rawRes="@raw/feedback_dislike" />

                            </RelativeLayout>

                            <TextView
                                android:id="@+id/tv_dislike_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginLeft="8dp"
                                android:layout_marginTop="8dp"
                                android:layout_marginRight="8dp"
                                android:fontFamily="@font/urbanist_medium"
                                android:text="@string/dislike"
                                android:textAlignment="center"
                                android:textSize="14sp" />

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_primary"
                                android:layout_width="200dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="16dp"
                                app:cardBackgroundColor="@color/arivihan_secondary_color"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="0dp"
                                app:contentPaddingBottom="10dp"
                                app:contentPaddingLeft="16dp"
                                app:contentPaddingRight="16dp"
                                app:contentPaddingTop="10dp">

                                <TextView
                                    android:id="@+id/tv_primary_btn"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginLeft="8dp"
                                    android:layout_marginRight="8dp"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/urbanist_semi_bold"
                                    android:maxLines="1"
                                    android:text="@string/Submit"
                                    android:textAlignment="center"
                                    android:textColor="@color/white"
                                    android:textSize="17sp" />

                            </androidx.cardview.widget.CardView>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <ImageView
                android:id="@+id/iv_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentTop="true"
                android:padding="6dp"
                android:src="@drawable/close"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                app:tint="#191919" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</RelativeLayout>