<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cv_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
   android:layout_marginHorizontal="10dp"
    android:layout_marginTop="6dp"
    app:cardBackgroundColor="#EDFFEC"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <RelativeLayout
        android:id="@+id/rl_card_background"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/personalized_subject_background"
        android:paddingHorizontal="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            >
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true">

                <TextView
                    android:id="@+id/tvSubjectName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:text="CHE"
                    android:textColor="#2D5016"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/personalised_path"
                    android:textSize="14sp"
                    android:fontFamily="@font/roboto_medium"
                    android:textColor="#555555"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

        </LinearLayout>

        <ImageView
            android:id="@+id/ivSubjectIcon"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_physics"
            android:contentDescription="Subject Icon" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>