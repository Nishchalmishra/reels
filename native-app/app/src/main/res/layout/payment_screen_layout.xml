<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/payment_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8"
    android:fillViewport="true"
    tools:context=".activity.QRCodePaymentActivity">

    <!-- ─── HERO BANNER ──────────────────────────── -->
<!--    <LinearLayout-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="match_parent"-->
<!--        android:orientation="vertical"-->
<!--        app:layout_constraintBottom_toBottomOf="parent"-->
<!--        app:layout_constraintEnd_toEndOf="parent"-->
<!--        app:layout_constraintStart_toStartOf="parent"-->
<!--        app:layout_constraintTop_toTopOf="parent">-->

<!--        <ImageView-->
<!--            android:id="@+id/hero_banner_image"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="320dp"-->
<!--            android:layout_gravity="top|center_horizontal"-->
<!--            android:scaleType="fitXY" />-->

<!--    </LinearLayout>-->

    <!-- ─── BOTTOM SECTION ──────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layout_bottom_view"
        android:layout_alignParentTop="true"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- ── Video / Thumbnail area ── -->
            <arivihan.technologies.doubtbuzzter2.customView.RatioView.Ratio16x9CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="@color/amp_transparent"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/image_shimmer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone">

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cardBackgroundColor="@color/mock_light_grey"
                            app:cardCornerRadius="11dp" />
                    </com.facebook.shimmer.ShimmerFrameLayout>


                    <ImageView
                        android:id="@+id/thumbnail_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:visibility="visible" />


                    <ImageView
                        android:id="@+id/middle_badge_image_thumbnail"
                        android:layout_width="120dp"
                        android:layout_height="100dp"
                        android:layout_gravity="bottom"
                        android:elevation="16dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/batch_details"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <ImageView
                        android:id="@+id/middle_badge_image_video"
                        android:layout_width="120dp"
                        android:layout_height="100dp"
                        android:layout_gravity="bottom"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="-10dp"
                        android:elevation="16dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/batch_details"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />


                    <androidx.media3.ui.PlayerView
                        android:id="@+id/player_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        app:resize_mode="fill"
                        app:use_controller="false" />

                    <ImageView
                        android:id="@+id/volume"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_margin="15dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/volume"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ProgressBar
                        android:id="@+id/spinnerVideoDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </arivihan.technologies.doubtbuzzter2.customView.RatioView.Ratio16x9CardView>
            <!-- ════════════════════════════════════════
                 SHIMMER OVERLAY  (visible while loading)
                 Hide this entire block once data loads:
                 shimmerContainer.visibility = View.GONE
                 shimmerContainer.stopShimmer()
                 ════════════════════════════════════════ -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmer_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Badge placeholder -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="40dp"
                        android:background="@drawable/shimmer_rounded"
                        android:translationY="40dp" />

                    <!-- Features card shimmer -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:layout_marginBottom="12dp"
                        app:cardBackgroundColor="@android:color/white"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="18dp"
                            android:paddingTop="56dp"
                            android:paddingEnd="18dp"
                            android:paddingBottom="18dp">

                            <!-- Title shimmer -->
                            <View
                                android:layout_width="160dp"
                                android:layout_height="16dp"
                                android:layout_marginBottom="20dp"
                                android:background="@drawable/shimmer_rounded" />

                            <!-- Row 1 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/shimmer_rounded" />

                            </LinearLayout>

                            <!-- Row 2 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/shimmer_rounded" />

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_marginStart="6dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/shimmer_rounded" />

                            </LinearLayout>

                            <!-- Row 3 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/shimmer_rounded" />

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_marginStart="6dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/shimmer_rounded" />

                            </LinearLayout>

                            <!-- Row 4 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/shimmer_rounded" />

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_marginStart="6dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/shimmer_rounded" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- QR scan card shimmer -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="12dp"
                        app:cardBackgroundColor="@android:color/white"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="0dp">


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <!-- Label placeholder -->
                            <View
                                android:layout_width="180dp"
                                android:layout_height="14dp"
                                android:layout_marginBottom="18dp"
                                android:background="@drawable/shimmer_rounded" />

                            <!-- QR box placeholder -->
                            <View
                                android:layout_width="200dp"
                                android:layout_height="200dp"
                                android:layout_marginBottom="12dp"
                                android:background="@drawable/shimmer_rounded" />

                            <!-- Buttons row placeholder -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="48dp"
                                    android:layout_marginEnd="8dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/shimmer_rounded" />

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="48dp"
                                    android:layout_weight="1.6"
                                    android:background="@drawable/shimmer_rounded" />

                            </LinearLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- ════════════════════════════════════════
                 REAL CONTENT  (hidden while loading)
                 Show once data is ready:
                 contentContainer.visibility = View.VISIBLE
                 ════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/content_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible"
                tools:visibility="visible">


                <!-- FEATURES CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/feature_card_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginBottom="8dp"
                            android:fontFamily="@font/urbanist_bold"
                            android:text="Batch ke features:"
                            android:textColor="#1A2D3D"
                            android:textSize="17sp" />

                        <!-- Row 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:orientation="horizontal">

                            <include
                                android:id="@+id/feature_batch_title"
                                layout="@layout/item_feature_check"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />
                        </LinearLayout>

                        <!-- Row 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:orientation="horizontal">

                            <include
                                android:id="@+id/feature_live_classes"
                                layout="@layout/item_feature_check"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <include
                                android:id="@+id/feature_topper_notes"
                                layout="@layout/item_feature_check"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1" />
                        </LinearLayout>

                        <!-- Row 3 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:orientation="horizontal">

                            <include
                                android:id="@+id/feature_free_rewards"
                                layout="@layout/item_feature_check"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <include
                                android:id="@+id/feature_student_community"
                                layout="@layout/item_feature_check"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1" />
                        </LinearLayout>

                        <!-- Row 4 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:orientation="horizontal">

                            <include
                                android:id="@+id/feature_recorded_lectures"
                                layout="@layout/item_feature_check"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <include
                                android:id="@+id/feature_doubt_support"
                                layout="@layout/item_feature_check"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1" />
                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ─── QR SCAN CARD ──────────────────────────── -->
                <!-- FrameLayout so mascot floats OVER the card -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        app:cardBackgroundColor="@android:color/white"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <!-- Banner -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/gg_qr_banner_wave"
                                android:letterSpacing="-0.01"
                                android:orientation="vertical"
                                android:paddingStart="41dp"
                                android:paddingTop="16dp"
                                android:paddingEnd="41dp"
                                android:paddingBottom="24dp">

                                <TextView
                                    android:id="@+id/qr_section_title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="4dp"
                                    android:fontFamily="@font/urbanist_bold"
                                    android:gravity="center"
                                    android:letterSpacing="-0.01"
                                    android:text="@string/scan_qr_code_and_pay"
                                    android:textColor="#1A2D3D"
                                    android:textSize="16dp"
                                    android:maxLines="1"
                                    android:autoSizeTextType="uniform"
                                    android:autoSizeMinTextSize="8sp"
                                    android:autoSizeMaxTextSize="18sp"
                                    android:autoSizeStepGranularity="1sp" />/>

                                <TextView
                                    android:id="@+id/qr_section_subtitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/urbanist_bold"
                                    android:gravity="center"
                                    android:text="@string/scan_qr_code_and_pay_subtitle"
                                    android:textColor="#1EA6B3"
                                    android:textSize="14dp"
                                    android:maxLines="1"
                                    android:autoSizeTextType="uniform"
                                    android:autoSizeMinTextSize="6dp"
                                    android:autoSizeMaxTextSize="16sp"
                                    android:autoSizeStepGranularity="1sp" />/>

                            </LinearLayout>

                            <!-- QR Code Box -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                app:cardBackgroundColor="@android:color/white"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:strokeColor="#DADADA"
                                app:strokeWidth="1dp">

                                <FrameLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="5dp">

                                    <com.facebook.shimmer.ShimmerFrameLayout
                                        android:id="@+id/qr_code_shimmer"
                                        android:layout_width="200dp"
                                        android:layout_height="200dp">

                                        <View
                                            android:layout_width="200dp"
                                            android:layout_height="200dp"
                                            android:background="@color/grey_300" />

                                    </com.facebook.shimmer.ShimmerFrameLayout>

                                    <ImageView
                                        android:id="@+id/qr_code_payment_image"
                                        android:layout_width="184dp"
                                        android:layout_height="180dp"
                                        android:scaleType="fitCenter"
                                        android:visibility="gone"
                                        tools:src="@drawable/ic_launcher_background"
                                        tools:visibility="visible"
                                        android:layout_gravity="center"/>

                                </FrameLayout>

                            </com.google.android.material.card.MaterialCardView>


                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <ImageView
                        android:id="@+id/mascot_image"
                        android:layout_width="41dp"
                        android:layout_height="110dp"
                        android:layout_gravity="top|end"
                        android:adjustViewBounds="true"
                        android:elevation="8dp"
                        android:scaleType="fitEnd"
                        android:src="@drawable/subscription_screen_qrcode_illustration" />

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/layout_bottom_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="visible"
        android:padding="10dp"
        android:background="@android:color/white"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        >


        <!-- Bottom Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Share QR -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/share_qr_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeColor="#29B53F"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="2dp"
                        android:src="@drawable/whatsapp_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/urbanist_bold"
                        android:text="@string/share_qr"
                        android:textColor="#29B53F"
                        android:paddingVertical="4dp"
                        android:textSize="14dp"
                        android:maxLines="1"
                        android:singleLine="true"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Other Payment Options -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/other_payment_option"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#0AB5C8"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/urbanist_semi_bold"
                        android:text="@string/other_payment_options"
                        android:paddingVertical="4dp"
                        android:textColor="@android:color/white"
                        android:textSize="14dp"
                        android:singleLine="true" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
