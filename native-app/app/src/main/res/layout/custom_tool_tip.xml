<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:id="@+id/body_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/top_pointer"
        android:layout_centerHorizontal="true"
        app:cardUseCompatPadding="false"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="#211f27">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/urbanist_semi_bold"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/text_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/title"
                android:layout_alignParentStart="true"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="15dp"
                android:fontFamily="@font/urbanist_medium"
                android:textColor="#c6c0cc"
                android:textSize="11sp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/text_body_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/title"
                android:layout_alignParentStart="true"
                android:layout_marginHorizontal="25dp"
                android:layout_marginVertical="10dp"
                android:fontFamily="@font/urbanist_medium"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/skip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/text_body"
                android:layout_alignParentStart="true"
                android:fontFamily="@font/urbanist_semi_bold"
                android:paddingHorizontal="17dp"
                android:paddingBottom="20dp"
                android:text="@string/skip"
                android:textColor="#D0BCFE"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/text_body"
                android:layout_toEndOf="@id/skip"
                android:fontFamily="@font/urbanist_semi_bold"
                android:paddingHorizontal="17dp"
                android:paddingBottom="20dp"
                android:text="@string/next"
                android:textColor="#D0BCFE"
                android:textSize="12sp"
                android:visibility="gone" />

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <ImageView
        android:id="@+id/top_pointer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="-5dp"
        android:src="@drawable/tip_up" />

    <ImageView
        android:id="@+id/bottom_pointer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/body_frame"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="-5dp"
        android:src="@drawable/tip_down" />

    <ImageView
        android:id="@+id/right_pointer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginStart="-5dp"
        android:src="@drawable/tip_up"
        android:rotation="90"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@id/body_frame"
        android:visibility="gone"/>

</RelativeLayout>
