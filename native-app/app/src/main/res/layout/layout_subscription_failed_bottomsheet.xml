<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dialogContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/cv_close"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_rounded_top_sub_failed" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="8dp"
                android:orientation="vertical">

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmer_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- HELP Desk -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:layout_marginBottom="12dp"
                            app:cardBackgroundColor="@android:color/white"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="1dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="100dp"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:padding="18dp">

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="100dp"
                                    android:background="@drawable/shimmer_rounded" />

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- QR scan card shimmer -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:layout_marginBottom="12dp"
                            app:cardBackgroundColor="@android:color/white"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="1dp"
                            app:strokeWidth="0dp">


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:padding="18dp">

                                <!-- Label placeholder -->
                                <View
                                    android:layout_width="180dp"
                                    android:layout_height="14dp"
                                    android:layout_marginBottom="18dp"
                                    android:background="@drawable/shimmer_rounded" />

                                <!-- QR box placeholder -->
                                <View
                                    android:layout_width="200dp"
                                    android:layout_height="200dp"
                                    android:layout_marginBottom="12dp"
                                    android:background="@drawable/shimmer_rounded" />

                                <!-- Buttons row placeholder -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <View
                                        android:layout_width="0dp"
                                        android:layout_height="48dp"
                                        android:layout_marginEnd="8dp"
                                        android:layout_weight="1"
                                        android:background="@drawable/shimmer_rounded" />

                                    <View
                                        android:layout_width="0dp"
                                        android:layout_height="48dp"
                                        android:layout_weight="1.6"
                                        android:background="@drawable/shimmer_rounded" />

                                </LinearLayout>

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </com.facebook.shimmer.ShimmerFrameLayout>

                <LinearLayout
                    android:id="@+id/container_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <!-- ─── HELP CARD ──────────────────────────── -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@android:color/white"
                        android:layout_margin="8dp"
                        android:layout_marginBottom="20dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="7dp"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginHorizontal="7dp"
                                android:src="@drawable/ic_info_ye" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="7dp"
                                android:orientation="vertical"
                                android:letterSpacing="-0.01">

                                <TextView
                                    android:id="@+id/help_desk_title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/urbanist_bold"
                                    android:letterSpacing="-0.01"
                                    android:layout_marginBottom="2dp"
                                    android:text="@string/sub_failed_help_title"
                                    android:textColor="@color/black_12"
                                    android:textSize="16dp" />

                                <TextView
                                    android:id="@+id/help_desk_subtitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/urbanist_medium"
                                    android:text="@string/sub_failed_help_subtitle"
                                    android:textColor="#696969"
                                    android:textSize="14dp" />

                            </LinearLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>


                    <!-- ─── QR SCAN CARD ──────────────────────────── -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@android:color/white"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="0dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <!-- Banner -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/gg_qr_banner_wave"
                                    android:orientation="vertical"
                                    android:paddingTop="16dp"
                                    android:paddingBottom="24dp"
                                    android:paddingStart="8dp"
                                    android:letterSpacing="-0.01"
                                    android:paddingEnd="8dp">

                                    <TextView
                                        android:id="@+id/qr_section_title"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/urbanist_bold"
                                        android:gravity="center"
                                        android:letterSpacing="-0.01"
                                        android:layout_marginBottom="4dp"
                                        android:text="@string/scan_qr_code_and_pay"
                                        android:textColor="#1A2D3D"
                                        android:textSize="16dp" />

                                    <TextView
                                        android:id="@+id/qr_section_subtitle"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/urbanist_bold"
                                        android:gravity="center"
                                        android:text="@string/scan_qr_code_and_pay_subtitle"
                                        android:textColor="#1EA6B3"
                                        android:textSize="14dp" />

                                </LinearLayout>

                                <!-- QR Code Box -->
                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:layout_marginBottom="12dp"
                                    app:cardBackgroundColor="@android:color/white"
                                    app:cardCornerRadius="12dp"
                                    app:cardElevation="0dp"
                                    app:strokeColor="#DADADA"
                                    app:strokeWidth="1dp">

                                    <FrameLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content">

                                        <com.facebook.shimmer.ShimmerFrameLayout
                                            android:id="@+id/qr_code_shimmer"
                                            android:layout_width="200dp"
                                            android:layout_height="200dp">

                                            <View
                                                android:layout_width="200dp"
                                                android:layout_height="200dp"
                                                android:background="@color/grey_300" />

                                        </com.facebook.shimmer.ShimmerFrameLayout>

                                        <ImageView
                                            android:id="@+id/qr_code_payment_image"
                                            android:layout_width="184dp"
                                            android:layout_height="180dp"
                                            android:scaleType="fitCenter"
                                            android:visibility="gone"
                                            tools:src="@drawable/ic_launcher_background"
                                            tools:visibility="visible" />

                                    </FrameLayout>

                                </com.google.android.material.card.MaterialCardView>


                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:paddingVertical="8dp"
                                    android:paddingHorizontal="16dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/urbanist_medium"
                                        android:gravity="center"
                                        android:letterSpacing="-0.01"
                                        android:layout_marginBottom="8dp"
                                        android:text="@string/or_pay_using_other_methods"
                                        android:textColor="#696969"
                                        android:textSize="14sp" />

                                    <com.google.android.material.card.MaterialCardView
                                        android:id="@+id/phone_pe_card"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="5dp"
                                        android:layout_marginBottom="8dp"
                                        app:cardBackgroundColor="@android:color/white"
                                        app:cardCornerRadius="12dp"
                                        app:cardElevation="0dp"
                                        app:strokeColor="#14000000"
                                        app:strokeWidth="1dp">

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:gravity="center_vertical"
                                            android:paddingVertical="12dp"
                                            android:paddingHorizontal="15dp"
                                            android:orientation="horizontal">


                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:orientation="horizontal">

                                                <ImageView
                                                    android:layout_width="22dp"
                                                    android:layout_height="22dp"
                                                    android:layout_marginEnd="4dp"
                                                    android:src="@drawable/ic_phone_pe" />

                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:fontFamily="@font/urbanist_bold"
                                                    android:text="@string/phonepe"
                                                    android:textColor="@color/black_12"
                                                    android:textSize="16sp"
                                                    android:paddingHorizontal="5dp"
                                                    android:maxLines="1"
                                                    android:singleLine="true"/>

                                            </LinearLayout>

                                            <ImageView
                                                android:layout_width="14dp"
                                                android:layout_height="14dp"
                                                android:layout_weight="0"
                                                android:rotation="180"
                                                app:tint="#66000000"
                                                android:src="@drawable/arrow_back_ios_black" />

                                        </LinearLayout>

                                    </com.google.android.material.card.MaterialCardView>

                                    <com.google.android.material.card.MaterialCardView
                                        android:id="@+id/google_pay_card"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="5dp"
                                        android:layout_marginBottom="8dp"
                                        app:cardBackgroundColor="@android:color/white"
                                        app:cardCornerRadius="12dp"
                                        app:cardElevation="0dp"
                                        app:strokeColor="#14000000"
                                        app:strokeWidth="1dp">

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:gravity="center_vertical"
                                            android:paddingVertical="12dp"
                                            android:paddingHorizontal="15dp"
                                            android:orientation="horizontal">


                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:orientation="horizontal">

                                                <ImageView
                                                    android:layout_width="22dp"
                                                    android:layout_height="22dp"
                                                    android:layout_marginEnd="4dp"
                                                    android:src="@drawable/ic_google_pay" />

                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:fontFamily="@font/urbanist_bold"
                                                    android:text="@string/gpay"
                                                    android:textColor="@color/black_12"
                                                    android:textSize="16sp"
                                                    android:paddingHorizontal="5dp"
                                                    android:maxLines="1"
                                                    android:singleLine="true"/>

                                            </LinearLayout>

                                            <ImageView
                                                android:layout_width="14dp"
                                                android:layout_height="14dp"
                                                android:layout_weight="0"
                                                android:rotation="180"
                                                app:tint="#66000000"
                                                android:src="@drawable/arrow_back_ios_black" />

                                        </LinearLayout>

                                    </com.google.android.material.card.MaterialCardView>

                                </LinearLayout>

                            </LinearLayout>

                            <ImageView
                                android:id="@+id/mascot_image"
                                android:layout_width="100dp"
                                android:layout_height="130dp"
                                android:layout_gravity="top|end"
                                android:src="@drawable/subscription_screen_qrcode_illustration"
                                android:scaleType="fitEnd"
                                android:adjustViewBounds="true"
                                android:elevation="8dp" />

                        </FrameLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>


            <LinearLayout
                android:id="@+id/layout_bottom_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="visible"
                android:padding="10dp"
                android:background="@android:color/white"
                android:orientation="vertical">

                <!-- Bottom Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Share QR -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/share_qr_btn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="7dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@android:color/white"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#29B53F"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingTop="14dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="14dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="4dp"
                                android:src="@drawable/whatsapp_icon" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/urbanist_bold"
                                android:text="@string/share_qr"
                                android:textColor="#29B53F"
                                android:textSize="13dp"
                                android:maxLines="1"
                                android:singleLine="true"/>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Other Payment Options -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/other_payment_option"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="7dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="#0AB5C8"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="10dp"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/urbanist_semi_bold"
                                android:text="@string/other_payment_options"
                                android:textColor="@android:color/white"
                                android:textSize="13dp"
                                android:singleLine="true" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Help -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/help_contact_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="7dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/selected"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="14dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/whatsapp_icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/urbanist_bold"
                            android:text="@string/contact_whatsapp_sub_failed"
                            android:textColor="@color/btn_enabled_bg"
                            android:textSize="15dp"
                            android:maxLines="1"
                            android:singleLine="true"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>



    <!-- Centered Close Button at Top -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:background="@color/color_transparent"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp"
        android:layout_centerHorizontal="true"
        app:cardBackgroundColor="@android:color/white">

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:padding="6dp"
            android:src="@drawable/close_filled_icon"
            android:contentDescription="@string/close" />
    </androidx.cardview.widget.CardView>

</RelativeLayout>