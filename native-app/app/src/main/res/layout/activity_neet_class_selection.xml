<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3FFFF">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/on_boarding_background_new">

        <!-- Toolbar: volume button (no progress bar) -->
        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            android:paddingEnd="8dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:layout_alignParentTop="true">

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_volume"
                android:layout_width="34dp"
                android:layout_height="34dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="17dp"
                app:cardElevation="1dp"
                android:layout_marginHorizontal="6dp"
                android:layout_marginVertical="6dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_volume"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/img_volume_high"
                    app:tint="@color/black"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:padding="6dp" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Fragment container (between toolbar and bottom nav) -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/bottom_layout" />

        <!-- Bottom nav: Back + Forward -->
        <LinearLayout
            android:id="@+id/bottom_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:paddingTop="20dp"
            android:orientation="horizontal">

            <!-- Back (hidden on first screen) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btn_back"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_margin="6dp"
                android:visibility="invisible"
                app:cardBackgroundColor="@color/subscription_blue"
                app:cardCornerRadius="25dp"
                app:cardElevation="3dp">
                <ImageView
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_gravity="center"
                    android:src="@drawable/previous" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center" />

            <!-- Forward (disabled until selection) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btn_forward"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_margin="6dp"
                app:cardBackgroundColor="@color/disabled_next_color"
                app:cardCornerRadius="25dp"
                app:cardElevation="3dp">
                <ImageView
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_gravity="center"
                    android:src="@drawable/next" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </RelativeLayout>

</LinearLayout>
