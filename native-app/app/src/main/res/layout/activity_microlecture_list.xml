                    <!--                            <ProgressBar-->
                    <!--                                android:id="@+id/download_progress_bar"-->
                    <!--                                style="?android:attr/progressBarStyleHorizontal"-->
                    <!--                                android:layout_width="35dp"-->
                    <!--                                android:layout_height="35dp"-->
                    <!--                                android:background="@drawable/circle_shape_video_download"-->
