                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:id="@+id/chapter_progress_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="visible"
                    app:layout_constraintBottom_toTopOf="@id/divider"
                    app:layout_constraintTop_toBottomOf="@id/chapter_title_layout">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <com.mancj.slimchart.SlimChart
                            android:id="@+id/chapter_progress"
                            android:layout_width="65dp"
                            android:layout_height="65dp"
                            android:paddingVertical="10dp"
                            android:rotation="90"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:roundedEdges="true"
                            app:strokeWidth="8dp"
                            app:text="30%" />

                        <TextView
                            android:id="@id/progress_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/urbanist_bold"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            app:layout_constraintBottom_toBottomOf="@id/chapter_progress"
                            app:layout_constraintLeft_toLeftOf="@id/chapter_progress"
                            app:layout_constraintRight_toRightOf="@id/chapter_progress"
                            app:layout_constraintTop_toTopOf="@id/chapter_progress" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/chapter_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/urbanist_bold"
                            android:text="Kinematics"
                            android:textColor="@color/black"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:text="@string/completion_progress"
                            android:textColor="#B305040E"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp"
                        android:weightSum="10">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cv_like_dislike_card"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:layout_marginHorizontal="4dp"
                            app:cardBackgroundColor="@color/lecture_feature_card_background"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp">

                                <RelativeLayout
                                    android:layout_width="27dp"
                                    android:layout_height="27dp"
                                    android:layout_gravity="center_vertical">

                                    <ImageView
                                        android:id="@+id/iv_like"
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:layout_centerInParent="true"
                                        android:scaleType="centerCrop"
                                        android:scaleY="1.1"
                                        android:scaleX="1.1"
                                        android:src="@drawable/img_like_outline"
                                        app:tint="@color/black" />

                                    <com.airbnb.lottie.LottieAnimationView
                                        android:id="@+id/lottie_like"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:scaleX="1.8"
                                        android:scaleY="1.8"
                                        android:visibility="gone"
                                        app:lottie_autoPlay="false"
                                        app:lottie_loop="false"
                                        app:lottie_rawRes="@raw/like_animation" />

                                </RelativeLayout>

                                <TextView
                                    android:id="@+id/tv_like_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:fontFamily="@font/inter_semibold"
                                    android:text="2.4k"
                                    android:textColor="@color/black"
                                    android:textSize="10dp"
                                    android:textStyle="normal" />

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="match_parent"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginVertical="5dp"
                                    android:layout_marginStart="8dp"
                                    android:layout_marginEnd="2dp"
                                    android:background="@color/black" />

                                <RelativeLayout
                                    android:layout_width="27dp"
                                    android:layout_height="27dp"
                                    android:layout_gravity="center_vertical">

                                    <ImageView
                                        android:id="@+id/iv_dislike"
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:layout_centerInParent="true"
                                        android:scaleType="centerCrop"
                                        android:scaleX="1.1"
                                        android:scaleY="1.1"
                                        android:src="@drawable/img_dislike_outline"
                                        app:tint="@color/black" />

                                    <com.airbnb.lottie.LottieAnimationView
                                        android:id="@+id/lottie_dislike"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:scaleX="1.5"
                                        android:scaleY="1.5"
                                        android:visibility="gone"
                                        app:lottie_autoPlay="false"
                                        app:lottie_loop="false"
                                        app:lottie_rawRes="@raw/dislike_animation" />

                                </RelativeLayout>

                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cv_comment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:layout_marginHorizontal="4dp"
                            app:cardBackgroundColor="@color/lecture_feature_card_background"
                            app:cardCornerRadius="17.5dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp">

                                <ImageView
                                    android:id="@+id/iv_comment"
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:layout_gravity="center_vertical"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/img_comment_msg_outline"
                                    app:tint="@color/black" />

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="27dp"
                                    android:layout_marginHorizontal="2dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:fontFamily="@font/nunito_bold"
                                    android:text="@string/comment"
                                    android:textColor="@color/black"
                                    android:textSize="11dp"
                                    android:textStyle="normal" />

                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cv_notes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="4dp"
                            android:visibility="gone"
                            app:cardBackgroundColor="@color/lecture_feature_card_background"
                            app:cardCornerRadius="25dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp">

                                <ImageView
                                    android:id="@+id/iv_notes"
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:layout_gravity="center_vertical"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/ncert_logo_microlecture_screen"
                                    app:tint="@color/black" />

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="27dp"
                                    android:layout_marginHorizontal="2dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_bold"
                                    android:text="@string/ncert_solutions_lecture"
                                    android:textAlignment="center"
                                    android:textColor="@color/black"
                                    android:textSize="9dp"
                                    android:textStyle="normal" />

                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cv_download"
                            android:layout_width="wrap_content"
                            android:layout_height="35dp"
                            android:layout_marginHorizontal="4dp"
                            app:cardBackgroundColor="@color/lecture_feature_card_background"
                            app:cardCornerRadius="17.5dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:orientation="horizontal"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:id="@+id/download"
                                        android:layout_width="15dp"
                                        android:layout_height="15dp"
                                        android:layout_gravity="center_vertical"
                                        android:scaleType="centerCrop"
                                        android:src="@drawable/download_dark"
                                        android:visibility="visible"
                                        app:tint="@color/black" />

                                    <ImageView
                                        android:id="@+id/download_completed"
                                        android:layout_width="20dp"
                                        android:layout_height="22dp"
                                        android:layout_gravity="center_vertical"
                                        android:src="@drawable/img_accept_right_filled"
                                        android:visibility="gone" />

                                    <LinearLayout
                                        android:id="@+id/download_progress_layout"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:visibility="gone">

                                        <ProgressBar
                                            android:id="@+id/download_progress_bar"
                                            style="?android:attr/progressBarStyleHorizontal"
                                            android:layout_width="28dp"
                                            android:layout_height="28dp"
                                            android:layout_gravity="center_vertical"
                                            android:background="@drawable/circle_shape_video_download"
                                            android:indeterminate="false"
                                            android:progressDrawable="@drawable/circle_progress_video_download" />

                                        <TextView
                                            android:id="@+id/download_progress_text"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center_vertical"
                                            android:layout_marginStart="8dp"
                                            android:fontFamily="@font/urbanist_semi_bold"
                                            android:text="0%"
                                            android:textColor="#3F3F3F"
                                            android:textSize="11sp" />
                                    </LinearLayout>
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/download_status_text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginStart="6dp"
                                    android:layout_marginEnd="2dp"
                                    android:fontFamily="@font/nunito_bold"
                                    android:text="@string/Download"
                                    android:textColor="@color/black"
                                    android:textSize="11dp"
                                    android:textStyle="normal" />

                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="15dp"
                    android:background="@color/mock_light_grey"
                    android:orientation="horizontal"
                    android:visibility="visible"
                    app:layout_constraintTop_toBottomOf="@+id/chapter_progress_layout" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:listitem="@layout/microlecture_detail_list_item" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_scroll_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/black"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:alpha="0.8"
            >
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center"
                android:paddingVertical="6dp"
                android:paddingHorizontal="16dp"
                >
                <TextView
                    android:id="@+id/tv_scroll_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/urbanist_semi_bold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:layout_gravity="center_vertical"
                    android:text="@string/neeche_jayein"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    />

                <ImageView
                    android:id="@+id/iv_scroll_toggle"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/baseline_arrow_downward_24"
                    app:tint="@color/white"
                    android:scaleType="centerCrop"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="0dp"
                    />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/shimmer_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/preview_shimmer"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="@color/mock_light_grey" />
            </LinearLayout>

        </com.facebook.shimmer.ShimmerFrameLayout>

        <com.facebook.shimmer.ShimmerFrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/mock_lightest_grey"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <include
                    layout="@layout/microlecture_detail_shimmer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" />

                <include layout="@layout/microlecture_detail_shimmer" />

                <include layout="@layout/microlecture_detail_shimmer" />

                <include layout="@layout/microlecture_detail_shimmer" />

            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
    </LinearLayout>

    <include
        android:id="@+id/how_to_video_view"
        layout="@layout/activity_mock_demo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>