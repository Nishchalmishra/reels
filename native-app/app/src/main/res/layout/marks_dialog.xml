<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    android:layout_marginHorizontal="50dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="20dp"
            app:layout_constraintTop_toBottomOf="@id/close_btn">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_semibold"
                android:text="@string/Your_Answer_is_Checked"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/animation"
                android:layout_width="130dp"
                android:layout_height="150dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/reattempt"
                android:scaleY="1.2"
                android:scaleX="1.2"
                android:visibility="visible"
                android:layout_marginVertical="10dp"/>

            <ImageView
                android:id="@+id/selection_image"
                android:layout_width="150dp"
                android:layout_height="160dp"
                android:src="@drawable/selection_image"
                android:visibility="gone"
                android:layout_marginVertical="10dp"/>

            <TextView
                android:id="@+id/marks_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_semibold"
                android:gravity="center"
                android:text="Your Score : 3/5"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:layout_marginHorizontal="30dp"/>

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_regular"
                android:gravity="center"
                android:text="@string/want_to_review"
                android:textColor="#696969"
                android:textSize="15sp"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="10dp"/>
        </LinearLayout>

</androidx.cardview.widget.CardView>