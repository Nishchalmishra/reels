<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ReferAndEarn">

    <include android:id="@+id/toolbar"
        layout="@layout/activity_custom_toolbar_layout"/>

    <ScrollView
        android:layout_marginTop="56dp"
        android:layout_marginBottom="80dp"
        android:id="@+id/scrollbar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.airbnb.lottie.LottieAnimationView
            android:layout_width="match_parent"
            android:layout_height="260dp"
            app:lottie_autoPlay="true"
            android:layout_marginTop="25dp"
            app:lottie_repeatCount="100"
            app:lottie_rawRes="@raw/refer_earn"
            app:lottie_loop="true"
            android:layout_marginBottom="20dp"
            />

       <RelativeLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="220dp"
            app:strokeWidth="1dp"
            android:layout_margin="10dp"
            app:cardCornerRadius="8dp"
            android:layout_centerHorizontal="true"
            app:strokeColor="@color/navy_blue"
            android:theme="@style/Theme.MaterialComponents.Light"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView

                    android:id="@+id/text1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="10dp"
                    android:text="@string/your_referral_code"
                    android:textAlignment="center"
                    android:textColor="#555555"
                    android:textSize="@dimen/primary_text_size"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/referral_code_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/text1"
                    android:layout_marginTop="15dp"
                    android:textAlignment="center"
                    android:layout_marginBottom="20dp"
                    android:textColor="@color/arivihan_secondary_color"
                    android:textIsSelectable="true"
                    android:textSize="@dimen/secondary_text_size"
                    android:textStyle="bold" />

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            app:strokeWidth="1dp"
            android:layout_weight="1"
            android:visibility="gone"
            android:layout_margin="10dp"
            app:strokeColor="@color/navy_blue"
            app:cardCornerRadius="8dp"
            android:theme="@style/Theme.MaterialComponents.Light"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/text2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:textColor="#555555"
                    android:layout_marginTop="10dp"
                    android:text="@string/your_referral_score"
                    android:textSize="@dimen/primary_text_size"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/referral_score_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/text2"
                    android:textAlignment="center"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="20dp"
                    android:textColor="@color/arivihan_secondary_color"
                    android:textSize="@dimen/secondary_text_size"
                    android:textStyle="bold" />


            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

       </RelativeLayout>

        <TextView
            android:layout_marginTop="30dp"
            android:layout_marginEnd="50dp"
            android:layout_marginStart="50dp"
            android:id="@+id/rules"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/navy_blue"
            android:fontFamily="@font/comfortaa"
            android:textStyle="bold"
            style="@style/secondaryText"
            android:text="@string/terms_and_condition"
            />




        <TextView
            android:layout_marginTop="25dp"
            android:id="@+id/terms"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:textColor="@color/navy_blue"
            android:fontFamily="@font/comfortaa"
            android:textStyle="bold"
            android:textSize="@dimen/tertiary_text_size"
            android:text="@string/terms_and_condition"
            />



    </LinearLayout>

    </ScrollView>


    <com.google.android.material.card.MaterialCardView
        android:elevation="10dp"
        android:outlineSpotShadowColor="@color/grey_500"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:id="@+id/button_refer_a_friend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:foreground="?android:attr/selectableItemBackground"
        android:theme="@style/Theme.MaterialComponents.Light"
        app:cardCornerRadius="5dp"
        app:strokeColor="#19B0C1"
        app:strokeWidth="1dp">

        <RelativeLayout
            android:background="#19B0C1"
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <TextView
                android:textAlignment="center"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_margin="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/poppins_light"
                android:text="@string/refer_a_friend"
                android:textColor="#fff"
                android:textStyle="bold" />



        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>



</RelativeLayout>