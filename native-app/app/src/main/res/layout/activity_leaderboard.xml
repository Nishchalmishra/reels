<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.LeaderboardActivity">

    <androidx.cardview.widget.CardView
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        app:cardElevation="10dp"
        android:layout_marginTop="-25dp"
        app:cardCornerRadius="35dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:background="@drawable/gamegradient"
            android:layout_height="match_parent">


            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="110dp"
                android:layout_marginLeft="100dp"
                android:alpha="0.2"
                android:rotationY="25"
                android:src="@drawable/ic_award_svgrepo_com"/>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="310dp"
                android:layout_marginLeft="128dp"
                android:alpha="0.2"
                android:src="@drawable/ic_award_svgrepo_com"/>


            <TextView
                android:id="@+id/name"
                android:layout_marginStart="15dp"
                android:textColor="@color/white"
                style="@style/primaryText"
                android:text="@string/game_id"
                android:layout_marginTop="30dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <ImageView
                android:id="@+id/refresh"
                android:layout_marginTop="30dp"
                android:layout_marginRight="10dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_baseline_refresh_24"/>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="50dp"
                android:layout_marginRight="124dp"
                android:layout_alignParentRight="true"
                android:alpha="0.2"
                android:rotationY="5"
                android:rotationX="-20"
                android:src="@drawable/ic_award_svgrepo_com"/>


            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="90dp"
                android:layout_marginLeft="280dp"
                android:alpha="0.2"
                android:rotationY="25"
                android:src="@drawable/ic_sport_winner_svgrepo_com"/>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="50dp"
                android:layout_marginLeft="180dp"
                android:alpha="0.2"
                android:rotationY="-25"
                android:src="@drawable/ic_sport_winner_svgrepo_com"/>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_margin="30dp"
                android:alpha="0.2"
                android:layout_alignParentBottom="true"
                android:layout_alignParentRight="true"
                android:rotationY="25"
                android:src="@drawable/ic_sport_winner_svgrepo_com"/>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginRight="100dp"
                android:layout_marginBottom="38dp"
                android:alpha="0.2"
                android:layout_alignParentBottom="true"
                android:layout_alignParentRight="true"
                android:rotationY="25"
                android:src="@drawable/ic_award_svgrepo_com"/>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="290dp"
                android:layout_marginLeft="80dp"
                android:alpha="0.2"
                android:rotationY="25"
                android:src="@drawable/ic_sport_winner_svgrepo_com"/>

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="150dp"
                android:layout_marginLeft="250dp"
                android:alpha="0.2"
                android:rotationX="20"
                android:rotationY="25"
                android:src="@drawable/ic_trophy_svgrepo_com"/>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="178dp"
                android:layout_marginLeft="100dp"
                android:alpha="0.2"
                android:rotationX="25"
                android:rotationY="20"
                android:src="@drawable/ic_trophy_svgrepo_com"/>

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="50dp"
                android:layout_marginLeft="40dp"
                android:alpha="0.2"
                android:rotationX="15"
                android:rotationY="25"
                android:src="@drawable/ic_trophy_svgrepo_com"/>

            <ImageView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="85dp"
                android:src="@drawable/ic_first_com" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/firstImageBack"
                android:layout_width="105dp"
                android:layout_height="105dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="130dp"
                android:src="@color/black" />


            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/firstImage"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="130dp"
                android:src="@drawable/ic_avatar_svgrepo_com" />

            <TextView
                android:id="@+id/firstName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:text="Raj Kishan"
                android:layout_marginTop="8dp"
                android:textColor="@color/white"
                android:textSize="@dimen/primary_text_size"
                android:fontFamily="@font/comfortaa"
                android:layout_below="@id/firstImage"/>

            <TextView
                android:id="@+id/firstPoint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:textStyle="bold"
                android:text="130"
                android:layout_marginTop="5dp"
                android:textColor="#F5DFFB"
                android:textSize="@dimen/LargeTitleSize"
                android:fontFamily="@font/comfortaa"
                android:layout_below="@id/firstName"/>

            <TextView
                android:id="@+id/firstTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:textStyle="bold"
                android:text="130"
                android:layout_marginTop="5dp"
                android:textColor="#F5DFFB"
                android:textSize="@dimen/tertiary_text_size"
                android:fontFamily="@font/comfortaa"
                android:layout_below="@id/firstPoint"/>

            <LinearLayout
                android:id="@+id/second"
                android:layout_width="110dp"
                android:orientation="vertical"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="110dp"
                    android:textAlignment="center"
                    android:textSize="@dimen/LargeTitleSize"
                    android:fontFamily="@font/poppins_light"
                    android:textColor="@color/white"
                    android:text="2nd"/>

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/secondImage"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:layout_marginLeft="15dp"
                    android:layout_centerVertical="true"
                    android:layout_marginTop="5dp"
                    android:src="@drawable/ic_avatar_svgrepo_com"/>

                <TextView
                    android:id="@+id/secondName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Krati "
                    android:textAlignment="center"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/white"
                    android:layout_marginLeft="5dp"
                    android:textSize="@dimen/tertiary_text_size"
                    android:fontFamily="@font/comfortaa"
                    android:layout_below="@id/secondImage"/>

                <TextView
                    android:id="@+id/secondPoint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:textStyle="bold"
                    android:text="128"
                    android:textAlignment="center"
                    android:layout_marginTop="5dp"
                    android:textColor="#F5DFFB"
                    android:textSize="@dimen/LargeTitleSize"
                    android:fontFamily="@font/comfortaa"
                    android:layout_below="@id/secondName"/>
                <TextView
                    android:id="@+id/secondTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:textStyle="bold"
                    android:text="128"
                    android:textAlignment="center"
                    android:layout_marginTop="5dp"
                    android:textColor="#F5DFFB"
                    android:textSize="@dimen/tertiary_text_size"
                    android:fontFamily="@font/comfortaa"
                    android:layout_below="@id/secondPoint"/>

            </LinearLayout>


            <LinearLayout
                android:id="@+id/third"
                android:layout_width="110dp"
                android:orientation="vertical"
                android:layout_alignParentRight="true"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3rd"
                    android:textColor="@color/white"
                    android:textAlignment="center"
                    android:fontFamily="@font/poppins_light"
                    android:layout_marginTop="110dp"
                    android:textSize="@dimen/LargeTitleSize"/>

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/thirdImage"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:layout_marginLeft="15dp"
                    android:layout_centerVertical="true"
                    android:layout_marginTop="5dp"
                    android:src="@drawable/ic_avatar_svgrepo_com"/>

                <TextView
                    android:id="@+id/thirdName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Aman Kumar"
                    android:textAlignment="center"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/white"
                    android:layout_marginLeft="5dp"
                    android:textSize="@dimen/tertiary_text_size"
                    android:fontFamily="@font/comfortaa"
                    android:layout_below="@id/thirdImage"/>

                <TextView
                    android:id="@+id/thirdPoint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:textStyle="bold"
                    android:text="126"
                    android:textAlignment="center"
                    android:layout_marginTop="5dp"
                    android:textColor="#F5DFFB"
                    android:textSize="@dimen/LargeTitleSize"
                    android:fontFamily="@font/comfortaa"
                    android:layout_below="@id/thirdName"/>

                <TextView
                    android:id="@+id/thirdTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:textStyle="bold"
                    android:text="126"
                    android:textAlignment="center"
                    android:layout_marginTop="5dp"
                    android:textColor="#F5DFFB"
                    android:textSize="@dimen/tertiary_text_size"
                    android:fontFamily="@font/comfortaa"
                    android:layout_below="@id/thirdPoint"/>

            </LinearLayout>



        </RelativeLayout>



    </androidx.cardview.widget.CardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/userPerformaceRecyclerview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/card"/>

</RelativeLayout>