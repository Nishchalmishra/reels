<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="90dp"
    android:orientation="vertical"
    app:cardCornerRadius="15dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/linearLayoutSubmitDoubt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/close_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_close_black"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">


            <!-- ── Top Banner Row ── -->
            <LinearLayout
                android:id="@+id/topRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="40dp"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/topLeftImage"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/submit_doubt_screen_image"
                    tools:ignore="ContentDescription" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="16dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-10dp"
                        android:layout_marginEnd="20dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/bubbleTail"
                            android:layout_width="12dp"
                            android:layout_height="21dp"
                            android:layout_marginTop="14dp"
                            android:elevation="2dp"
                            android:src="@drawable/bubble_tail_black"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:id="@+id/topText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="-1.75dp"
                            android:background="@drawable/bubble_speech_black"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:padding="12dp"
                            android:text="@string/question_enter_bubble_title"
                            android:textColor="#121212"
                            android:textSize="16sp" />

                    </LinearLayout>

                </FrameLayout>

            </LinearLayout>


            <TextView
                android:id="@+id/submit_doubt_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/urbanist_bold"
                android:gravity="center"
                android:visibility="gone"
                android:text="@string/get_the_solution_from_our_expert_tutors"
                android:textColor="@color/black"
                android:textSize="18sp" />


            <TextView
                android:id="@+id/information_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                android:layout_marginRight="20dp"
                android:text="@string/Apna_doubt_type_kare_or_paye_uska_Instant_solution"
                android:textAlignment="center"
                android:textIsSelectable="true"
                android:textSize="13sp"
                android:fontFamily="@font/urbanist_medium"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:theme="@style/Theme.MaterialComponents.DayNight.DarkActionBar">

                <TextView
                    android:id="@+id/your_doubt_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="20dp"
                    android:text="@string/Your_Doubt"
                    android:visibility="gone"
                    android:textIsSelectable="true"
                    android:textSize="12sp"
                    android:fontFamily="@font/urbanist_semi_bold"
                    android:textColor="@color/black"
                    android:layout_marginHorizontal="30dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/corrected_doubt_error"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/your_doubt_text"
                    android:layout_marginStart="30dp"
                    android:layout_marginEnd="30dp"
                    android:layout_marginBottom="10dp"
                    android:hint="@string/question_edit_placeholder"
                    android:inputType="text"
                    android:minHeight="80dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxStrokeColor="@color/navy_blue">

                    <EditText
                        android:id="@+id/corrected_doubt"
                        android:layout_width="match_parent"
                        android:layout_height="fill_parent"
                        android:drawablePadding="6dp"
                        android:fontFamily="@font/urbanist_regular"
                        android:inputType="textMultiLine"
                        android:minHeight="50dp"
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>


            </RelativeLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="30dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/dont_submit_doubt"
                    style="@style/tertiaryText"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/subscription_blue"
                    app:cardBackgroundColor="@color/color_transparent"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/urbanist_semi_bold"
                        android:paddingHorizontal="20dp"
                        android:gravity="center"
                        android:text="@string/resume_lecture"
                        android:textColor="@color/subscription_blue"
                        android:textSize="14sp" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/submit_my_doubt"
                    style="@style/tertiaryText"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="15dp"
                    app:cardBackgroundColor="@color/subscription_blue"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/submit_my_doubt_text"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/urbanist_semi_bold"
                        android:paddingHorizontal="20dp"
                        android:gravity="center"
                        android:text="@string/submit_question"
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>