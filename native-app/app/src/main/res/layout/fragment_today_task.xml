<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/today_classes_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".fragments.TodayTaskFragment">

    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp">

        <TextView
            android:id="@+id/title_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="3"
            android:fontFamily="@font/urbanist_bold"
            android:gravity="start"
            android:text="@string/today_s_classes"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="normal" />

        <HorizontalScrollView
            android:id="@+id/hs_countdown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/countdown_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginHorizontal="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/urbanist_semi_bold"
                    android:text="@string/ends_in"
                    android:textColor="@color/black"
                    android:textSize="10sp" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/hour_countdown_background"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    app:cardBackgroundColor="#D4F1E6"
                    app:cardCornerRadius="3dp"
                    app:cardElevation="0dp"
                    app:contentPaddingBottom="2dp"
                    app:contentPaddingLeft="4dp"
                    app:contentPaddingRight="4dp"
                    app:contentPaddingTop="2dp">

                    <TextView
                        android:id="@+id/hour_countdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="none"
                        android:fontFamily="@font/urbanist_bold"
                        android:gravity="center"
                        android:singleLine="false"
                        android:text="12h"
                        android:textColor="#28BC84"
                        android:textSize="9sp" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_marginBottom="2dp"
                    android:fontFamily="@font/urbanist_bold"
                    android:text=":"
                    android:textColor="@color/black" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/minute_countdown_background"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#D4F1E6"
                    app:cardCornerRadius="3dp"
                    app:cardElevation="0dp"
                    app:contentPaddingBottom="2dp"
                    app:contentPaddingLeft="4dp"
                    app:contentPaddingRight="4dp"
                    app:contentPaddingTop="2dp">

                    <TextView
                        android:id="@+id/minute_countdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="none"
                        android:fontFamily="@font/urbanist_bold"
                        android:gravity="center"
                        android:singleLine="false"
                        android:text="39m"
                        android:textColor="#28BC84"
                        android:textSize="9sp" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_marginBottom="2dp"
                    android:fontFamily="@font/urbanist_bold"
                    android:text=":"
                    android:textColor="@color/black" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/second_countdown_background"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#D4F1E6"
                    app:cardCornerRadius="3dp"
                    app:cardElevation="0dp"
                    app:contentPaddingBottom="2dp"
                    app:contentPaddingLeft="4dp"
                    app:contentPaddingRight="4dp"
                    app:contentPaddingTop="2dp">

                    <TextView
                        android:id="@+id/second_countdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="none"
                        android:fontFamily="@font/urbanist_bold"
                        android:gravity="center"
                        android:singleLine="false"
                        android:text="47s"
                        android:textColor="#28BC84"
                        android:textSize="9sp" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/ll_see_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_see_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:fontFamily="@font/urbanist_semi_bold"
                android:gravity="start"
                android:text="@string/see_all"
                android:textColor="#1EA6B3"
                android:textSize="14sp"
                android:textStyle="normal" />

            <ImageView
                android:id="@+id/iv_see_all"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="5dp"
                android:contentDescription="@string/see_all"
                android:src="@drawable/img_arrow_forward"
                app:tint="#1EA6B3" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_sub_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header_layout"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_today_task_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:fontFamily="@font/urbanist_medium"
            android:gravity="start"
            android:text="@string/today_s_classes"
            android:textColor="@color/gray_8e"
            android:textSize="15sp"
            android:textStyle="normal" />

        <ImageView
            android:id="@+id/iv_today_task_status"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="8dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_info_24"
            app:tint="@color/arivihan_secondary_color" />

    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/ll_sub_title"
        >

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/today_class_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:scrollbars="none"
            tools:itemCount="5"
            android:layout_centerInParent="true"
            tools:listitem="@layout/classes_live_layout"
            android:requiresFadingEdge="horizontal"
            android:fadingEdgeLength="2dp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_left_scroll"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:rotation="180"
                android:scaleType="centerCrop"
                android:src="@drawable/right_arrow"
                app:tint="@color/black" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_right_scroll"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:rotation="0"
                android:scaleType="centerCrop"
                android:src="@drawable/right_arrow"
                app:tint="@color/black" />
        </androidx.cardview.widget.CardView>

    </RelativeLayout>



</RelativeLayout>