<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:theme="@style/Theme.MaterialComponents.Light"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:minWidth="250dp"
        android:gravity="center">

        <ImageView
            android:id="@+id/cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:src="@drawable/ic_close_black"
            android:layout_gravity="end"/>
        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/urbanist_semi_bold"
            android:gravity="center"
            android:text="@string/dont_leave"
            android:textSize="20sp"
            android:visibility="gone"
            android:textColor="@color/black"
            android:layout_marginTop="-20dp"
            android:layout_marginHorizontal="20dp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="40dp"/>


        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/dialog_animation"
            android:layout_width="180dp"
            android:layout_height="180dp"
            app:lottie_rawRes="@raw/lock_popup"
            app:lottie_loop="true"
            app:lottie_autoPlay="true"
            android:layout_marginTop="-60dp"/>


        <TextView
            android:id="@+id/header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/urbanist_medium"
            android:gravity="center"
            android:text="@string/OOpsThisMicroIsLocked"
            android:textColor="#696969"
            android:textSize="16sp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="-10dp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="25dp"/>



        <com.google.android.material.card.MaterialCardView
            android:id="@+id/subscriptionLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/mock_primary_color"
            app:cardCornerRadius="8dp"
            android:layout_marginBottom="25dp"
            app:cardElevation="0dp"
            android:layout_marginHorizontal="20dp">


            <TextView
                android:id="@+id/subs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp"
                android:layout_marginHorizontal="20dp"
                android:fontFamily="@font/urbanist_semi_bold"
                android:text="@string/view_plans"
                android:textColor="@color/white"
                android:textSize="16sp"/>

        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>


</com.google.android.material.card.MaterialCardView>