<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:clickable="true"
    android:focusable="true"
    android:elevation="50dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <LinearLayout
            android:id="@+id/drawer_header"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:gravity="center"
            android:paddingHorizontal="18dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/icon_chat_avatar" />

            <TextView
                android:id="@+id/chat_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:fontFamily="@font/urbanist_medium"
                android:text="Radhika"
                android:textSize="18dp"
                android:textColor="#191919"/>

            <View
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/drawer_new_chat_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/finish_button_border"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/urbanist_semi_bold"
                    android:text="@string/new_chat"
                    android:textColor="@color/black"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:layout_above="@id/subscription_layout"
                android:layout_below="@id/drawer_header"
                android:layout_marginBottom="50dp">

                <TextView
                    android:id="@+id/previous_chat_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/urbanist_regular"
                    android:text="@string/previous_chats"
                    android:textColor="#696969"
                    android:textSize="13sp"
                    android:visibility="gone"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/previous_doubts_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:listitem="@layout/doubt_categorization"
                    android:layout_marginTop="-25dp"/>


            </LinearLayout>

<!--            android:layout_below="@id/previous_chat_scroll"-->
<!--            android:background="@drawable/border_chat_choose_subject_teal"-->
<!--            android:orientation="vertical"-->
<!--            android:padding="8dp"-->
        <androidx.cardview.widget.CardView
            android:id="@+id/chat_history_btn"
            android:layout_above="@id/subscription_layout"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            app:cardBackgroundColor="#D3F8FA"
            app:cardCornerRadius="18dp"
            app:contentPadding="8dp"
            app:cardElevation="0dp"
            android:layout_marginHorizontal="18dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/see_all"
                android:layout_gravity="center"
                android:fontFamily="@font/urbanist_medium"
                android:textColor="@color/black"
                android:textSize="14dp"
                />
        </androidx.cardview.widget.CardView>

        <RelativeLayout
            android:id="@+id/subscription_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_margin="18dp"
            android:orientation="vertical">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:scaleType="fitCenter"
                android:src="@drawable/background_doubt_chat_subscribe"
                />
            <View
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="#E9FBFC"
                android:alpha="0.4"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/border_doubt_chat_suscribe_teal"
                android:orientation="vertical"
                android:padding="18dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/urbanist_medium"
                    android:text="@string/drawer_subscribe_message"
                    android:textColor="@color/black"
                    android:textSize="13dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#26C6DA"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="0dp"
                    android:id="@+id/subscribe_now_btn">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/urbanist_medium"
                        android:paddingHorizontal="14sp"
                        android:paddingVertical="6sp"
                        android:text="@string/subscribe_now"
                        android:textColor="@color/white"
                        android:textSize="13dp" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>


        </RelativeLayout>

    </RelativeLayout>

</RelativeLayout>