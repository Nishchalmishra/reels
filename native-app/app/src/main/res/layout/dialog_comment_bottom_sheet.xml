<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_parent_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amp_transparent">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_parent_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <RelativeLayout
                android:id="@+id/rl_comment_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:visibility="visible"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_above="@id/ll_bottom_layout"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_gravity="center_vertical"
                            android:fontFamily="@font/nunito_bold"
                            android:text="@string/comments"
                            android:textAllCaps="false"
                            android:textColor="@color/black"
                            android:textSize="22sp"
                            android:textStyle="normal" />

                        <ImageView
                            android:id="@+id/iv_close"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:padding="12dp"
                            android:src="@drawable/close"
                            app:tint="@color/black" />

                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="16dp"
                        android:background="#ECECEC" />

                    <ProgressBar
                        android:id="@+id/pb_loading"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_marginTop="-4dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/arivihan_secondary_color"
                        android:visibility="visible" />

                    <TextView
                        android:id="@+id/tv_no_comments"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="24dp"
                        android:fontFamily="@font/nunito_medium"
                        android:text="@string/no_comments_yet"
                        android:textAllCaps="false"
                        android:textColor="#979797"
                        android:textSize="22sp"
                        android:textStyle="normal" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_comments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:paddingTop="8dp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_bottom_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="16dp"
                        android:background="#ECECEC" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="16dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        app:cardBackgroundColor="#F2F2F2"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="12dp"
                            android:paddingEnd="4dp">

                            <EditText
                                android:id="@+id/et_comment"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_toStartOf="@id/rl_send"
                                android:background="@color/amp_transparent"
                                android:fontFamily="@font/nunito_regular"
                                android:gravity="top|start"
                                android:hint="@string/aapka_feedback_dein"
                                android:imeOptions="actionDone"
                                android:inputType="textMultiLine"
                                android:maxLines="3"
                                android:minLines="1"
                                android:overScrollMode="always"
                                android:paddingHorizontal="15dp"
                                android:paddingVertical="10dp"
                                android:scrollbars="vertical"
                                android:textColor="@color/black"
                                android:textColorHint="#D2D2D2"
                                android:textSize="@dimen/primary_text_size" />

                            <RelativeLayout
                                android:id="@+id/rl_send"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true">

                                <ImageView
                                    android:id="@+id/iv_send"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_centerInParent="true"
                                    android:padding="5dp"
                                    android:src="@drawable/img_send_share_filled"
                                    android:visibility="visible"
                                    app:tint="#25C6DA" />

                                <ProgressBar
                                    android:id="@+id/pb_send"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_centerInParent="true"
                                    android:indeterminateTint="@color/arivihan_secondary_color"
                                    android:visibility="gone" />

                            </RelativeLayout>

                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/ll_doubt_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_centerInParent="true"
                android:visibility="gone"
                >

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:id="@+id/iv_doubt_back"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:padding="12dp"
                        android:src="@drawable/arrow_icon"
                        app:tint="@color/black"
                        android:layout_marginStart="-8dp"
                        />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="24dp"
                        android:layout_marginEnd="0dp"
                        >
                        <androidx.cardview.widget.CardView
                            android:id="@+id/cv_profile"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            app:cardBackgroundColor="@color/arivihan_secondary_color"
                            app:cardElevation="0dp"
                            app:cardCornerRadius="150dp"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            >

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                >
                                <TextView
                                    android:id="@+id/tv_initials"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_gravity="center"
                                    android:fontFamily="@font/inter_bold"
                                    android:maxLength="2"
                                    android:maxLines="1"
                                    android:text="AR"
                                    android:textAllCaps="true"
                                    android:textColor="@color/white"
                                    android:gravity="center"
                                    android:textSize="16sp"
                                    android:textStyle="normal" />

                                <ImageView
                                    android:id="@+id/iv_profile_img"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_gravity="center"
                                    android:scaleType="centerCrop"
                                    />
                            </RelativeLayout>

                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:id="@+id/tv_user_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:fontFamily="@font/nunito_bold"
                            android:text="@string/comments"
                            android:textAllCaps="false"
                            android:textColor="@color/black"
                            android:textSize="22sp"
                            android:textStyle="normal"
                            android:gravity="center_vertical"
                            android:layout_marginStart="0dp"
                            android:layout_marginEnd="40dp"
                            />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iv_doubt_close"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:padding="12dp"
                        android:src="@drawable/close"
                        app:tint="@color/black" />

                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="#ECECEC" />

                <ProgressBar
                    android:id="@+id/pb_doubt_loading"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="-4dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/arivihan_secondary_color"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/tv_no_comments_doubt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/nunito_medium"
                    android:text="@string/no_comments_yet"
                    android:textAllCaps="false"
                    android:textColor="#979797"
                    android:textSize="22sp"
                    android:textStyle="normal" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_doubt_comments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:paddingTop="8dp" />

            </LinearLayout>
        </RelativeLayout>


    </androidx.cardview.widget.CardView>

</RelativeLayout>