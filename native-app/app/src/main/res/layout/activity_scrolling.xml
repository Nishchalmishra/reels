<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ScrollingActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:elevation="16dp"
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_bar_height"
        android:background="@drawable/theme_gradient_color"
        android:theme="@style/ArivihanTheme.AppBarOverlay">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/toolbar_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="16dp"
            app:titleEnabled="false"
            app:contentScrim="?attr/colorPrimary"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:toolbarId="@+id/toolbar">
            <TextView
                android:paddingTop="65dp"
                android:paddingStart="15dp"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.4"
                android:textSize="18sp"
                android:id="@+id/tx1"
                android:layout_marginStart="10dp"
                style="@style/TitleTextStyle"
                android:text="@string/hi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:ignore="RtlSymmetry" />

            <androidx.appcompat.widget.Toolbar
                app:logo="@drawable/ic_doubtbuzter"
                style="@style/whiteBolText"
                app:titleTextAppearance="@style/TitleTextStyle"
                app:title="@string/arivihan"
                android:background="@drawable/theme_gradient_color"
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:popupTheme="@style/Arivihan.Toolbar" />


        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <include layout="@layout/content_scrolling" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:visibility="gone"
        android:id="@+id/navigation"
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/windowBackground"
        android:foreground="?attr/selectableItemBackground"
        android:theme="@style/Widget.BottomNavigationView"
        app:itemIconSize="20sp"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="#015757"
        app:itemTextAppearanceActive="@style/Platform.MaterialComponents"
        app:itemTextColor="#015757"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:menu="@menu/navigation" />

    <com.google.android.material.bottomappbar.BottomAppBar
        android:elevation="18dp"
        android:id="@+id/bottomAppBar"
        style="@style/Arivihan.BottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hideOnScroll="true"
        android:outlineAmbientShadowColor="@color/grey_500"
        android:outlineSpotShadowColor="@color/grey_500"
        android:layout_gravity="bottom"
        app:menu="@menu/menu_scrolling"
        android:backgroundTint="@color/white"
        app:fabCradleRoundedCornerRadius="45dp"
        app:navigationIcon="@drawable/ic_home_24" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:hideOnScroll="true"
        android:backgroundTint="@color/arivihan_secondary_color"
        app:layout_anchor="@id/bottomAppBar"
        app:srcCompat="@drawable/ic_add_24" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>