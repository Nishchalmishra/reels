<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:id="@+id/bottom_account_nav"
    android:background="@drawable/bottomcontact"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragments.AccountMigrationFragment">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/comfortaa"
        android:text="@string/AreYouAExistingUser"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="@dimen/LargeTitleSize" />

    <TextView
        android:id="@+id/sub_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/title"
        android:layout_marginLeft="12dp"
        android:textColor="@color/black"
        android:layout_marginTop="18dp"
        android:layout_marginRight="12dp"
        android:text="@string/linkAccountMessage"
        android:textSize="@dimen/secondary_text_size" />

    <TextView
        android:id="@+id/sub_title2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/sub_title"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="6dp"
        android:textColor="@color/black"
        android:textSize="@dimen/secondary_text_size"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="10dp"
        android:text="@string/linkAccountMessageImp"
        android:textStyle="bold" />



    <androidx.cardview.widget.CardView
        android:id="@+id/migrate"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_below="@id/sub_title2"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/StartActivityButton"
        android:layout_margin="20dp"
        app:cardElevation="0dp"
        >

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/LinkAccount"
                android:textColor="@color/white"
                android:textSize="@dimen/LargeTitleSize" />

        </RelativeLayout>

        <com.github.ybq.android.spinkit.SpinKitView
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:visibility="gone"
            style="@style/SpinKitView.FadingCircle"
            android:layout_below="@id/sub_title"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="40dp"
            app:SpinKit_Color="#19B0C1"
            android:layout_marginTop="25dp"/>

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/skip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/migrate"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="30dp"
        android:text="Skip"
        android:textColor="@color/navy_blue"
        android:textSize="@dimen/secondary_text_size"
        android:textStyle="bold" />

</RelativeLayout>