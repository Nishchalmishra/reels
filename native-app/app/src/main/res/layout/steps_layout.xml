<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.MaterialComponents.DayNight.DarkActionBar"
    android:orientation="horizontal">

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/steps_progress"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:trackThickness="1.5dp"
        app:indicatorColor="@color/mock_primary_color"
        app:trackColor="#D1D5DB"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/step_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <arivihan.technologies.doubtbuzzter2.customView.CustomStepView
            android:id="@+id/step_1"
            android:layout_width="20dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <arivihan.technologies.doubtbuzzter2.customView.CustomStepView
            android:id="@+id/step_2"
            android:layout_width="20dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toEndOf="@id/step_1"
            app:layout_constraintEnd_toStartOf="@id/step_3"/>

        <arivihan.technologies.doubtbuzzter2.customView.CustomStepView
            android:id="@+id/step_3"
            android:layout_width="20dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <arivihan.technologies.doubtbuzzter2.customView.CustomStepView
            android:id="@+id/step_4"
            android:layout_width="20dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toEndOf="@id/step_3"
            app:layout_constraintEnd_toStartOf="@id/step_5"/>

        <arivihan.technologies.doubtbuzzter2.customView.CustomStepView
            android:id="@+id/step_5"
            android:layout_width="20dp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>