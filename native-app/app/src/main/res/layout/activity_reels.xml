<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reels_root"
    android:layout_width="match_parent"
    android:background="@drawable/splash_background"
    android:keepScreenOn="true"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ReelsActivity">
    <!--    android:background="#2C2C2C"-->

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager_reel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#70000000"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="16dp" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/off_white"
        android:clickable="true"
        android:contentDescription="@string/submit"
        android:elevation="@dimen/card_elevation"
        android:focusable="true"
        android:src="@drawable/house_chimney__4_"
        app:borderWidth="0dp"
        app:cardUseCompatPadding="true"
        app:rippleColor="@color/grey_100" />

    <com.airbnb.lottie.LottieAnimationView
        android:layout_centerInParent="true"
        android:id="@+id/lottie"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:visibility="gone"
        app:lottie_rawRes="@raw/lottie_loader"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"/>

<!--    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="22dp"
        android:src="@drawable/sign_in_logo_smaller" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        style="@style/primaryText"
        android:textSize="16sp"
        android:textColor="@color/dark_grey"
        android:fontFamily="@font/opensans_bold"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="10dp"/>-->
</RelativeLayout>
