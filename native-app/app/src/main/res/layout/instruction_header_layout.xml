<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:id="@+id/instruction_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginVertical="5dp">

        <TextView
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginRight="8dp"
            android:layout_toRightOf="@+id/postNumber"
            android:fontFamily="@font/nunito_bold"
            android:text="Header Layout Text"
            android:textColor="@color/black"
            android:textSize="@dimen/primary_text_size" />

        <TextView
            android:id="@+id/postNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:fontFamily="@font/nunito_bold"
            android:text=""
            android:textColor="@color/black"
            android:textSize="16sp"/>


    </RelativeLayout>


    <androidx.cardview.widget.CardView
        android:id="@+id/instruction_detail_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/instruction_header"
        app:cardBackgroundColor="@color/mock_lightest_grey"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        android:layout_marginTop="6dp"
        app:contentPadding="16dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerview_instruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/header"
             />

    </androidx.cardview.widget.CardView>

</RelativeLayout>