<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    android:layout_gravity="center">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="18dp">

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_margin="4dp"
            android:src="@drawable/close_dark_grey"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- Title -->
        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Welcome to NEET!"
            android:textColor="@color/black"
            android:textSize="22sp"
            android:fontFamily="@font/urbanist_semi_bold"
            android:gravity="center"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/btnClose"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Warning Animation -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/animation"
            android:layout_width="150dp"
            android:layout_height="180dp"
            app:lottie_rawRes="@raw/practice_alert"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Aapko NEET mode me switch kar diya gaya hai. Aap upar diye gaye button se kabhi bhi 12th Board par wapas ja sakte ho."
            android:textColor="#6F6F6F"
            android:textSize="20sp"
            android:gravity="center"
            android:fontFamily="@font/urbanist_medium"
            app:layout_constraintTop_toBottomOf="@id/animation"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Button -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_okay"
            android:layout_width="0dp"
            android:layout_height="52dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#26C6DA"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/bnt_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="OK, Understood"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:fontFamily="@font/urbanist_semi_bold"
                android:gravity="center"/>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>