<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.ToDoListSteps"
    android:background="#F3FFFF">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/on_boarding_background_new">

        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            android:paddingEnd="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_alignParentTop="true"
            android:visibility="visible">


            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:layout_marginEnd="12dp"
                android:indeterminate="false"
                android:layout_marginStart="30dp"
                android:progress="30"
                app:indicatorColor="#26C6DA"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_weight="1"
                app:trackColor="#E0F8F9"
                app:trackCornerRadius="20dp"
                app:trackThickness="12dp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_volume"
                android:layout_width="34dp"
                android:layout_height="34dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="17dp"
                app:cardElevation="1dp"
                android:layout_marginHorizontal="6dp"
                android:layout_marginVertical="6dp"
                android:layout_gravity="center"
                >

                <ImageView
                    android:id="@+id/iv_volume"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/img_volume_high"
                    app:tint="@color/black"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:padding="6dp"
                    />

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:layout_below="@id/toolbar"
            android:layout_above="@id/bottom_layout"
            android:paddingTop="20dp"
            android:paddingHorizontal="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include
                    layout="@layout/onboarding_shimmer_layout"/>
            </LinearLayout>

        </com.facebook.shimmer.ShimmerFrameLayout>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_container_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/toolbar"
            android:layout_marginTop="-8dp"
            android:layout_above="@id/bottom_layout"
            android:layout="@layout/fragment_to_do_step_subject_selection"
            android:layout_marginBottom="8dp"
            android:visibility="visible"/>

        <LinearLayout
            android:id="@+id/bottom_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:paddingTop="20dp"
            android:layout_alignParentBottom="true"
            android:visibility="visible">

            <androidx.cardview.widget.CardView
                android:id="@+id/previous_card"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_margin="6dp"
                app:cardBackgroundColor="@color/subscription_blue"
                app:cardCornerRadius="25dp"
                app:cardElevation="3dp">

                <ImageView
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_gravity="center"
                    android:src="@drawable/previous" />
            </androidx.cardview.widget.CardView>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center">
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/next_card"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_margin="6dp"
                app:cardBackgroundColor="@color/disabled_next_color"
                app:cardCornerRadius="25dp"
                app:cardElevation="3dp">

                <ImageView
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_gravity="center"
                    android:src="@drawable/next" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </RelativeLayout>

</LinearLayout>
