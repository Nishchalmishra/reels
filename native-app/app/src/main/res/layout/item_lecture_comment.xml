<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rl_parent"
    android:background="@color/white"
    android:orientation="vertical"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="15dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/color_transparent"
        android:layout_margin="4dp"
        >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/cv_options"
                android:orientation="horizontal"
                >
                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_profile"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    app:cardBackgroundColor="@color/arivihan_secondary_color"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="150dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginEnd="12dp"
                    >

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        >
                        <TextView
                            android:id="@+id/tv_initials"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:fontFamily="@font/inter_bold"
                            android:maxLength="2"
                            android:maxLines="1"
                            android:text="AR"
                            android:textAllCaps="true"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:textSize="16sp"
                            android:textStyle="normal" />

                        <ImageView
                            android:id="@+id/iv_profile_img"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:scaleType="centerCrop"
                            />
                    </RelativeLayout>

                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="4dp"
                    android:layout_marginEnd="2dp"
                    >

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        >
                        <TextView
                            android:id="@+id/tv_user_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/urbanist_bold"
                            android:text="-"
                            android:textAllCaps="false"
                            android:textColor="#70747E"
                            android:textSize="11sp"
                            android:textStyle="normal"
                            android:visibility="visible"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:layout_centerVertical="true"
                            />
                        <TextView
                            android:id="@+id/tv_dot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/urbanist_bold"
                            android:text="."
                            android:textAllCaps="false"
                            android:textColor="#70747E"
                            android:textSize="15sp"
                            android:textStyle="normal"
                            android:visibility="gone"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:layout_marginHorizontal="4dp"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="0dp"
                            android:layout_marginTop="-5dp"
                            android:layout_toEndOf="@id/tv_user_name"
                            />
                        <TextView
                            android:id="@+id/tv_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/urbanist_bold"
                            android:text=""
                            android:textAllCaps="false"
                            android:textColor="#70747E"
                            android:textSize="11sp"
                            android:textStyle="normal"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:visibility="visible"
                            android:layout_toEndOf="@id/tv_dot"
                            android:layout_centerVertical="true"
                            />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/tv_comment_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/urbanist_bold"
                        android:text="text here..."
                        android:textAllCaps="false"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="normal"
                        android:layout_gravity="center_vertical"
                        />

                </LinearLayout>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_options"
                android:layout_width="16dp"
                android:layout_height="30dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/amp_transparent"
                app:cardCornerRadius="50dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                >
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="20dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_dots_filled"
                    app:tint="#A39B9B"
                    />
            </androidx.cardview.widget.CardView>

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_nested_comments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:listitem="@layout/item_lecture_nested_comment"
        tools:itemCount="1"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="-4dp"
        />

</LinearLayout>