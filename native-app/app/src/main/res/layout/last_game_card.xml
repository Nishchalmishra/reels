<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/purple_card"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="@color/purple_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp"
    >
    <RelativeLayout
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:id="@+id/rltext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/gamename"
                android:textColor="@color/white"
                style="@style/secondaryText"
                android:layout_marginTop="5dp"
                android:layout_marginStart="15dp"
                android:text="@string/first_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:layout_marginEnd="20dp"
                android:textStyle="bold"
                android:layout_alignParentEnd="true"
                android:id="@+id/syllabus"
                android:textColor="#FEDF28"
                style="@style/secondaryText"
                android:layout_marginTop="5dp"
                android:layout_marginStart="25dp"
                android:text="@string/syllabus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RelativeLayout>



        <LinearLayout
            android:id="@+id/rl1"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="15dp"
            android:layout_below="@id/rltext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/img1"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/ic_coin_rect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:id="@+id/l1"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/score"
                        android:textSize="25sp"
                        android:text="230"
                        android:textColor="#FEDF28"
                        android:textStyle="bold"
                        style="@style/primaryText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/time"
                        style="@style/secondaryText"
                        android:text="03:04 mins"
                        android:textColor="#FEDF28"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

            </LinearLayout>



        </LinearLayout>



        <LinearLayout
            android:layout_below="@id/rl1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <LinearLayout
                android:id="@+id/instruction"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content">

                <ImageView
                    android:src="@drawable/ic_instructions_icon"
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"/>

                <TextView
                    android:textColor="@color/white"
                    android:textSize="@dimen/small_text_size"
                    android:text="@string/instructions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>


            </LinearLayout>

            <LinearLayout
                android:id="@+id/leaderboard"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content">

                <ImageView
                    android:src="@drawable/ic_trophy_icon_final"
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"/>

                <TextView
                    android:textColor="@color/white"
                    android:textSize="@dimen/small_text_size"
                    android:text="@string/leaderboard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>


            </LinearLayout>

            <LinearLayout
                android:id="@+id/review"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content">

                <ImageView
                    android:src="@drawable/ic_review_icon"
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"/>

                <TextView
                    android:textColor="@color/white"
                    android:textSize="@dimen/small_text_size"
                    android:text="@string/review"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>


            </LinearLayout>


        </LinearLayout>


    </RelativeLayout>
</androidx.cardview.widget.CardView>