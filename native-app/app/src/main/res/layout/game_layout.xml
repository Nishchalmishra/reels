<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gamegradient"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <RelativeLayout
        android:id="@+id/ParentRelativeLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <ImageView
        android:id="@+id/help"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_game_help"
        android:layout_margin="10dp"
        android:paddingTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"/>


    <TextView
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/comfortaa"
        android:text="@string/FormaStreakOf"
        android:textAlignment="center"
        android:textColor="#02CA8E"
        android:textStyle="bold"
        android:layout_marginBottom="80dp"
        android:textSize="@dimen/primary_text_size"
        app:layout_constraintBottom_toTopOf="@+id/relativeLayout5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <RelativeLayout
        android:id="@+id/relativeLayout5"
        android:layout_width="230dp"
        android:layout_height="220dp"
        app:layout_constraintBottom_toBottomOf="@+id/ParentRelativeLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="80dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:paddingLeft="70dp"
            android:src="@drawable/ic_game_trophy" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:paddingTop="50dp"
            android:paddingRight="80dp"
            android:src="@drawable/ic_game_controller" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/relativeLayout40"
        android:layout_width="300dp"
        android:layout_height="280dp"
        android:layout_marginBottom="80dp"
        app:layout_constraintBottom_toBottomOf="@+id/ParentRelativeLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <com.airbnb.lottie.LottieAnimationView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:lottie_rawRes="@raw/game_particle"
            android:layout_centerInParent="true"
            app:lottie_loop="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_autoPlay="true"/>


    </RelativeLayout>


    <TextView
        android:id="@+id/points"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TO WIN : 10"
        app:layout_constraintTop_toBottomOf="@+id/relativeLayout5"
        android:textAlignment="center"
        android:textSize="@dimen/primary_text_size"
        android:shadowDx="0.0"
        android:padding="5dp"
        android:shadowDy="0.0"
        android:shadowRadius="8"
        android:shadowColor="@color/red"
        android:layout_marginTop="25dp"
        android:textColor="#87F9F0" />

    <TextView
        android:id="@+id/level"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Level 2"
        android:fontFamily="@font/poppins_light"
        android:textStyle="bold"
        android:textAlignment="center"
        android:textSize="@dimen/LargeTitleSize"
        app:layout_constraintTop_toBottomOf="@+id/points"
        android:shadowRadius="8"
        android:layout_marginTop="20dp"
        android:textColor="#F6D83E" />


    <RelativeLayout
        android:id="@+id/play"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/ic_game_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="50dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/btn_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/comfortaa"
            android:text="@string/play"
            android:textColor="#8AFCFD"
            android:textSize="@dimen/primary_text_size"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_lock"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_centerInParent="true"
            android:src="@drawable/ic_lock" />

    </RelativeLayout>



</androidx.constraintlayout.widget.ConstraintLayout>