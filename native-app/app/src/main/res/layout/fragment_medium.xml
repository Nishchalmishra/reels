<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".fragments.MediumFragment">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="40dp"
        android:visibility="gone">
        <include layout="@layout/onboarding_shimmer_layout" />
    </com.facebook.shimmer.ShimmerFrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- ── Top Banner Row ── -->
            <LinearLayout
                android:id="@+id/topRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:background="@drawable/gradient_navy_blue"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="-20dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Character illustration (left) -->
                <ImageView
                    android:id="@+id/topLeftImage"
                    android:layout_width="197dp"
                    android:layout_height="168dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="-20dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/medium_screen_image"
                    tools:ignore="ContentDescription" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="-70dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="-10dp"
                    android:clipChildren="false">

                    <!-- Speech bubble row (tail + text) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="40dp"
                        android:layout_marginEnd="20dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/bubbleTail"
                            android:layout_width="12dp"
                            android:layout_height="21dp"
                            android:layout_marginTop="14dp"
                            android:elevation="2dp"
                            android:src="@drawable/bubble_tail"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:id="@+id/topText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="-1.75dp"
                            android:background="@drawable/bubble_speech"
                            android:fontFamily="@font/urbanist_medium"
                            android:padding="12dp"
                            android:text="Apne baare mein batayein aur Topper ke Notes paayein!"
                            android:textColor="#000000"
                            android:textSize="16sp" />

                    </LinearLayout>

                    <!--
                        Bird: top-right corner, just above the bubble.
                        layout_gravity="top|end" places it at the
                        top-right of the FrameLayout.
                        Negative marginEnd lets it poke slightly beyond
                        the column edge; adjust marginEnd/Top to taste.
                    -->
                    <ImageView
                        android:id="@+id/birdImage"
                        android:layout_width="90dp"
                        android:layout_height="50dp"
                        android:layout_gravity="top|end"
                        android:layout_marginEnd="-4dp"
                        android:layout_marginTop="0dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/medium_screen_image_2"
                        android:elevation="4dp"
                        tools:ignore="ContentDescription" />

                </FrameLayout>

            </LinearLayout>

            <ImageView
                android:id="@+id/cloudImage"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:scaleType="fitXY"
                android:elevation="5dp"
                android:layout_marginTop="-27dp"
                android:src="@drawable/medium_screen_image_3"
                tools:ignore="ContentDescription"
                app:layout_constraintTop_toBottomOf="@id/topRow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- ── Bottom Section ── -->
            <LinearLayout
                android:id="@+id/bottomSection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:layout_marginHorizontal="20dp"
                android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/cloudImage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">


                <TextView
                    android:id="@+id/step_text_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-10dp"
                    android:fontFamily="@font/urbanist_medium"
                    android:text="Aap हिंदी माध्यम se hain ya English medium se ?"
                    android:textColor="#191919"
                    android:textSize="22sp" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/card_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/medium_rv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="2"
                        tools:listitem="@layout/class_item" />

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>