<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dialogContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <androidx.cardview.widget.CardView
        android:id="@+id/main_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_below="@id/cv_close"
        android:layout_marginVertical="12dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:id="@+id/doubt_loading_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:padding="16dp">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/doubt_loading_animation"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/doubt_loading" />

            <TextSwitcher
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:inAnimation="@anim/slide_in"
                android:outAnimation="@android:anim/slide_out_right"
                android:paddingHorizontal="12dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_doubt_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone"
            android:background="@android:color/white">

            <TextView
                android:id="@+id/tv_options_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/choose_an_option"
                android:textSize="18sp"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="10dp"
                android:textColor="@color/black"
                android:fontFamily="@font/urbanist_bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_doubt_options"
                android:layout_width="match_parent"
                android:paddingBottom="10dp"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        </LinearLayout>

        <WebView
            android:id="@+id/wvContent"
            android:layout_width="match_parent"
            android:layout_height="600dp"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone"
            tools:ignore="WebViewLayout" />

    </androidx.cardview.widget.CardView>

    <!-- Centered Close Button at Top -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:background="@color/color_transparent"
        app:cardCornerRadius="15dp"
        app:cardElevation="10dp"
        android:layout_centerHorizontal="true"
        app:cardBackgroundColor="@android:color/white">

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:padding="6dp"
            android:src="@drawable/close_filled_icon"
            android:contentDescription="@string/close" />
    </androidx.cardview.widget.CardView>



</RelativeLayout>