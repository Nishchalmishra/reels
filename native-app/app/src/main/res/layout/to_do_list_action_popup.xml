<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    android:layout_marginHorizontal="50dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/close_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="7dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/search_close_btn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="20dp"
            app:layout_constraintTop_toBottomOf="@id/close_btn">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/urbanist_semi_bold"
                android:text="@string/dont_leave"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/animation"
                android:layout_width="110dp"
                android:layout_height="120dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/alert"
                android:scaleX="1.5"
                android:scaleY="1.5"
                android:layout_marginVertical="10dp"
                android:visibility="visible"/>

            <ImageView
                android:id="@+id/selection_image"
                android:layout_width="150dp"
                android:layout_height="160dp"
                android:src="@drawable/selection_image"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/urbanist_medium"
                android:gravity="center"
                android:text="@string/changes_save_nahi_honge"
                android:textColor="#696969"
                android:textSize="15sp"
                android:layout_marginHorizontal="30dp"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/btn1"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#E9FBFC"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                android:layout_marginTop="20dp">

                <TextView
                    android:id="@+id/btn1_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/urbanist_semi_bold"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:text="@string/leave_anyway"
                    android:textColor="#26C6DA"
                    android:textSize="12sp" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btn2"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#26C6DA"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/btn2_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/urbanist_semi_bold"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:text="@string/Continue"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>