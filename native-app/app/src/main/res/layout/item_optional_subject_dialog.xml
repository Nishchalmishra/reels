<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container_optional_subject"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/border_optional_subject_unselected"
    android:orientation="horizontal"
    android:padding="12dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_optional_subject_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical"
        app:cardBackgroundColor="@color/gray_f6"
        app:cardCornerRadius="7dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/iv_optional_subject_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center"
            android:layout_margin="6dp" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_optional_subject_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/urbanist_medium"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="normal" />

    <!-- Radio button — shown when limit == 1 (single-select mode) -->
    <ImageView
        android:id="@+id/iv_radio_indicator"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="4dp"
        android:src="@drawable/ic_radio_unselected_teal"
        android:visibility="gone" />

    <!-- Checkbox — shown when limit > 1 (multi-select mode) -->
    <ImageView
        android:id="@+id/iv_checkbox_indicator"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="4dp"
        android:src="@drawable/ic_checkbox_unselected_teal"
        android:visibility="gone" />

</LinearLayout>
