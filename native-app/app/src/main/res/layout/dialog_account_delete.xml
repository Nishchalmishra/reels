<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="340dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                tools:ignore="MissingConstraints">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/urbanist_bold"
                    android:paddingHorizontal="10dp"
                    android:layout_marginHorizontal="10dp"
                    android:text="@string/empty"
                    android:textColor="@color/black"
                    android:textSize="22sp"
                    android:gravity="center"/>


                <ImageView
                    android:id="@+id/center_img"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginVertical="30dp"
                    android:layout_marginHorizontal="120dp"
                    android:src="@drawable/ic_warning_delete"
                    android:contentDescription="@string/todo"/>


                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:fontFamily="@font/urbanist_medium"
                    android:gravity="center"
                    android:text="@string/empty"
                    android:textColor="#696969"
                    android:textSize="17sp"/>


                <LinearLayout
                    android:id="@+id/button_layout"
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:layout_marginTop="30dp"
                    android:layout_height="wrap_content">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cv_primary"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/arivihan_secondary_color"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/tx_primary"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/urbanist_bold"
                            android:gravity="center"
                            android:paddingHorizontal="20dp"
                            android:paddingVertical="12dp"
                            android:text="@string/cancel"
                            android:textColor="@color/white"
                            android:textSize="18sp" />

                    </androidx.cardview.widget.CardView>

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"/>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cv_secondary"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/error_btn_secondary_bg"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/tx_secondary"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/urbanist_bold"
                            android:gravity="center"
                            android:paddingHorizontal="20dp"
                            android:paddingVertical="12dp"
                            android:text="@string/delete"
                            android:textColor="@color/error_btn_secondary_tx"
                            android:textSize="18sp" />

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginHorizontal="12dp"
            android:layout_marginVertical="12dp"
            android:padding="1dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_close_black"
            app:tint="@color/black" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>