<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="5dp"
    android:background="@color/white"
    android:maxHeight="320dp"
    android:layout_margin="32dp"
    android:layout_gravity="center"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="24dp"
                android:paddingHorizontal="6dp"
                >

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:fontFamily="@font/urbanist_bold"
                    android:text="@string/location_access_dein"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textStyle="normal"
                    android:textIsSelectable="true"
                    android:textSize="20sp" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/animation"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/location_service_anim"
                    android:layout_gravity="center"
                    app:lottie_repeatCount="1"
                    android:layout_marginVertical="12dp"
                    />

                <TextView
                    android:id="@+id/tv_sub_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/urbanist_regular"
                    android:text="@string/location_service_on_karein"
                    android:textAlignment="center"
                    android:textColor="#696969"
                    android:textStyle="normal"
                    android:textIsSelectable="false"
                    android:textSize="15sp" />


                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="8dp"
                    app:cardBackgroundColor="#F1F9F0"
                    app:strokeWidth="1dp"
                    app:strokeColor="#C2E7BF"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="12dp"
                    app:contentPaddingTop="6dp"
                    app:contentPaddingBottom="6dp"
                    >
                    <TextView
                        android:id="@+id/tv_highlight_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:fontFamily="@font/urbanist_semi_bold"
                        android:text="@string/kya_aap_logout_karna_chahte_hein"
                        android:textAlignment="center"
                        android:textColor="#357F2F"
                        android:textIsSelectable="true"
                        android:textSize="15sp" />

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/ll_buttons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="24dp"
                    android:layout_marginHorizontal="10dp"
                    android:padding="4dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cv_negative"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:theme="@style/Theme.MaterialComponents.Light"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/arivihan_secondary_color"
                        android:layout_marginHorizontal="6dp"
                        >

                        <TextView
                            android:id="@+id/tv_negative"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:text="@string/not_now"
                            android:textAlignment="center"
                            android:layout_gravity="center"
                            android:textColor="@color/arivihan_secondary_color"
                            android:textSize="16sp"
                            android:textStyle="normal" />

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cv_positive"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:theme="@style/Theme.MaterialComponents.Light"
                        app:cardBackgroundColor="@color/navy_blue"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        android:layout_marginHorizontal="6dp"
                        >

                        <TextView
                            android:id="@+id/tv_positive"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:text="@string/turn_on"
                            android:textAlignment="center"
                            android:layout_gravity="center"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="normal" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <ImageView
            android:id="@+id/iv_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_close_black"
            android:contentDescription="@string/cancel"
            android:layout_margin="5dp"
            android:layout_gravity="end"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            />

    </RelativeLayout>

</androidx.cardview.widget.CardView>