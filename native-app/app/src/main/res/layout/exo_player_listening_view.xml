<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fui_transparent">

    <LinearLayout
        android:visibility="gone"
        android:id="@+id/ll_txtSpeechInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-1dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            style="@style/tertiaryText"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#80000000" />

        <TextView
            android:id="@+id/txtSpeechInput"
            style="@style/primaryText"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:background="#80000000"
            android:gravity="center"
            android:text="@string/listening_one"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:fontFamily="@font/urbanist_regular"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="-70dp"
            android:gravity="center">


            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/speech_animation_1"
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/speech_recognition_lottie3"
                app:lottie_speed="0.25" />

            <ImageView
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/mic_outline" />


            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/speech_animation_2"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:rotationY="180"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/speech_recognition_lottie3"
                app:lottie_speed="0.25" />

        </LinearLayout>


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>