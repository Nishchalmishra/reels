<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="0dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/main_card"
        android:layout_width="182dp"
        android:layout_height="113dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="10dp"
        android:outlineSpotShadowColor="@color/grey_400"
        app:cardBackgroundColor="@color/arivihan_secondary_color"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/micro_lecture_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/ai_tutor_resized2" />

            <RelativeLayout
                android:id="@+id/rl_position"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_margin="3dp"
                android:background="@drawable/today_task_current_item_badge"
                android:paddingHorizontal="6dp">

                <TextView
                    android:id="@+id/task_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/urbanist_semi_bold"
                    android:text="2/6"
                    android:textColor="@color/arivihan_secondary_color"
                    android:textSize="12sp" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/linearlayout"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_alignParentBottom="true"
                android:background="@color/white"
                android:layout_marginBottom="3dp"
                >

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="11dp"
                    android:layout_marginEnd="2dp"
                    >
                    <ImageView
                        android:id="@+id/iv_play"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/img_play_blue"
                        android:scaleType="centerCrop"
                        android:layout_gravity="center_vertical"
                        />

                    <TextView
                        android:id="@+id/tv_video_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1h 32m"
                        android:textStyle="normal"
                        android:textSize="11sp"
                        android:textColor="@color/black"
                        android:fontFamily="@font/urbanist_medium"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="2dp"
                        android:layout_gravity="center_vertical"
                        />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_view_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="12dp"
                    >
                    <ImageView
                        android:id="@+id/iv_view"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/img_eye_outline"
                        android:scaleType="centerCrop"
                        android:layout_gravity="center_vertical"
                        />

                    <TextView
                        android:id="@+id/tv_view_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1h 32m"
                        android:textStyle="normal"
                        android:textSize="11sp"
                        android:textColor="@color/black"
                        android:fontFamily="@font/urbanist_medium"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="2dp"
                        android:layout_gravity="center_vertical"
                        />
                </LinearLayout>

            </RelativeLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/micro_lecture_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:progress="35"
                app:indicatorColor="@color/arivihan_secondary_color"
                app:trackColor="#D9D9D9" />

            <ImageView
                android:id="@+id/completed_status"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentRight="true"
                android:layout_margin="4dp"
                android:src="@drawable/today_class_complete_icon" />

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/new_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardBackgroundColor="@color/streak_yellow"
        app:cardCornerRadius="2dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/urbanist_semi_bold"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp"
            android:text="@string/New"
            android:textColor="@color/black"
            android:textSize="10sp" />
    </androidx.cardview.widget.CardView>

    <RelativeLayout
        android:id="@+id/rl_dot_layout"
        android:layout_width="182dp"
        android:layout_height="136dp"
        android:layout_marginHorizontal="10dp"
        android:elevation="7dp"
        android:background="@color/color_transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >
        <View
            android:id="@+id/progress_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginBottom="7.2dp"
            android:layout_alignParentBottom="true"
            android:background="@drawable/bg_progress_dot_blue"
            />
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>