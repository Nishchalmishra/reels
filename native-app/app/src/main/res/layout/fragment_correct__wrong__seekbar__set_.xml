<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/bottom_contact_nav_2"
    android:background="@drawable/bottomcontact"
    tools:context=".fragments.Correct_Wrong_Seekbar_Set_Fragment">


    <androidx.cardview.widget.CardView
        android:id="@+id/icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="10dp"
        app:cardElevation="0dp"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="4dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:src="@drawable/ic_analytic" />

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/contact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="8dp"
        android:layout_toRightOf="@id/icon"
        android:fontFamily="@font/poppins_light"
        android:text="@string/FilterYourAnalysis"
        android:textColor="@color/black"
        android:textSize="@dimen/LargeTitleSize"
        android:textStyle="bold" />


    <androidx.cardview.widget.CardView
        android:id="@+id/infoCard"
        android:layout_width="match_parent"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        android:layout_below="@id/contact"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        app:cardBackgroundColor="@color/lighter_navy_blue"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/textMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:text="Imformation Regarding the filter use in this sectionString first = s.substring(0,s.length()/2) alpha beytdjaj kjabsbjx sjbx  hja sjb jyags mjbsxa jsb ajhsx ajbxba sh" />

        </RelativeLayout>


    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/infoCard"
        android:layout_marginLeft="12dp"
        android:fontFamily="@font/poppins_light"
        android:text="Correct Percentage"
        android:textSize="@dimen/primary_text_size"
        android:textStyle="bold" />


    <TextView
        android:id="@+id/Correct_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/infoCard"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/poppins_light"
        android:text="0 %"
        android:textColor="@color/green"
        android:layout_toRightOf="@id/text1"
        android:textSize="@dimen/tertiary_text_size"
        android:textStyle="bold" />

    <SeekBar
        android:id="@+id/corectSeekbar"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_below="@id/text1"
        android:layout_marginTop="5dp"
        android:progressDrawable="@drawable/seekbar_style"
        android:thumb="@drawable/custom_thumb" />

    <TextView
        android:id="@+id/text2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/corectSeekbar"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/poppins_light"
        android:text="Wrong Percentage"
        android:textSize="@dimen/primary_text_size"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wrong_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/corectSeekbar"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:layout_toRightOf="@id/text2"
        android:fontFamily="@font/poppins_light"
        android:text=" 0 %"
        android:textColor="@color/red"
        android:textSize="@dimen/tertiary_text_size"
        android:textStyle="bold" />


    <SeekBar
        android:id="@+id/wrongSeekbar"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_below="@id/text2"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="10dp"
        android:progressDrawable="@drawable/seekbar_style2"
        android:thumb="@drawable/custom_thumb2" />


    <androidx.cardview.widget.CardView
        android:id="@+id/apply_card"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/StartActivityButton"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_below="@id/wrongSeekbar"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="20dp"
        app:cardElevation="0dp"
        >

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/apply"
                android:textColor="@color/white"
                android:textSize="@dimen/LargeTitleSize" />

        </RelativeLayout>

    </androidx.cardview.widget.CardView>


</RelativeLayout>