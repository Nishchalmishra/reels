<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/frameLayout"
    android:layout_height="match_parent"
    tools:context=".fragments.SubscriptionFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:background="@drawable/gradient_navy_blue"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <RelativeLayout
            android:id="@+id/relativeLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="15dp">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginLeft="15dp"
                android:scaleType="fitXY"
                android:src="@drawable/sign_in_gradient_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginRight="15dp"
                android:drawableLeft="@drawable/ic_help"
                android:drawablePadding="3dp"
                android:text="Help"
                android:textColor="#00838F"
                android:textSize="@dimen/secondary_text_size" />


        </RelativeLayout>

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_light"
            android:text="Subscription"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="@dimen/primary_text_size"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/scrollView2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="choose your plan that suits you the best"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="@dimen/secondary_text_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/name"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent" />

        <ScrollView
            android:id="@+id/scrollView2"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="540dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="540dp"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:background="@drawable/subscription_background"
                    android:layout_height="540dp">

                    <LinearLayout
                        android:id="@+id/upper_linear_layout"
                        android:layout_width="match_parent"
                        android:orientation="horizontal"
                        android:layout_marginTop="30dp"
                        android:layout_marginLeft="8dp"
                        android:layout_marginRight="8dp"
                        android:layout_height="wrap_content">


                        <TextView
                                android:id="@+id/three_months"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3 months"
                                android:textAlignment="center"
                                android:textSize="@dimen/primary_text_size"
                                android:layout_weight="1"/>

                        <TextView
                            android:id="@+id/six_months"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="6 months"
                            android:textSize="@dimen/primary_text_size"
                            android:textAlignment="center"
                            android:layout_weight="1"/>

                        <TextView
                            android:id="@+id/one_year"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1 year"
                            android:textColor="@color/black"
                            android:textSize="@dimen/LargeTitleSize"
                            android:textAlignment="center"
                            android:layout_weight="1"/>


                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/payment"
                        android:layout_width="170dp"
                        android:layout_height="40dp"
                        android:layout_below="@+id/upper_linear_layout"
                        android:layout_marginTop="35dp"
                        android:theme="@style/Theme.MaterialComponents.Light"
                        app:cardCornerRadius="8dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#19B0C1"
                        android:layout_centerHorizontal="true">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <TextView
                                android:id="@+id/price"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:text="₹ 2499/monthly"
                                android:textColor="#19B0C1"
                                android:textSize="@dimen/primary_text_size" />

                        </RelativeLayout>


                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/save"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/payment"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/comfortaa"
                        android:text="Save 33%"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/all_plans"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/save"
                        android:layout_marginLeft="25dp"
                        android:layout_marginTop="30dp"
                        android:layout_marginRight="25dp"
                        android:text="In addition to the Classic Pack features,you'll
                        also get"
                        android:textAlignment="center"
                        android:textSize="@dimen/secondary_text_size" />


                    <TextView
                        android:id="@+id/plan_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/all_plans"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="30dp"
                        android:drawableLeft="@drawable/ic_subscription_tick"
                        android:drawablePadding="15dp"
                        android:text="Lorem Ipsum dolor sit amet" />

                    <TextView
                        android:id="@+id/plan_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_below="@+id/plan_1"
                        android:layout_marginTop="15dp"
                        android:text="Lorem Ipsum dolor sit amet"
                        android:drawablePadding="15dp"
                        android:drawableLeft="@drawable/ic_subscription_tick"/>

                    <TextView
                        android:id="@+id/plan_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_below="@+id/plan_2"
                        android:layout_marginTop="15dp"
                        android:text="Lorem Ipsum dolor sit amet"
                        android:drawablePadding="15dp"
                        android:drawableLeft="@drawable/ic_subscription_tick"/>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/buy"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginLeft="25dp"
                        android:layout_marginRight="25dp"
                        android:layout_above="@+id/terms"
                        android:layout_marginBottom="35dp"
                        app:cardElevation="0dp"
                        style="@style/StartActivityButton">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <TextView
                                android:id="@+id/buy_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:text="Get 1 year - ₹ 2499/mo"
                                android:textColor="@color/white"
                                android:textSize="@dimen/LargeTitleSize" />


                        </RelativeLayout>

                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/terms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:layout_marginBottom="12dp"
                        android:text="Terms and Conditions"
                        android:textColor="#19B0C1"
                        android:textSize="@dimen/tertiary_text_size"
                        android:textStyle="bold" />

                </RelativeLayout>

            </LinearLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>



</FrameLayout>