<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Welcome Text -->
    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="38dp"
        android:layout_marginTop="36dp"
        android:fontFamily="@font/urbanist_medium"
        android:text="Welcome to Arivihan,"
        android:textColor="#26C6DA"
        android:textSize="20sp"
        android:lineSpacingExtra="5dp"
        app:layout_constraintEnd_toStartOf="@id/ivCharacter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- Illustration (optional) -->
    <ImageView
        android:id="@+id/ivCharacter"
        android:layout_width="120dp"
        android:layout_height="140dp"
        android:layout_marginEnd="20dp"
        android:src="@drawable/name_screen_emoji"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvWelcome" />

    <!-- Name Input Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardName"
        android:layout_width="0dp"
        android:layout_height="56dp"
android:layout_marginHorizontal="38dp"
        android:layout_marginTop="-25dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivCharacter">

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@android:color/transparent"
            android:fontFamily="@font/urbanist_regular"
            android:hint="Enter your name"
            android:textColorHint="#66666680"
            android:autofillHints="name"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:textSize="16sp"
            android:maxLines="1"
            android:inputType="textPersonName"
            android:maxLength="20"
            android:layout_gravity="center"/>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvNameError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/urbanist_regular"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#B00020"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardName" />

</androidx.constraintlayout.widget.ConstraintLayout>