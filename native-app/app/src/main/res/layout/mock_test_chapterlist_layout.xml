<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginRight="20dp"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="10dp"
    android:layout_marginLeft="20dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="5dp"
    android:layout_height="wrap_content">



    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <TextView
            android:id="@+id/chapterName"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="15dp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"
            android:text="Mathematics"
            android:textColor="@color/black"
            android:textSize="@dimen/primary_text_size" />

        <TextView
            android:id="@+id/YourScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="10dp"
            android:text="Your Score : 40/50"
            android:textColor="@color/navy_blue"
            android:textSize="@dimen/tertiary_text_size"
            android:visibility="visible" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/chapterName"
            android:layout_marginLeft="15dp"
            android:paddingLeft="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="0dp"
            android:layout_marginBottom="20dp"
            android:layout_toStartOf="@+id/TestCard">

            <TextView
                android:id="@+id/questions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:text="30 Questions"
                android:textColor="@color/black"
                android:textSize="@dimen/tertiary_text_size" />

            <ImageView
                android:id="@+id/dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toRightOf="@+id/questions"
                android:src="@drawable/ic_mock_test_ellipse" />

            <TextView
                android:id="@+id/Time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_toRightOf="@+id/dot"
                android:text="45 minutes"
                android:textColor="@color/black"
                android:textSize="@dimen/tertiary_text_size" />

        </RelativeLayout>



        <androidx.cardview.widget.CardView
            android:id="@+id/TestCard"
            android:layout_width="100dp"
            android:layout_height="35dp"
            android:layout_below="@+id/chapterName"
            android:layout_alignParentRight="true"
            android:layout_marginBottom="5dp"
            android:layout_marginRight="15dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#19B0C1"
            app:cardCornerRadius="8dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/TestStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="@string/StartTest"
                    android:textColor="@color/white"
                    android:textSize="@dimen/tertiary_text_size" />

            </RelativeLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/ReviewCard"
            android:layout_width="100dp"
            android:layout_height="35dp"
            android:visibility="gone"
            android:layout_below="@+id/TestCard"
            android:layout_alignParentRight="true"
            android:layout_marginBottom="5dp"
            android:layout_marginRight="15dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/green"
            app:cardCornerRadius="8dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="@string/review"
                    android:textColor="@color/white"
                    android:textSize="@dimen/tertiary_text_size" />

            </RelativeLayout>

        </androidx.cardview.widget.CardView>

    </RelativeLayout>


</androidx.cardview.widget.CardView>