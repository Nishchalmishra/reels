<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".activity.DoubtChatHistoryActivity">


    <RelativeLayout
        android:id="@+id/screen_header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginEnd="20dp">

        <LinearLayout
            android:id="@+id/activity_back_btn"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="17dp">

            <ImageView
                android:id="@+id/back_button"
                android:layout_width="13dp"
                android:layout_height="15dp"
                android:layout_marginTop="1dp"
                android:src="@drawable/arrow_icon" />
        </LinearLayout>

        <TextView
            android:id="@+id/header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="8dp"
            android:layout_toRightOf="@id/activity_back_btn"
            android:fontFamily="@font/urbanist_semi_bold"
            android:text="Solved Doubts"
            android:textColor="@color/black"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/search_text_field"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginRight="12dp"
            android:layout_toLeftOf="@id/search_icon"
            android:layout_toRightOf="@id/activity_back_btn"
            android:backgroundTint="@color/arivihan_secondary_color"
            android:hint="Search Doubts..."
            android:visibility="gone" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_marginRight="12dp"
            android:layout_toStartOf="@id/new_chat_btn"
            android:src="@drawable/icon_share"
            android:visibility="gone" />

        <LinearLayout

            android:id="@+id/new_chat_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/finish_button_border"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/urbanist_semi_bold"
                android:text="@string/new_chat"
                android:textColor="@color/black"
                android:textSize="14sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/search_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/search_outline" />

    </RelativeLayout>

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/chat_history_shimmer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/screen_header"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <include layout="@layout/recent_search_shimmer" />

            <include layout="@layout/recent_search_shimmer" />

            <include layout="@layout/recent_search_shimmer" />

            <include layout="@layout/recent_search_shimmer" />

            <include layout="@layout/recent_search_shimmer" />

            <include layout="@layout/recent_search_shimmer" />

            <include layout="@layout/recent_search_shimmer" />

            <include layout="@layout/recent_search_shimmer" />

            <include layout="@layout/recent_search_shimmer" />

            <include layout="@layout/recent_search_shimmer" />

            <include layout="@layout/recent_search_shimmer" />

            <include layout="@layout/recent_search_shimmer" />
        </LinearLayout>

    </com.facebook.shimmer.ShimmerFrameLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/previous_doubts_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/screen_header"
        android:layout_margin="18dp" />

    <TextView
        android:layout_below="@id/screen_header"

        android:id="@+id/previous_chat_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/urbanist_regular"
        android:text="@string/previous_chats"
        android:textColor="#696969"
        android:textSize="16sp"
        android:textAlignment="center"
        android:visibility="gone"/>

</RelativeLayout>