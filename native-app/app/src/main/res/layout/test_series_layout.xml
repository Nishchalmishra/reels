<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:layout_width="103dp"
    android:layout_height="125dp"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="10dp"
    app:cardElevation="12dp"
    app:cardCornerRadius="7dp"
    android:outlineSpotShadowColor="@color/grey_300">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/profile_icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_above="@+id/exam_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp"
            android:padding="2dp"
            android:src="@drawable/ic_physics" />

        <TextView
            android:id="@+id/exam_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/chapters"
            app:layout_constraintEnd_toEndOf="parent"
            android:text=""
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="@dimen/small_subject_name"
            android:maxLines="2"
            android:ellipsize="end"
            android:fontFamily="@font/urbanist_semi_bold"
            android:paddingHorizontal="6dp"/>


        <TextView
            android:id="@+id/chapters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="8dp"
            android:text=""
            android:textAlignment="center"
            android:textColor="@color/grey_500"
            android:textSize="@dimen/small_chapter_number"
            android:fontFamily="@font/urbanist_semi_bold"/>


    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.cardview.widget.CardView>