<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/blueCircle"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:visibility="gone"
            android:src="@drawable/circle_maths" />

        <ImageView
            android:id="@+id/redCircle"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:visibility="gone"
            android:src="@drawable/circle_chem_analytics" />


        <ImageView
            android:id="@+id/greenCircle"
            android:layout_width="14dp"
            android:visibility="gone"
            android:layout_height="14dp"
            android:src="@drawable/circle_maths_analytics" />

        <ImageView
            android:id="@+id/circle4"
            android:layout_width="14dp"
            android:visibility="gone"
            android:layout_height="14dp"
            android:src="@drawable/circle_bio_analytics" />


        <TextView
            android:id="@+id/subjectName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:fontFamily="@font/poppins_light"
            android:text="Physics"
            android:textSize="@dimen/small_chapter_number"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>