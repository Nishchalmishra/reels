<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout for ChapterListByTypeFragment.
  Mirrors the CoordinatorLayout section of activity_chapter_list_by_subjects.xml.
  The activity provides the outer toolbar + type-tabs; this fragment owns everything below:
  collapsing live-classes section, banner, subject-tabs, and the inner ViewPager2.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rl_fragment_parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_scrollFlags="scroll|exitUntilCollapsed">

                <RelativeLayout
                    android:id="@+id/rl_live_classes"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    app:layout_collapseMode="parallax">

                    <RelativeLayout
                        android:id="@+id/rl_live_content"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_today_class_bg"
                            app:layout_scrollFlags="scroll" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentTop="true"
                            android:orientation="vertical"
                            app:layout_scrollFlags="scroll">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:layout_marginBottom="2dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tv_live_classes"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginHorizontal="16dp"
                                    android:layout_weight="2"
                                    android:fontFamily="@font/urbanist_bold"
                                    android:gravity="start"
                                    android:text="@string/classes"
                                    android:textColor="#333333"
                                    android:textSize="16sp"
                                    android:textStyle="normal" />

                                <LinearLayout
                                    android:id="@+id/ll_see_all"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginHorizontal="16dp"
                                    android:gravity="end"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tv_see_all"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_vertical"
                                        android:fontFamily="@font/urbanist_semi_bold"
                                        android:gravity="start"
                                        android:text="@string/see_all"
                                        android:textColor="#1EA6B3"
                                        android:textSize="14sp"
                                        android:textStyle="normal" />

                                    <ImageView
                                        android:id="@+id/iv_see_all"
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="center_vertical"
                                        android:layout_marginStart="5dp"
                                        android:contentDescription="@string/see_all"
                                        android:src="@drawable/img_arrow_forward"
                                        app:tint="#1EA6B3" />

                                </LinearLayout>
                            </LinearLayout>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/today_class_recycler_view"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="8dp"
                                android:orientation="horizontal"
                                android:scrollbars="none"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                tools:itemCount="2"
                                tools:listitem="@layout/today_class_common_layout" />

                        </LinearLayout>
                    </RelativeLayout>

                    <include
                        android:id="@+id/shimmer_live_classes"
                        layout="@layout/shimmer_todays_task_layout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                </RelativeLayout>

            </com.google.android.material.appbar.CollapsingToolbarLayout>

        </com.google.android.material.appbar.AppBarLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <RelativeLayout
                android:id="@+id/rl_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <arivihan.technologies.doubtbuzzter2.helper.CompetitiveBannerView
                    android:id="@+id/bannerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-16dp"
                    android:elevation="1dp"
                    android:visibility="gone" />

                <!-- Subject tabs -->
                <RelativeLayout
                    android:id="@+id/rl_subject_tab_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/bannerView"
                    android:visibility="visible">

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/subject_tabs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginHorizontal="12dp"
                        android:layout_marginTop="4dp"
                        android:background="@color/white"
                        android:visibility="gone"
                        app:tabIndicatorColor="@color/fui_transparent"
                        app:tabIndicatorFullWidth="false"
                        app:tabMode="scrollable"
                        app:tabPaddingEnd="5dp"
                        app:tabPaddingStart="5dp"
                        app:tabRippleColor="@null"
                        app:tabSelectedTextColor="@color/black" />

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cv_subject_tab_left_scroll"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_marginHorizontal="8dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="10dp"
                            android:rotation="180"
                            android:scaleType="centerCrop"
                            android:src="@drawable/right_arrow"
                            app:tint="@color/black" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cv_subject_tab_right_scroll"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginHorizontal="8dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="10dp"
                            android:rotation="0"
                            android:scaleType="centerCrop"
                            android:src="@drawable/right_arrow"
                            app:tint="@color/black" />
                    </androidx.cardview.widget.CardView>

                </RelativeLayout>

                <!-- Subject ViewPager2 -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/subject_viewpager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@id/rl_subject_tab_layout"
                    android:layout_marginTop="5dp"
                    android:background="@color/white"
                    android:visibility="gone" />

            </RelativeLayout>

            <include
                android:id="@+id/shimmer"
                layout="@layout/shimmer_adaptive_chapter_list_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </RelativeLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</RelativeLayout>
