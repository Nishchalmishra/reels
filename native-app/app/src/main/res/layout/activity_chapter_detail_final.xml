<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <include layout="@layout/back_ground_image"/>

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_chapter_detail"
        style="@style/whiteBolText"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/theme_gradient_color"
        app:layout_constraintTop_toTopOf="parent"
        app:logo="@drawable/ic_doubtbuzter"
        app:popupTheme="@style/Arivihan.Toolbar"
        app:title="@string/chapterDetailActivity"
        app:titleTextAppearance="@style/TitleTextStyle" >

        <ImageView
            android:id="@+id/what_is_pseudolive_button"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_gravity="end"
            android:elevation="5dp"
            android:layout_marginEnd="20dp"
            android:src="@drawable/ic_help" />

        <ProgressBar
            android:id="@+id/progressBarLearningCircular"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:indeterminateOnly="false"
            android:layout_marginEnd="10dp"
            android:layout_gravity="end"
            android:max="100"
            android:progress="0"
            android:text="70%"
            android:progressDrawable="@drawable/progress_bar_drawable" />

    </androidx.appcompat.widget.Toolbar>

    <com.airbnb.lottie.LottieAnimationView
        android:layout_centerInParent="true"
        android:id="@+id/lottie"
        android:layout_width="@dimen/animation_size"
        android:layout_height="@dimen/animation_size"
        android:visibility="visible"
        app:lottie_rawRes="@raw/cloud"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chapter_detail_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_marginTop="75dp"
        android:layout_marginEnd="10dp" />


    <RelativeLayout
        android:id="@+id/relativeLayoutConfirmation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foregroundGravity="center"
        android:background="#9A000000"
        android:visibility="gone"
        android:gravity="center">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="50dp">

            <LinearLayout
                android:id="@+id/linearLayoutNewInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginRight="30dp"
                android:background="@drawable/button_border_payment"
                android:orientation="vertical">

                <Button
                    android:id="@+id/payment_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="5dp"
                    android:textAlignment="center"
                    android:background="@drawable/theme_gradient_color"
                    android:paddingLeft="0dp"
                    android:paddingTop="0dp"
                    android:paddingEnd="0dp"
                    android:paddingBottom="0dp"
                    android:text="@string/ready_lecture"
                    android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                    android:textColor="#fff"
                    android:textSize="14sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/payment_text"
                    android:textIsSelectable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="10dp"
                    android:fontFamily="@font/opensans_regular"
                    android:text="@string/point_deduction"
                    android:textAlignment="center"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:gravity="center">
                    <Button
                        android:id="@+id/lets_progress"
                        style="@style/primaryButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginRight="20dp"
                        android:layout_gravity="center_horizontal"
                        android:background="@drawable/button_border"
                        android:paddingLeft="15dp"
                        android:paddingRight="15dp"
                        android:fontFamily="@font/opensans_regular"
                        android:text="@string/let_progress"
                        android:textAppearance="@style/TextAppearance.AppCompat" />

                    <Button
                        android:id="@+id/leave_it"
                        style="@style/primaryButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginLeft="20dp"
                        android:layout_gravity="center_horizontal"
                        android:background="@drawable/button_border"
                        android:fontFamily="@font/opensans_regular"
                        android:paddingLeft="15dp"
                        android:paddingRight="15dp"
                        android:text="@string/leave_it"
                        android:textAppearance="@style/TextAppearance.AppCompat" />

                </LinearLayout>



            </LinearLayout>
        </ScrollView>

    </RelativeLayout>


    <RelativeLayout
        android:id="@+id/relativeLayoutPseudoLiveInfo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foregroundGravity="center"
        android:gravity="center"
        android:visibility="gone"
        android:background="#B7000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="7dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp">

            <ImageView
                android:id="@+id/pseudolive_info_info_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:background="@drawable/button_border"
                app:srcCompat="@drawable/what_is_a_pseudolive_thumbnail" />

            <VideoView
                android:id="@+id/videoViewPseudoLive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"></VideoView>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/pseudolive_info_got_it"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="20dp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:paddingBottom="4dp"
            android:background="@drawable/infobutton"
            android:gravity="center"
            android:fontFamily="baskerville"
            android:text="&#10006;"
            android:textAppearance="@style/TextAppearance.AppCompat.Medium"
            android:textColor="#fff"
            android:textSize="14dp"/>


    </RelativeLayout>


    <RelativeLayout
        android:id="@+id/relativeLayoutLearning"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B7000000"
        android:gravity="center"
        >


        <Button
            android:id="@+id/learning_level_got_it"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="-15dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/infobutton"
            android:fontFamily="baskerville"
            android:gravity="center"
            android:paddingBottom="4dp"
            android:text="&#10006;"
            android:textAppearance="@style/TextAppearance.AppCompat.Medium"
            android:textColor="#fff"
            android:textSize="14dp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/theme_gradient_curved"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="fill_horizontal"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="-100dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/nextChapter"
                        style="@style/whiteBolText"
                        android:layout_width="200dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_marginLeft="10dp"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="@font/opensans_bold"
                        android:paddingLeft="10dp"
                        android:shadowColor="@color/grey_500"
                        android:shadowDx="3"
                        android:shadowDy="3"
                        android:shadowRadius="2"
                        android:text=""
                        android:textSize="20sp" />


                </LinearLayout>


                <ImageView
                    android:id="@+id/learningGif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="-200dp"
                    android:adjustViewBounds="true"
                    android:shadowDx="3"
                    android:shadowDy="3"
                    android:shadowRadius="2"
                    android:src="@drawable/learning_path_white_one" />

                <TextView
                    android:id="@+id/previousChapter"
                    style="@style/whiteBolText"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="110dp"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="@font/opensans_bold"
                    android:paddingRight="10dp"
                    android:shadowColor="@color/grey_500"
                    android:shadowDx="5"
                    android:shadowDy="5"
                    android:shadowRadius="2"
                    android:text=""
                    android:textAlignment="viewEnd"
                    android:textSize="14sp" />

            </LinearLayout>


        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBarLearningLine"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="end"
            android:layout_marginLeft="250dp"
            android:layout_marginTop="30dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="20dp"
            android:alpha="0.0"
            android:indeterminateOnly="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_drawable" />

        <TextView
            android:id="@+id/progressBarText"
            style="@style/whiteBolText"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignLeft="@id/progressBarLearningLine"
            android:layout_alignTop="@id/progressBarLearningLine"
            android:layout_alignRight="@id/progressBarLearningLine"
            android:layout_alignBottom="@id/progressBarLearningLine"
            android:layout_marginLeft="27dp"
            android:layout_marginTop="30dp"
            android:alpha="0.0"
            android:text="70%"
            android:textSize="16sp" />


    </RelativeLayout>



</RelativeLayout >