<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/fui_transparent"
    android:layout_marginHorizontal="70dp"
    android:layout_marginVertical="20dp"
    xmlns:tools="http://schemas.android.com/tools"
    app:cardElevation="0dp"
    app:cardCornerRadius="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:theme="@style/Theme.MaterialComponents.Light"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="20dp">

        <TextView
            android:id="@+id/tx1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/urbanist_bold"
            android:text="@string/sorry_we_have_found"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:gravity="center"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_below="@id/tx1"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="match_parent">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/arivihanResult"
                    android:layout_width="match_parent"
                    android:layout_below="@id/tx1"
                    android:layout_marginRight="15dp"
                    android:elevation="0dp"
                    android:layout_marginLeft="15dp"
                    android:layout_marginTop="5dp"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="10dp"
                    app:strokeColor="#F2F2F2"
                    app:strokeWidth="1dp"
                    android:visibility="gone"
                    android:layout_marginBottom="5dp"
                    android:layout_height="wrap_content">


                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#F2F2F2">

                        <TextView
                            android:id="@+id/title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_light"
                            android:padding="5dp"
                            android:background="@color/white"
                            android:textStyle="bold"
                            android:textSize="@dimen/primary_text_size"
                            android:text="Arivihan Result"
                            android:textColor="@color/colorPrimary"/>


                        <LinearLayout
                            android:id="@+id/layout"
                            android:layout_width="match_parent"
                            android:orientation="horizontal"
                            android:layout_below="@id/title"
                            android:background="@color/white"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:id="@+id/result1"
                                android:layout_width="wrap_content"
                                android:layout_weight="1"
                                android:paddingTop="5dp"
                                android:paddingBottom="5dp"
                                android:background="@drawable/option_background_selection_result"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Result 1"
                                    android:textColor="@color/black"
                                    android:textAlignment="center"/>

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/result2"
                                android:layout_width="wrap_content"
                                android:layout_weight="1"
                                android:paddingBottom="5dp"
                                android:paddingTop="5dp"
                                android:background="@color/white"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Result 2"
                                    android:textColor="@color/black"
                                    android:textAlignment="center"/>

                            </LinearLayout>


                            <LinearLayout
                                android:id="@+id/result3"
                                android:layout_width="wrap_content"
                                android:layout_weight="1"
                                android:background="@color/white"
                                android:paddingTop="5dp"
                                android:paddingBottom="5dp"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Result 3"
                                    android:textColor="@color/black"
                                    android:textAlignment="center"/>

                            </LinearLayout>


                        </LinearLayout>


                        <TextView
                            android:id="@+id/link"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/layout"
                            android:layout_marginStart="7dp"
                            android:layout_marginTop="7dp"
                            android:layout_marginEnd="7dp"
                            android:layout_marginBottom="7dp"
                            android:fontFamily="@font/opensans_regular"
                            android:text="Here Is The Result... 1"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:textSize="@dimen/tertiary_text_size"
                            android:textStyle="bold"
                            android:visibility="visible" />

                    </RelativeLayout>

                </com.google.android.material.card.MaterialCardView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rlview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/arivihanResult"
                    tools:listitem="@layout/new_optionitem"
                    android:layout_marginTop="10dp"
                    tools:itemCount="3"/>
            </LinearLayout>

        </ScrollView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_dis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="40dp"
            android:layout_marginVertical="5dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/subscription_blue">

            <TextView
                android:id="@+id/option_something_else"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:paddingVertical="10dp"
                android:fontFamily="@font/urbanist_regular"
                android:paddingHorizontal="5dp"
                android:text="@string/no_i_was_asking"
                android:textAlignment="textStart"
                android:textColor="#191919"
                android:textSize="13sp" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.cardview.widget.CardView>