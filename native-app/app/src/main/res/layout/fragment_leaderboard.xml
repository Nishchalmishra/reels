<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardUseCompatPadding="true"
        app:cardBackgroundColor="@android:color/transparent">

        <!-- ✅ ONE root layout: background fills entire card top-to-bottom -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_bg"
                android:layout_width="match_parent"
                android:layout_height="340dp"
                android:src="@drawable/leader_board_bg"
                android:scaleType="centerCrop"
                android:layout_alignParentTop="true" />

            <!-- ── Entire content stacked on top of bg ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentTop="true">

                <!-- ── Podium Section ── -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="235dp"
                    android:layout_marginTop="30dp"
                    android:layout_marginHorizontal="20dp">

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/guide_33"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.33" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/guide_67"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.67" />

                    <!-- Podium Image -->
                    <ImageView
                        android:id="@+id/iv_podium"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:src="@drawable/podium"
                        android:scaleType="fitXY"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- 1st Place -->
                    <LinearLayout
                        android:id="@+id/avatar_first"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        app:layout_constraintBottom_toTopOf="@id/iv_podium"
                        app:layout_constraintStart_toEndOf="@id/guide_33"
                        app:layout_constraintEnd_toStartOf="@id/guide_67">

                        <TextView
                            android:id="@+id/tv_first_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="6dp"
                            android:text="Haravendra S."
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:textColor="#121212"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <FrameLayout
                            android:layout_width="72dp"
                            android:layout_height="87dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/iv_first_avatar"
                                android:layout_width="72dp"
                                android:layout_height="72dp"
                                android:src="@drawable/avatar"
                                android:scaleType="centerCrop"
                                android:padding="2dp"
                                app:shapeAppearanceOverlay="@style/CircleImage"
                                app:strokeColor="@color/ring_gold"
                                app:strokeWidth="3dp" />

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:scaleType="center"
                                android:src="@drawable/ic_badge_rank_first"
                                android:contentDescription="@string/todo"
                                android:layout_gravity="center_horizontal|bottom"/>

                        </FrameLayout>

                    </LinearLayout>

                    <!-- 2nd Place -->
                    <LinearLayout
                        android:id="@+id/avatar_second"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="3dp"
                        android:layout_marginBottom="4dp"
                        android:translationY="30dp"
                        app:layout_constraintBottom_toTopOf="@id/iv_podium"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/guide_33">

                        <TextView
                            android:id="@+id/tv_second_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="6dp"
                            android:text="Poonam D."
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:textColor="#121212"
                            android:textSize="14sp"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <FrameLayout
                            android:layout_width="64dp"
                            android:layout_height="76dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/iv_second_avatar"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/avatar"
                                android:scaleType="centerCrop"
                                android:padding="2dp"
                                app:shapeAppearanceOverlay="@style/CircleImage"
                                app:strokeColor="@color/ring_silver"
                                app:strokeWidth="3dp" />

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:scaleType="center"
                                android:src="@drawable/ic_badge_rank_secound"
                                android:contentDescription="@string/todo"
                                android:layout_gravity="center_horizontal|bottom"/>

                        </FrameLayout>

                    </LinearLayout>

                    <!-- 3rd Place -->
                    <LinearLayout
                        android:id="@+id/avatar_third"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="4dp"
                        android:translationY="40dp"
                        app:layout_constraintBottom_toTopOf="@id/iv_podium"
                        app:layout_constraintStart_toEndOf="@id/guide_67"
                        app:layout_constraintEnd_toEndOf="parent">

                        <TextView
                            android:id="@+id/tv_third_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="6dp"
                            android:text="Shefali P."
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:textColor="#121212"
                            android:textSize="14sp"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <FrameLayout
                            android:layout_width="64dp"
                            android:layout_height="76dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/iv_third_avatar"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/avatar"
                                android:scaleType="centerCrop"
                                android:padding="2dp"
                                app:shapeAppearanceOverlay="@style/CircleImage"
                                app:strokeColor="@color/ring_bronze"
                                app:strokeWidth="3dp" />

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:scaleType="center"
                                android:src="@drawable/ic_badge_rank_third"
                                android:contentDescription="@string/todo"
                                android:layout_gravity="center_horizontal|bottom"/>

                        </FrameLayout>

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- ── List Section (White Card) ── -->
                <LinearLayout
                    android:id="@+id/leader_board_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_white_card_top"
                    android:paddingTop="12dp"
                    android:paddingBottom="16dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginTop="-18dp">

                    <!-- List Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="wrap_content"
                            android:text="@string/rank"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:textColor="#AAAAAA"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/name"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:textColor="#AAAAAA"
                            android:textSize="12sp"
                            android:layout_marginStart="20dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reward"
                            android:fontFamily="@font/urbanist_semi_bold"
                            android:textColor="#AAAAAA"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- RecyclerView -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_leaderboard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

</androidx.core.widget.NestedScrollView>