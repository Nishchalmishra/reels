<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_parent_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- TAB SECTION — shown when overall=false -->
    <RelativeLayout
        android:id="@+id/rl_tab_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginTop="4dp"
            android:background="@color/white"
            app:tabIndicatorColor="@color/fui_transparent"
            app:tabIndicatorFullWidth="false"
            app:tabMode="scrollable"
            app:tabPaddingEnd="2dp"
            app:tabPaddingStart="2dp"
            app:tabRippleColor="@null"
            app:tabSelectedTextColor="@color/black" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_tab_left_scroll"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:rotation="180"
                android:scaleType="centerCrop"
                android:src="@drawable/right_arrow"
                app:tint="@color/black" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_tab_right_scroll"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:rotation="0"
                android:scaleType="centerCrop"
                android:src="@drawable/right_arrow"
                app:tint="@color/black" />
        </androidx.cardview.widget.CardView>

    </RelativeLayout>

    <!-- ViewPager2 — shown when overall=false -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewpager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="5dp"
        android:background="@color/white"
        android:visibility="gone" />

    <!-- FLAT CONTENT — shown when overall=true -->
    <FrameLayout
        android:id="@+id/fl_flat_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- SHIMMER -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_chapters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include layout="@layout/shimmer_chapter_name" />
                <include layout="@layout/shimmer_chapter_name" />
                <include layout="@layout/shimmer_chapter_name" />

            </LinearLayout>

        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- FLAT LIST -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="20dp"
            android:background="@color/white"
            android:visibility="gone" />

        <!-- NO DATA -->
        <LinearLayout
            android:id="@+id/no_result_found_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            android:translationY="-65dp">

            <com.airbnb.lottie.LottieAnimationView
                android:layout_width="wrap_content"
                android:layout_height="200dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/no_results" />

            <TextView
                android:id="@+id/tv_no_data_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Result Found"
                android:fontFamily="@font/urbanist_bold"
                android:textSize="18dp"
                android:textColor="@color/black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Try changing the search term"
                android:fontFamily="@font/urbanist_medium"
                android:textSize="14dp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>