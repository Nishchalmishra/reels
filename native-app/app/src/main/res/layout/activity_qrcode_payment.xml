<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <ImageView
        android:id="@+id/close_btn"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_alignParentEnd="true"
        android:layout_marginVertical="12dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/search_close_btn" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="46dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/urbanist_bold"
            android:text="@string/scan_qr_code_and_pay"
            android:textColor="@color/black"
            android:textAlignment="center"
            android:textSize="22dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="20dp"
            android:layout_marginHorizontal="16dp"
            app:cardBackgroundColor="#E9FBFC"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:contentPaddingLeft="16dp"
            app:contentPaddingTop="8dp"
            app:contentPaddingRight="16dp"
            app:contentPaddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/subscription_plan_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:fontFamily="@font/urbanist_semi_bold"
                    android:text="JEE Mains + Board 12 months"
                    android:textColor="@color/black"
                    android:textSize="14sp" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="horizontal"
                    android:gravity="end|center_vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/cost_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/urbanist_regular"
                        android:text="₹3999"
                        android:textSize="12sp"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/final_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/urbanist_semi_bold"
                        android:text="₹1999"
                        android:textColor="@color/arivihan_secondary_color"
                        android:textSize="16sp" />
                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/qr_code_shimmer"
            android:layout_width="300dp"
            android:layout_height="300dp">

            <View
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:background="@color/grey_300"
                android:scaleType="centerCrop" />

        </com.facebook.shimmer.ShimmerFrameLayout>


        <ImageView
            android:id="@+id/qr_code_payment_image"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:layout_marginVertical="12dp"
            android:fontFamily="@font/urbanist_medium"
            android:text="@string/scan_with_any_upi"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="15dp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_indicator"
            android:layout_width="260dp"
            android:layout_height="16dp"
            android:layout_marginVertical="16dp"
            android:progress="60"
            app:indicatorColor="#26C6DA"
            app:trackColor="#E9E9E9"
            app:trackCornerRadius="10dp"
            app:trackThickness="5dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="12dp"
                android:fontFamily="@font/urbanist_medium"
                android:text="@string/make_payment_within"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="14dp" />


            <TextView
                android:id="@+id/countdown_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="12dp"
                android:layout_marginLeft="4sp"
                android:fontFamily="@font/urbanist_semi_bold"
                android:text="04:49"
                android:textAlignment="center"
                android:textColor="@color/arivihan_secondary_color"
                android:textSize="14dp" />

        </LinearLayout>


        <androidx.cardview.widget.CardView
            android:id="@+id/other_payment_option"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/arivihan_secondary_color"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:contentPaddingBottom="12dp"
            app:contentPaddingLeft="20dp"
            app:contentPaddingRight="20dp"
            app:contentPaddingTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/other_payment_options"
                android:textColor="@color/white"
                android:textSize="15dp" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>


</RelativeLayout>