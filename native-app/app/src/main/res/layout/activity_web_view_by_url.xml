<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rl_parent_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".activity.web_view.WebViewByUrlActivity">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/webView_lottie_animation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_margin="30dp"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/chat_loader" />

    <!-- INVISIBLE, never GONE: a GONE view is skipped during measure and layout entirely, so
         the WebView would stay 0×0 and Chromium cannot commit a navigation into an empty
         viewport — the load sits at 10% until the renderer is declared unresponsive. INVISIBLE
         is laid out at full size and simply not drawn, which the loader covers anyway. -->
    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible" />

    <arivihan.technologies.doubtbuzzter2.customView.video_player.MiniVideoPlayer
        android:id="@+id/mini_video_player"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:ignore="MissingConstraints">

        <include
            android:id="@+id/how_to_video_view"
            layout="@layout/activity_mock_demo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:visibility="invisible" />
    </RelativeLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_open_in_browser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardElevation="0dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/white"
        android:visibility="gone"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginVertical="24dp"
        android:layout_marginHorizontal="24dp"
        >
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/open_in_browser"
                android:fontFamily="@font/urbanist_medium"
                android:textColor="#1D1D1D"
                android:textSize="18sp"
                android:textStyle="normal"
                android:layout_gravity="center"/>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/arrow_icon"
                android:rotation="180"
                android:padding="4dp"
                app:tint="@color/black"
                android:layout_marginHorizontal="8dp"
                android:layout_gravity="center"
                />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>