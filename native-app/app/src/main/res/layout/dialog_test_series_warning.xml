<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/fui_transparent">

    <!-- Main content container -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:paddingVertical="8dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_cancel"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_margin="2dp"
            android:layout_centerVertical="true"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            android:elevation="3dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_close_black" />
        </androidx.cardview.widget.CardView>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="6dp"
            android:indeterminate="false"
            android:elevation="1dp"
            android:layout_marginHorizontal="8dp"
            app:indicatorColor="@color/arivihan_secondary_color"
            app:trackColor="@color/white"
            app:trackCornerRadius="20dp"
            app:trackThickness="6dp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/poster_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/progress_indicator"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="4dp"
            android:elevation="1dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="48dp"
                android:paddingBottom="48dp"
                >

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/urbanist_semi_bold"
                    android:text="Don't Leave the Test"
                    android:ellipsize="end"
                    android:textAlignment="center"
                    android:layout_marginHorizontal="24dp"
                    android:layout_gravity="center"
                    android:textColor="@color/black"
                    android:textSize="26sp"/>

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottie_alert"
                    android:layout_width="110dp"
                    android:layout_height="120dp"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/alert"
                    android:scaleX="1.5"
                    android:scaleY="1.5"
                    android:layout_gravity="center"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="24dp"
                    android:adjustViewBounds="true"
                    android:visibility="visible"/>

                <TextView
                    android:id="@+id/tv_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/urbanist_medium"
                    android:text="Test ko beech me chhodne par aapka attempt cancel ho sakta hai, aur re-attempt ka mauka nahi milega!"
                    android:ellipsize="end"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="36dp"
                    android:textAlignment="center"
                    android:textColor="#696969"
                    android:textSize="20sp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>
    </RelativeLayout>

</FrameLayout>
