<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parentLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".activity.PdfViewerActivity">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:layout_marginVertical="10dp"
        android:layout_marginHorizontal="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/back_button_layout"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/back_button"
                android:layout_width="13dp"
                android:layout_height="15dp"
                android:layout_marginTop="1dp"
                android:src="@drawable/arrow_icon"/>
        </LinearLayout>

        <TextView
            android:id="@+id/pdfTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:fontFamily="@font/nunito_bold"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Chapter 5 Magnetism and Matter Volume part 2 2"
            android:textColor="@color/black"
            android:textSize="@dimen/toolbar_title_size"/>
    </LinearLayout>

    <!-- PDF + Drawing container -->
    <FrameLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.rajat.pdfviewer.PdfRendererView
            android:id="@+id/pdfView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:pdfView_divider="@drawable/pdf_viewer_divider"
            app:pdfView_showDivider="false"/>

        <View
            android:id="@+id/view_black_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/black_overlay_pdf"
            android:visibility="gone"/>

        <arivihan.technologies.doubtbuzzter2.customView.DrawingView
            android:id="@+id/drawingView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"/>

        <arivihan.technologies.doubtbuzzter2.customView.gradient.GradientAnimationView
            android:id="@+id/gradient_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/color_transparent"
            android:visibility="gone"
            />

        <ImageView
            android:id="@+id/iv_gradient"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@drawable/img_pdf_gradient"
            android:visibility="gone"
            />

    </FrameLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_pencil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="28dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginHorizontal="32dp"
        android:layout_marginVertical="32dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintWidth_max="320dp"
        >

        <LinearLayout
            android:id="@+id/ll_pencil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/gradient_teal_pencil_bg"
            >
            <RelativeLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:elevation="2dp"
                >

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lav_pencil_gradient"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/lottie_blue_gradient"
                    android:rotationX="0"
                    android:scaleX="1.3"
                    android:scaleY="1.3"
                    app:lottie_speed="2"
                    android:visibility="visible"
                    android:layout_margin="0dp"
                    android:layout_centerInParent="true"
                    />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/img_pencil_white"
                    android:scaleType="centerInside"
                    android:layout_centerInParent="true"
                    app:tint="@color/white"
                    android:padding="16dp"
                    android:visibility="visible"
                    />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lav_pencil_stars"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/lottie_stars_white"
                    android:rotation="-90"
                    android:scaleX="1.0"
                    android:scaleY="1.0"
                    android:layout_marginVertical="10dp"
                    android:visibility="visible"
                    android:layout_centerInParent="true"
                    />

            </RelativeLayout>

            <TextView
                android:id="@+id/tv_pencil_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="24dp"
                android:text="@string/jha_doubt_he_vaha_circle_banao"
                android:fontFamily="@font/urbanist_semi_bold"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:visibility="visible"
                android:layout_gravity="center_vertical"
                />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Download Progress UI -->
    <LinearLayout
        android:id="@+id/downloadContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/download_progress_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="visible"
            android:layout_gravity="center"
            >

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:background="@drawable/circle_shape_video_download"
                android:indeterminate="false"
                android:progressDrawable="@drawable/circle_progress_video_download"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/progressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:text="0%"
                android:fontFamily="@font/urbanist_semi_bold"
                android:textColor="#3F3F3F"
                android:textSize="14sp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextSwitcher
            android:id="@+id/text_switcher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inAnimation="@anim/slide_up_in"
            android:outAnimation="@anim/slide_up_out"
            android:textSize="16sp"
            android:gravity="center"
            android:textAlignment="center"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="32dp"
            />

        <TextView
            android:id="@+id/progressMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bss_thodi_hi_der_me_aapke_notes_open_ho_jayenge"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:visibility="gone"
            android:fontFamily="@font/urbanist_medium"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
