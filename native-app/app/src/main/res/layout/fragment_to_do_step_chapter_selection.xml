<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/rl_parent_layout"
    tools:context=".fragments.todo.create_todo.ToDoStepSubjectSelectionFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_alignParentTop="true"
        >
        <TextView
            android:id="@+id/tv_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/urbanist_medium"
            android:maxLines="1"
            android:text="@string/step_1_to_create_time_table"
            android:textColor="#191919"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_sub_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="15dp"
            android:ellipsize="end"
            android:fontFamily="@font/urbanist_semi_bold"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/aap_hamse_jo_subject_padna_chahte_he_unhe_tick_kare"
            android:textColor="#191919"
            android:textSize="21sp"
            android:textStyle="normal"/>

        <TextView
            android:id="@+id/tv_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:ellipsize="end"
            android:fontFamily="@font/urbanist_light_italic"
            android:gravity="center"
            android:maxLines="1"
            android:layout_gravity="center_horizontal"
            android:text="@string/jo_subject_nahi_chaiye_unka_tick_hataye"
            android:textColor="#696969"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_chapter_selection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="28dp"
                app:cardCornerRadius="10dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="3dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_chapter_selection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:itemCount="8"
                    tools:listitem="@layout/to_do_list_chapter_selection_item"
                    android:scrollbars="vertical"
                    android:fadeScrollbars="false"
                    android:layout_marginVertical="2dp"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_scroll_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/black"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:alpha="0.8"
                >
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center"
                    android:paddingVertical="6dp"
                    android:paddingHorizontal="16dp"
                    >
                    <TextView
                        android:id="@+id/tv_scroll_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/urbanist_semi_bold"
                        android:gravity="center"
                        android:maxLines="1"
                        android:layout_gravity="center_vertical"
                        android:text="@string/neeche_jayein"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        />

                    <ImageView
                        android:id="@+id/iv_scroll_toggle"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/baseline_arrow_downward_24"
                        app:tint="@color/white"
                        android:scaleType="centerCrop"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="0dp"
                        />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </FrameLayout>

    </LinearLayout>

    <arivihan.technologies.doubtbuzzter2.customView.video_player.MiniVideoPlayer
        android:id="@+id/mini_video_player"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="visible"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        />

</RelativeLayout>
