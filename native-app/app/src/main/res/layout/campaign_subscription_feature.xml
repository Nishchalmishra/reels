<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Theme.MaterialComponents.DayNight.DarkActionBar"
    android:layout_marginTop="2dp">

    <LinearLayout
        android:id="@+id/dash_view"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <LinearLayout
            android:id="@+id/top_dash"
            android:layout_width="3dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/yellow_verticle_dashed_line"
            android:orientation="horizontal"/>

        <ImageView
            android:id="@+id/dot_view"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:backgroundTint="@color/subscription_blue"
            app:cardCornerRadius="60dp"
            app:cardElevation="0dp"
            android:visibility="visible"
            android:layout_marginHorizontal="3dp"
            android:src="@drawable/ic_done_blue"
            android:scaleType="fitXY"/>

        <LinearLayout
            android:id="@+id/bottom_dash"
            android:layout_width="3dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/yellow_verticle_dashed_line"
            android:orientation="horizontal"/>

    </LinearLayout>

    <TextView
        android:id="@+id/feature_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/dash_view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:text="Live doubt solving"
        android:textSize="11sp"
        android:fontFamily="@font/urbanist_semi_bold"
        android:textColor="@color/black"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="2.4dp"
        android:breakStrategy="simple"/>

</androidx.constraintlayout.widget.ConstraintLayout>