<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="280dp"
    android:layout_height="360dp"
    app:cardCornerRadius="15dp"
    app:cardUseCompatPadding="false"
    android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="5dp">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/subjective_analysis_anim"
                android:layout_width="200dp"
                android:layout_height="120dp"
                app:lottie_rawRes="@raw/subjective_analysis"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/analysing"
                android:textSize="28sp"
                android:textColor="#484747"
                android:fontFamily="@font/nunito_bold"
                android:layout_marginVertical="5dp"/>

            <TextView
                android:id="@+id/popup_submit_text_one"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/your_submitted_answer"
                android:textSize="20sp"
                android:textColor="#484747"
                android:fontFamily="@font/nunito_regular"
                android:layout_marginVertical="5dp"/>

            <TextView
                android:id="@+id/popup_submit_text_two"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/just_relax"
                android:textSize="20sp"
                android:textColor="#484747"
                android:fontFamily="@font/nunito_regular" />

            <androidx.cardview.widget.CardView
                android:id="@+id/close_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="25dp"
                android:backgroundTint="#22B1C1"
                android:layout_marginTop="22dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/close"
                    android:textColor="@color/white"
                    android:textSize="23sp"
                    android:layout_marginHorizontal="55dp"
                    android:layout_marginVertical="8dp"
                    android:fontFamily="@font/nunito_regular"/>

            </androidx.cardview.widget.CardView>
        </LinearLayout>

</androidx.cardview.widget.CardView>