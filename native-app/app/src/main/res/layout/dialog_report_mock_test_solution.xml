<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:background="@color/fui_transparent"
    android:maxHeight="320dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/relativeLayoutDoubt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="15dp"
        android:gravity="center"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:contentPadding="20dp">


        <LinearLayout
            android:id="@+id/linearLayoutDoubt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/nunito_bold"
                    android:text="@string/Report_Question"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/close_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_close_black" />

            </RelativeLayout>


            <TextView
                android:id="@+id/report_text_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/nunito_regular"
                android:paddingVertical="14dp"
                android:text="@string/Incorrect_or_incomplete_question"
                android:textColor="@color/black"
                android:textSize="@dimen/tertiary_text_size" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/grey_300" />


            <TextView
                android:id="@+id/report_text_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_regular"
                android:paddingVertical="14dp"
                android:text="@string/Incorrect_or_incomplete_option"
                android:textColor="@color/black"
                android:textSize="@dimen/tertiary_text_size" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/grey_300" />

            <TextView
                android:id="@+id/report_text_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_regular"
                android:paddingVertical="14dp"
                android:text="@string/Formatting_or_image"
                android:textColor="@color/black"
                android:textSize="@dimen/tertiary_text_size" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/grey_300" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/nunito_regular"
                android:paddingVertical="10dp"
                android:text="@string/other"
                android:textColor="@color/black"
                android:textIsSelectable="true"
                android:textSize="@dimen/tertiary_text_size" />


            <EditText
                android:id="@+id/report_text_input"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/question_option_border"
                android:fontFamily="@font/nunito_regular"
                android:gravity="start"
                android:hint="@string/Your_Feedback"
                android:padding="12dp"
                android:textSize="@dimen/tertiary_text_size" />


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">


                <androidx.cardview.widget.CardView
                    android:id="@+id/report_question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    app:cardBackgroundColor="@color/arivihan_secondary_color"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_semibold"
                        android:paddingVertical="12dp"
                        android:text="@string/Report"
                        android:textAlignment="center"
                        android:textColor="@color/white" />
                </androidx.cardview.widget.CardView>

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:visibility="gone">

                <com.github.ybq.android.spinkit.SpinKitView
                    android:id="@+id/progress_dataLoading"
                    style="@style/SpinKitView.FadingCircle"
                    android:layout_width="match_parent"
                    android:layout_height="25dp"
                    android:layout_margin="25dp"
                    app:SpinKit_Color="#19B0C1" />

            </RelativeLayout>


        </LinearLayout>

    </androidx.cardview.widget.CardView>

</RelativeLayout>