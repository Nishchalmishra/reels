<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxHeight="500dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    android:layout_gravity="center"
    android:id="@+id/video_settings"
    app:contentPaddingTop="5dp"
    app:contentPaddingBottom="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minWidth="340dp"
        android:layout_marginHorizontal="15dp"
        android:orientation="vertical">

        <!--            //title-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/video_settings_layout_title"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/urbanist_bold"
                android:text="@string/settings"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:gravity="center_vertical"/>

            <ImageView
                android:id="@+id/iv_close"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_weight="0"
                android:src="@drawable/close"
                app:tint="@color/black" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/option_layout"
            android:layout_width="match_parent"
            android:layout_marginTop="4dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/playback_speed"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="19dp"
                    android:padding="1dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_playback_speed" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/urbanist_medium"
                    android:text="@string/Playback_speed"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:gravity="center_vertical"/>

                <TextView
                    android:id="@+id/current_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:fontFamily="@font/urbanist_regular"
                    android:text="@string/Normal"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:gravity="center_vertical"/>

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/right_arrow_black" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/video_quality"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_video_quality" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/urbanist_medium"
                    android:text="@string/video_quality"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:gravity="center_vertical"/>

                <TextView
                    android:id="@+id/current_quality_1"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:fontFamily="@font/urbanist_regular"
                    android:text="540p"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:gravity="center_vertical"/>

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/right_arrow_black" />
            </LinearLayout>

        </LinearLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/settings_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="220dp"
            android:scrollbars="vertical"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="6dp"
            tools:itemCount="3"
            tools:listitem="@layout/video_quality_recycler_item"
            android:visibility="gone"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>