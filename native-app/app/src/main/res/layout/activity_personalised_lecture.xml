<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".activity.PersonalisedLecture">

    <include android:id="@+id/toolbar"
        layout="@layout/activity_custom_toolbar_layout" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?android:actionBarSize">

        <LinearLayout
            android:id="@+id/nodata"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">


            <com.airbnb.lottie.LottieAnimationView
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginHorizontal="32dp"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:lottie_rawRes="@raw/lottie_empty_personalised_lecture"
                app:lottie_loop="true"
                app:lottie_autoPlay="true"/>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:fontFamily="@font/poppins_light"
                android:textSize="@dimen/primary_text_size"
                android:text="@string/No_personalized_lectures_available"
                android:textAlignment="center" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lectures_by_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/personalised_shimmer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include layout="@layout/shimmer_topic_layout" />

                <include layout="@layout/shimmer_topic_layout" />

                <include layout="@layout/shimmer_topic_layout" />

                <include layout="@layout/shimmer_topic_layout" />

                <include layout="@layout/shimmer_topic_layout" />

                <include layout="@layout/shimmer_topic_layout" />
            </LinearLayout>

        </com.facebook.shimmer.ShimmerFrameLayout>
    </RelativeLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/personalised_date_selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:text="@string/Show_More"
        android:textColor="@color/white"
        android:visibility="gone"
        app:backgroundTint="@color/arivihan_secondary_color"
        app:icon="@drawable/ic_baseline_date_range_white_24"
        app:iconTint="@color/white"
        app:theme="@style/MyMaterial" />
</RelativeLayout>