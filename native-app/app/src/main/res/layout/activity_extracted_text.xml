<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/extracted_text_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="10dp">


    <androidx.cardview.widget.CardView
        android:id="@+id/extracted_text_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        app:cardCornerRadius="15dp"
        app:cardElevation="10dp"
        app:layout_constraintBottom_toTopOf="@+id/submission_check"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/extracted_text_linear_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="6dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/expand_view_card"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="9dp"
                    android:backgroundTint="#80D9D9D9"
                    android:visibility="visible"
                    app:cardCornerRadius="60dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/expand_view"
                        android:layout_width="20dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/expand_all__2_" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/collapse_view_card"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:backgroundTint="#80D9D9D9"
                    android:visibility="gone"
                    app:cardCornerRadius="60dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/collapse_view"
                        android:layout_width="38dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/collapse_all__1_" />

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/user_submitted_response"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/your_response"
                    android:textSize="18dp"
                    android:fontFamily="@font/nunito_regular"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="6dp"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/back_image_card"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="#80D9D9D9"
                    app:cardCornerRadius="60dp"
                    app:cardElevation="0dp">



                    <ImageView
                        android:id="@+id/back_image"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/arrow_back_ios" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/solution_heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="12dp"
                    android:text="@string/Solution"
                    android:textColor="@color/arivihan_primary_color"
                    android:textSize="20dp"
                    android:visibility="gone" />

            </RelativeLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <EditText
                    android:overScrollMode="always"
                    android:scrollbarStyle="insideInset"
                    android:scrollbars="vertical"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:id="@+id/extracted_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="0dp"
                    android:background="@null"
                    android:fontFamily="@font/nunito_regular"
                    android:gravity="top"
                    android:lineHeight="24dp"
                    android:paddingStart="22dp"
                    android:text=""
                    android:textSize="17sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/number_of_words_layout"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="5dp">

                <TextView
                    android:id="@+id/number_of_words"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_bold"
                    android:textAlignment="center"
                    android:textColor="@color/marks_color"
                    android:textSize="17sp"
                    android:textStyle="italic" />

                <TextView
                    android:id="@+id/word_limit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_bold"
                    android:textAlignment="center"
                    android:textColor="@color/marks_color"
                    android:textSize="17sp"
                    android:textStyle="italic" />

            </LinearLayout>



        </LinearLayout>
    </androidx.cardview.widget.CardView>


    <LinearLayout
        android:id="@+id/submission_check"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="5dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/extracted_text_card">

        <TextView
            android:id="@+id/check_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_regular"
            android:text="@string/check_your_answer_before_submitting"
            android:textColor="#80000000"
            android:paddingLeft="22dp"
            android:textSize="17sp"
            android:textStyle="italic"
            android:visibility="gone" />

        <TextView
            android:layout_marginTop="15dp"
            android:id="@+id/response_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Response"
            android:paddingLeft="22dp"
            android:textColor="@color/black"
            android:textSize="@dimen/primary_text_size"
            android:visibility="gone"
            android:textStyle="bold"/>

        <TextView
            android:layout_marginTop="15dp"
            android:id="@+id/marks_obtained"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_semibold"
            android:text="Your Marks: 4/5"
            android:paddingLeft="22dp"
            android:textColor="@color/marks_color"
            android:textSize="@dimen/primary_text_size"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/see_submission_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_semibold"
                android:text="@string/see_solution"
                android:textColor="@color/marks_color"
                android:paddingLeft="22dp"
                android:textSize="@dimen/primary_text_size" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginLeft="6dp"
                android:src="@drawable/ic_info_24" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/copy_submitted_solution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_semibold"
                android:text="@string/copy_solution"
                android:paddingLeft="22dp"
                android:textColor="@color/marks_color"
                android:textSize="@dimen/primary_text_size" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginLeft="6dp"
                android:src="@drawable/ic_baseline_content_copy_24" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>