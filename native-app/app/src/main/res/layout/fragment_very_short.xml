<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"
    tools:context=".fragments.ValueTypeFragment">

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_layout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_weight="1">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="90dp">

            <include
                android:id="@+id/question"
                layout="@layout/question_layout" />

            <LinearLayout
                android:id="@+id/type_answer_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/question"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="30dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/type_answer_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/urbanist_regular"
                    android:textStyle="italic"
                    android:text="@string/Option_1_Apna_answer_yha_type_karein"
                    android:textColor="#CC000000"
                    android:textSize="12sp"
                    android:visibility="visible" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/type_answer_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="15dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/mock_light_grey"
                    app:strokeWidth="1dp">

                    <EditText
                        android:id="@+id/type_answer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/question_option_border"
                        android:fontFamily="@font/nunito_regular"
                        android:hint="@string/type_your_text"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="14dp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/mock_grey"
                        android:textSize="@dimen/primary_text_size" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/typed_answer_word_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:fontFamily="@font/urbanist_semi_bold"
                    android:paddingEnd="10dp"
                    android:text="92/100"
                    android:textColor="@color/subscription_blue"
                    android:textStyle="italic"
                    android:visibility="gone" />
            </LinearLayout>

            <include
                layout="@layout/activity_board_subjective_upload_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/type_answer_layout"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:visibility="visible" />

            <LinearLayout
                android:id="@+id/answer_image_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/question"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:fontFamily="@font/urbanist_regular"
                android:text="@string/Your_Uploaded_Answer_Image"
                android:textSize="13sp"
                android:textStyle="italic" />

            <include
                layout="@layout/board_extraction_image_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible" />

            </LinearLayout>

            <include
                android:id="@+id/solution_view"
                layout="@layout/solution_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/question"
                android:visibility="gone"/>

            <include
                android:id="@+id/text_layout"
                layout="@layout/subjective_text_answer_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_below="@id/question"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/submitted_answer_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="15dp"
                    app:strokeColor="#33000000"
                    app:cardBackgroundColor="#F6F6F6"
                    app:strokeWidth="1dp"
                    android:layout_below="@id/solution_view"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="10dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/description_card"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="10dp"
                            app:cardBackgroundColor="#D3F8FA"
                            app:cardElevation="0dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/your_submitted_answer"
                                android:textSize="14sp"
                                android:fontFamily="@font/urbanist_semi_bold"
                                android:textColor="#02858D"
                                android:layout_marginVertical="1dp"
                                android:layout_marginHorizontal="15dp"/>
                        </androidx.cardview.widget.CardView>


                    <TextView
                        android:id="@+id/submitted_answer_text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/question_option_border"
                        android:fontFamily="@font/nunito_regular"
                        android:textColor="@color/black"
                        android:textColorHint="@color/mock_grey"
                        android:textSize="@dimen/primary_text_size"
                        android:layout_marginTop="10dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

        </RelativeLayout>
    </ScrollView>

    <androidx.cardview.widget.CardView
        android:id="@+id/view_solution_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:alpha="0.7"
        android:visibility="gone"
        app:cardBackgroundColor="#000000"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:paddingVertical="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/urbanist_semi_bold"
                android:text="@string/View_Your_Answer"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_gravity="center"
                android:layout_marginStart="5dp"
                android:src="@drawable/arrow_down_white" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ask_doubt_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottom_layout"
        app:layout_constraintEnd_toEndOf="parent">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/animation"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/ring_waves" />

        <androidx.cardview.widget.CardView
            android:id="@+id/ask_doubt_card"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:backgroundTint="#26C6DA"
            app:cardCornerRadius="30dp"
            app:layout_constraintBottom_toBottomOf="@id/animation"
            app:layout_constraintEnd_toEndOf="@id/animation"
            app:layout_constraintStart_toStartOf="@id/animation"
            app:layout_constraintTop_toTopOf="@id/animation">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/rubik_semi_bold"
                android:gravity="center"
                android:text="@string/ask_more"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="20dp"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:id="@+id/clear_attempt_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/mock_light_blue"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_semibold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:text="@string/clear"
                android:textColor="@color/subscription_blue"
                android:textSize="14sp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/submit_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#26C6DA"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:visibility="visible">

            <TextView
                android:id="@+id/submit_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_semibold"
                android:paddingHorizontal="50dp"
                android:paddingVertical="10dp"
                android:text="@string/submit"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>