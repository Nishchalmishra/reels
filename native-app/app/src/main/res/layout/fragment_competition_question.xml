<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/ParentRelativeLayout"
    android:layout_marginTop="45dp"
    android:background="#552F85"
    tools:context=".MCQAndSubjectiveQuestionFragment">


    <androidx.core.widget.NestedScrollView
        android:background="#552F85"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:scrollbars="none"
        tools:ignore="UselessParent">

        <LinearLayout
            android:background="#552F85"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/mark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:orientation="horizontal">


            </LinearLayout>


            <androidx.cardview.widget.CardView
                android:background="#552F85"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="20dp"
                android:foregroundGravity="center_horizontal"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingBottom="15dp"
                app:cardCornerRadius="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">



                <LinearLayout
                    android:background="#552F85"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:theme="@style/Theme.MaterialComponents.DayNight.DarkActionBar">


                    <RelativeLayout
                        android:id="@+id/relative_layout_ques"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                       >

                        <RelativeLayout
                            android:layout_marginTop="10dp"
                            android:id="@+id/markLinearLayout"
                            android:layout_width="match_parent"
                            android:orientation="horizontal"
                            android:layout_marginLeft="15dp"
                            android:layout_height="wrap_content">

                            <TextView
                                android:textColor="@color/white"
                                android:text="Italic"
                                style="@style/tertiaryText"
                                android:id="@+id/questionType"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:layout_marginRight="15dp"
                                android:paddingRight="10dp"
                                android:textAlignment="textEnd"
                                android:textSize="@dimen/tertiary_text_size"
                                android:textStyle="italic" />

                            <TextView
                                android:id="@+id/questionNo"
                                android:layout_alignParentRight="true"
                                android:textColor="@color/white"
                                android:text="Italic"
                                style="@style/tertiaryText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:layout_marginRight="15dp"
                                android:paddingRight="10dp"
                                android:textAlignment="textEnd"
                                android:textSize="@dimen/tertiary_text_size"
                                android:textStyle="italic" />

                        </RelativeLayout>


                        <ImageView
                            android:id="@+id/question_image"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginLeft="5dp"
                            android:layout_below="@+id/markLinearLayout"
                            android:layout_marginTop="15dp"
                            android:layout_marginRight="8dp"
                            android:layout_marginBottom="10dp"
                            android:adjustViewBounds="true"
                            android:src="@drawable/free_sample_by_wix"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/question"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/question_image"
                            android:layout_marginLeft="15dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginRight="15dp"
                            android:layout_marginBottom="20dp"
                            android:fontFamily="@font/opensans_regular"
                            android:text=""
                            android:textColor="@color/white"
                            android:textSize="18sp" />

                    </RelativeLayout>


                    <RelativeLayout
                        android:background="#552F85"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/subText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="15dp"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/opensans_light"
                            android:paddingLeft="10dp"
                            android:paddingTop="2dp"
                            android:paddingRight="10dp"
                            android:paddingBottom="2dp"
                            android:text="You can Maximum Attempt 5 Question"
                            android:textColor="@color/white"
                            android:textSize="@dimen/tertiary_text_size"
                            android:textStyle="bold|italic" />

                    </RelativeLayout>


                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/integerAnswerrr"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/text_login"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="18dp"
                        android:layout_marginRight="10dp"
                        android:hint="@string/AnswerUptoTwo"
                        android:textColor="#9E9E9E"
                        android:visibility="gone"
                        android:textColorHint="#9E9E9E"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="@color/navy_blue">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/integerAnswer"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:drawablePadding="6dp"
                            android:fontFamily="@font/poppins_light"
                            android:inputType="textEmailAddress"
                            android:textColor="@color/black" />
                    </com.google.android.material.textfield.TextInputLayout>


                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/NumericalAnswerrr"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/text_login"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="18dp"
                        android:layout_marginRight="10dp"
                        android:hint="@string/AnswerUptoTwo"
                        android:textColor="#9E9E9E"
                        android:textColorHint="#9E9E9E"
                        app:hintTextColor="@color/navy_blue"
                        app:counterOverflowTextColor="@color/navy_blue"
                        android:visibility="gone"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="@color/navy_blue">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/NumericalAnswer"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:drawablePadding="6dp"
                            android:fontFamily="@font/poppins_light"
                            android:inputType="numberDecimal"
                            android:textColor="@color/black" />
                    </com.google.android.material.textfield.TextInputLayout>



                    <TextView
                        android:id="@+id/YourResponse"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Your Response : "
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:layout_marginRight="20dp"
                        android:layout_marginLeft="20dp"
                        android:textSize="@dimen/primary_text_size"
                        android:fontFamily="@font/poppins_light"/>

                    <TextView
                        android:id="@+id/CorrectAnswer"
                        android:layout_width="match_parent"
                        android:visibility="gone"
                        android:layout_height="wrap_content"
                        android:text="Correct Answer : "
                        android:layout_marginBottom="15dp"
                        android:textColor="@color/navy_blue"
                        android:layout_marginRight="20dp"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="18dp"
                        android:textSize="@dimen/tertiary_text_size"
                        android:fontFamily="@font/poppins_light"/>




                    <androidx.recyclerview.widget.RecyclerView
                        android:background="#552F85"
                        android:id="@+id/recyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="15dp"
                        tools:listitem="@layout/recycler_view_option_item" />

                    <RelativeLayout
                        android:background="#552F85"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/yourAttempt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:textColor="@color/green"
                            android:textSize="@dimen/tertiary_text_size"
                            android:layout_marginBottom="5dp"
                            android:text="Your Attempt : a,b,c"
                            android:textStyle="bold"
                            android:layout_marginRight="30dp"
                            android:layout_marginLeft="30dp"
                            />

                        <TextView
                            android:id="@+id/explanation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/navy_blue"
                            android:textStyle="bold"
                            android:visibility="gone"
                            android:textSize="@dimen/secondary_text_size"
                            android:layout_below="@id/yourAttempt"
                            android:layout_marginLeft="30dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="15dp"
                            android:text="See explanation "
                            android:drawableRight="@drawable/ic_explanation"
                            android:drawablePadding="5dp"
                            />

                    </RelativeLayout>





                    <RelativeLayout
                        android:id="@+id/saveAnswer"
                        android:background="@drawable/ic_game_card"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">


                        <TextView
                            android:id="@+id/btn_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/save_and_continue"
                            android:textColor="@color/white"
                            android:textSize="20dp" />

                    </RelativeLayout>



                    <androidx.cardview.widget.CardView
                        android:id="@+id/button_clear_answer"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginLeft="20dp"
                        android:visibility="gone"
                        android:layout_marginTop="15dp"
                        android:layout_marginRight="20dp"
                        android:layout_marginBottom="25dp"
                        app:cardBackgroundColor="@color/grey_500"
                        app:cardCornerRadius="7dp"
                        app:cardElevation="0dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">


                            <TextView
                                android:id="@+id/btn_text_clear"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:text="@string/clear"
                                android:textColor="@color/black"
                                android:textSize="20dp" />

                        </RelativeLayout>


                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


</RelativeLayout>