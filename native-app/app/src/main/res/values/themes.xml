<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PdfView.SelectedTheme" parent="Theme.AppCompat.Light.NoActionBar" />

    <style name="ArivihanTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Calendar" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Lets Material sheets and dialogs inset their own content, now that the app draws edge to edge. -->
        <item name="enableEdgeToEdge">true</item>

        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/arivihan_secondary_color</item>
        <item name="colorPrimaryVariant">@color/arivihan_primary_color</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/arivihan_secondary_color</item>
        <!-- Add these -->
        <item name="materialCalendarStyle">@style/Widget.MaterialComponents.MaterialCalendar</item>
        <item name="materialCalendarFullscreenTheme">
            @style/ThemeOverlay.MaterialComponents.MaterialCalendar.Fullscreen
        </item>
        <item name="materialCalendarTheme">@style/ThemeOverlay.MaterialComponents.MaterialCalendar
        </item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>



    <!--    //new theme - support dark-->
    <style name="Theme.Arivihan2" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Lets Material sheets and dialogs inset their own content, now that the app draws edge to edge. -->
        <item name="enableEdgeToEdge">true</item>


        <!-- Primary Colors -->
        <item name="colorPrimary">@color/arivihan_primary_color</item>
        <item name="colorPrimaryVariant">@color/arivihan_secondary_color</item>
        <item name="colorSecondary">@color/colorAccent</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/bg_color</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <item name="colorAccent">@color/arivihan_primary_color</item>

        <!-- Controls -->
        <item name="colorControlNormal">@color/control_normal</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/status_bar_color</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@color/navigation_bar_color</item>
        <item name="android:windowLightNavigationBar">true</item>

    </style>


    <style name="statusBarStyle" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Lets Material sheets and dialogs inset their own content, now that the app draws edge to edge. -->
        <item name="enableEdgeToEdge">true</item>

        <item name="android:statusBarColor" >@color/white</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:windowLightStatusBar" tools:targetApi="n">true</item>
    </style>

    <style name="ArivihanTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="ArivihanTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />


    <style name="DialogAnimation" >
        <item name="android:windowEnterAnimation">@anim/slide_in_from_left</item>
        <item name="android:windowExitAnimation">@anim/fui_slide_out_left</item>
    </style>

    <style name="DialogAnimationUpDown" >
        <item name="android:windowEnterAnimation">@anim/bottom_to_up</item>
        <item name="android:windowExitAnimation">@anim/tobottom</item>
    </style>

    <style name="CustomDatePicker" parent="@android:style/Widget.Material.Light.DatePicker">
        <item name="colorAccent">@color/subscription_blue</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:datePickerStyle">@style/CustomDatePickerStyle</item>
    </style>

    <style name="CustomDatePickerStyle" parent="MyDatePickerStyle">
        <item name="android:headerBackground">@color/white</item>
<!--        <item name="android:headerTextColor">@color/black</item>-->
        <item name="android:calendarTextColor">@color/black</item>
        <item name="android:colorAccent">@color/subscription_blue</item>
    </style>


</resources>