<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer glow layer (largest) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#40D9F7FB" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <!-- Middle glow layer -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#60D9F7FB" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <!-- Inner bright glow -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#80D9F7FB" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <!-- White card background -->
    <item
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="28dp" />
            <stroke
                android:width="1dp"
                android:color="#D9F7FB" />
        </shape>
    </item>

</layer-list>