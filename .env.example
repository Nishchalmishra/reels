# Explicit selection: local or supabase. Missing values default to local.
VITE_SERVICE_MODE=local
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_BROWSER_SAFE_KEY
# Existing NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# are accepted as browser-safe aliases by vite.config.ts.
VITE_DEMO_TOOLS=false
VITE_INTEGRATION_TEST=false
# The following are OPTIONAL server/tooling-only values. Never prefix with VITE_.
# Official MCP deployment uses Codex-managed OAuth; no privileged .env key is required.
# See SUPABASE_MCP_SETUP.md. Do not paste MCP OAuth tokens into this file.
# SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT:ENCODED_PASSWORD@YOUR_POOLER:5432/postgres
# SUPABASE_ACCESS_TOKEN=YOUR_MANAGEMENT_TOKEN
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_ADMIN_KEY_FOR_TEST_USER_CLEANUP
